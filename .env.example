# Salin file ini menjadi .env lalu isi nilainya.
# cp .env.example .env

# Port proses Node. Nginx aaPanel meneruskan domain ke port ini.
PORT=3000

# Teks acak panjang. Jangan pakai nilai ini di server sungguhan.
SESSION_SECRET=ganti-dengan-teks-acak-panjang

# MySQL di VPS yang sama. Pakai 127.0.0.1, bukan host database lama.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=simpell
DB_USER=user_mysql
DB_PASSWORD=password_mysql

# Alamat yang dibuka pengguna, termasuk https://
APP_URL=https://domain-anda.com

# Akun admin pertama. Dibuat hanya jika database belum punya role admin.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@simpell.local
ADMIN_PASSWORD=Admin123_

# SMTP untuk email persetujuan akun dan reset password.
# Kosongkan kalau email belum dipakai. Login tetap jalan.
# Port 587 biasanya SMTP_SECURE=false. Port 465 biasanya SMTP_SECURE=true.
# Contoh host domain sendiri: smtp.domain-anda.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
