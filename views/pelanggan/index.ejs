<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Data Customer</h1>
            <p class="text-sm text-gray-500 dark:text-gray-400">Kelola data customer dan lihat layanan mereka</p>
        </div>
        <div class="flex items-center gap-3">
            <% if (isEditor) { %>
                <a href="/pelanggan/create"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors shadow-sm">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                    Tambah Customer
                </a>
                <% } %>
                    <a href="/pelanggan/export"
                        class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-lg transition-colors shadow-sm">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                        Download Excel
                    </a>
        </div>
    </div>

        <!-- Statistics Cards -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mt-6">
            <!-- Total Customer -->
            <div
                class="bg-blue-50 dark:bg-blue-900/10 border border-blue-100 dark:border-blue-900/20 rounded-xl p-3 flex items-center gap-3">
                <div class="p-2 bg-blue-100 dark:bg-blue-900/30 rounded-lg text-blue-600 dark:text-blue-400">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                </div>
                <div>
                    <p class="text-[10px] font-bold text-blue-600 dark:text-blue-400 uppercase tracking-wider">Total
                        Customer</p>
                    <p class="text-xl font-bold text-gray-900 dark:text-white leading-none">
                        <%= totalCustomers %>
                    </p>
                </div>
            </div>

            <!-- Active -->
            <div
                class="bg-green-50 dark:bg-green-900/10 border border-green-100 dark:border-green-900/20 rounded-xl p-3 flex items-center gap-3">
                <div class="p-2 bg-green-100 dark:bg-green-900/30 rounded-lg text-green-600 dark:text-green-400">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div>
                    <p class="text-[10px] font-bold text-green-600 dark:text-green-400 uppercase tracking-wider">Active
                    </p>
                    <p class="text-xl font-bold text-gray-900 dark:text-white leading-none">
                        <%= activeCustomers %>
                    </p>
                </div>
            </div>

            <!-- Inactive -->
            <div
                class="bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-3 flex items-center gap-3">
                <div class="p-2 bg-gray-100 dark:bg-gray-700 rounded-lg text-gray-500 dark:text-gray-400">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div>
                    <p class="text-[10px] font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Inactive
                    </p>
                    <p class="text-xl font-bold text-gray-900 dark:text-white leading-none">
                        <%= inactiveCustomers %>
                    </p>
                </div>
            </div>

            <!-- Suspended -->
            <div
                class="bg-red-50 dark:bg-red-900/10 border border-red-100 dark:border-red-900/20 rounded-xl p-3 flex items-center gap-3">
                <div class="p-2 bg-red-100 dark:bg-red-900/30 rounded-lg text-red-600 dark:text-red-400">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
                <div>
                    <p class="text-[10px] font-bold text-red-600 dark:text-red-400 uppercase tracking-wider">Suspended
                    </p>
                    <p class="text-xl font-bold text-gray-900 dark:text-white leading-none">
                        <%= suspendedCustomers %>
                    </p>
                </div>
            </div>
        </div>

        <!-- Search and Filter -->
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm">
            <form id="searchForm" action="/pelanggan" method="GET" class="flex flex-col sm:flex-row gap-3">
                <div class="flex-1">
                    <input type="text" id="searchInput" name="search" value="<%= search %>"
                        placeholder="Cari customer atau no jaringan..."
                        class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                </div>
                <div>
                    <select name="status" id="statusFilter"
                        class="w-full sm:w-auto px-4 py-2.5 bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-lg text-sm focus:ring-2 focus:ring-blue-500">
                        <option value="">Semua Status</option>
                        <option value="Active" <%=status==='Active' ? 'selected' : '' %>>Active</option>
                        <option value="Inactive" <%=status==='Inactive' ? 'selected' : '' %>>Inactive</option>
                        <option value="Suspended" <%=status==='Suspended' ? 'selected' : '' %>>Suspended</option>
                    </select>
                </div>
                <% if (search || status) { %>
                    <a href="/pelanggan"
                        class="px-4 py-2.5 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-200 text-sm font-medium rounded-lg transition-colors text-center">
                        Reset
                    </a>
                    <% } %>
            </form>
        </div>

        <script>
            const searchInput = document.getElementById('searchInput');
            const searchForm = document.getElementById('searchForm');
            const statusFilter = document.getElementById('statusFilter');
            let timeout = null;

            searchInput.addEventListener('input', function (e) {
                clearTimeout(timeout);
                timeout = setTimeout(function () {
                    if (searchInput.value.length >= 1 || searchInput.value.length === 0) {
                        searchForm.submit();
                    }
                }, 500); // 500ms delay
            });

            statusFilter.addEventListener('change', function () {
                searchForm.submit();
            });

            // Focus input on load if searching
            if (searchInput.value) {
                searchInput.focus();
                const val = searchInput.value;
                searchInput.value = '';
                searchInput.value = val;
            }
        </script>
</div>

<!-- Table -->
<div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl shadow-sm overflow-hidden">
    <div class="overflow-auto max-h-[80vh] relative">
        <table class="w-full">
            <thead
                class="sticky top-0 z-50 bg-gray-50 dark:bg-gray-900 border-b border-gray-200 dark:border-gray-700 shadow-sm">
                <tr>
                    <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600 dark:text-gray-400">No
                        Jaringan</th>
                    <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600 dark:text-gray-400">Customer</th>
                    <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600 dark:text-gray-400">Service</th>
                    <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600 dark:text-gray-400">Akses</th>
                    <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600 dark:text-gray-400">Node</th>
                    <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600 dark:text-gray-400">Kota</th>
                    <th class="px-6 py-3 text-left text-sm font-semibold text-gray-600 dark:text-gray-400">Status
                    </th>
                    <th
                        class="px-3 py-3 text-center text-sm font-semibold text-gray-600 dark:text-gray-400 sticky right-0 top-0 bg-gray-50 dark:bg-gray-900 z-30 shadow-[-4px_0_8px_-4px_rgba(0,0,0,0.1)] w-1">
                        Aksi
                    </th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                <% if (pelangganList && pelangganList.length> 0) { %>
                    <% pelangganList.forEach(function(item) { %>
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                            <td class="px-6 py-4 text-sm text-gray-900 dark:text-white font-medium">
                                <%= item.no_jaringan %>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300">
                                <%= item.nama_pelanggan %>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300"><%= item.service || '-' %></td>
                            <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300"><%= item.akses || '-' %></td>
                            <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300"><%= item.node || '-' %></td>
                            <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300"><%= item.kota || '-' %></td>
                            <td class="px-6 py-4">
                                <% if (item.status==='Active' ) { %>
                                    <span
                                        class="inline-flex px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400">Active</span>
                                    <% } else if (item.status==='Inactive' ) { %>
                                        <span
                                            class="inline-flex px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300">Inactive</span>
                                        <% } else { %>
                                            <span
                                                class="inline-flex px-2.5 py-1 rounded-full text-xs font-medium bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400">Suspended</span>
                                            <% } %>
                            </td>
                            <td
                                class="px-3 py-4 text-center sticky right-0 bg-white dark:bg-gray-800 z-20 shadow-[-4px_0_8px_-4px_rgba(0,0,0,0.1)] w-1">
                                <div class="flex items-center justify-center gap-2">
                                    <a href="/pelanggan/<%= item.id %>" title="Detail"
                                        class="p-2 text-blue-600 hover:bg-blue-50 dark:hover:bg-blue-900/20 rounded-lg transition-colors">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z">
                                            </path>
                                        </svg>
                                    </a>
                                    <% if (isEditor) { %>
                                        <a href="/pelanggan/<%= item.id %>/edit" title="Edit"
                                            class="p-2 text-amber-600 hover:bg-amber-50 dark:hover:bg-amber-900/20 rounded-lg transition-colors">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z">
                                                </path>
                                            </svg>
                                        </a>
                                        <% } %>
                                </div>
                            </td>
                        </tr>
                        <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="px-6 py-12 text-center text-gray-500 dark:text-gray-400">
                                        <svg class="w-12 h-12 mx-auto mb-4 text-gray-300 dark:text-gray-600" fill="none"
                                            stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z">
                                            </path>
                                        </svg>
                                        <p class="text-sm">Belum ada data customer</p>
                                        <% if (isEditor) { %>
                                            <a href="/pelanggan/create"
                                                class="mt-2 inline-block text-blue-600 hover:text-blue-700 text-sm font-medium">Tambah
                                                customer baru</a>
                                            <% } %>
                                    </td>
                                </tr>
                                <% } %>
            </tbody>
        </table>
        <%- include('../partials/pagination') %>
    </div>
</div>
</div>