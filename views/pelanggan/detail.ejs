<div class="space-y-6">
    <!-- Header with Back Button -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-4">
            <a href="/pelanggan" class="p-2 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition-colors">
                <svg class="w-5 h-5 text-gray-600 dark:text-gray-400" fill="none" stroke="currentColor"
                    viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                </svg>
            </a>
            <div>
                <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
                    <%= pelanggan.nama_pelanggan %>
                </h1>
                <p class="text-sm text-gray-500 dark:text-gray-400">No. Jaringan: <%= pelanggan.no_jaringan %>
                </p>
            </div>
        </div>
        <div class="flex gap-2">
            <a href="/pelanggan/<%= pelanggan.id %>/export"
                class="inline-flex items-center gap-2 px-4 py-2.5 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-lg transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z">
                    </path>
                </svg>
                Download Excel
            </a>
            <% if (isEditor) { %>
                <a href="/pelanggan/<%= pelanggan.id %>/edit"
                    class="inline-flex items-center gap-2 px-4 py-2.5 bg-amber-500 hover:bg-amber-600 text-white text-sm font-medium rounded-lg transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z">
                        </path>
                    </svg>
                    Edit
                </a>
                <% } %>
                    <% if (isEditor) { %>
                        <form action="/pelanggan/<%= pelanggan.id %>/delete" method="POST"
                            onsubmit="return confirmSubmit(this, 'Yakin hapus customer ini?');">
                            <button type="submit"
                                class="inline-flex items-center gap-2 px-4 py-2.5 bg-red-500 hover:bg-red-600 text-white text-sm font-medium rounded-lg transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                                    </path>
                                </svg>
                                Hapus
                            </button>
                        </form>
                        <% } %>
        </div>
    </div>

    <!-- Customer Info Card -->
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
            Informasi Customer
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <div class="p-4 bg-gray-50 dark:bg-gray-900/50 rounded-lg">
                <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">No Jaringan</p>
                <p class="font-medium text-gray-900 dark:text-white">
                    <%= pelanggan.no_jaringan %>
                </p>
            </div>
            <div class="p-4 bg-gray-50 dark:bg-gray-900/50 rounded-lg">
                <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Nama</p>
                <p class="font-medium text-gray-900 dark:text-white">
                    <%= pelanggan.nama_pelanggan %>
                </p>
            </div>
            <div class="p-4 bg-gray-50 dark:bg-gray-900/50 rounded-lg">
                <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Status</p>
                <% if (pelanggan.status==='Active' ) { %>
                    <span
                        class="inline-flex px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400">Active</span>
                    <% } else if (pelanggan.status==='Inactive' ) { %>
                        <span
                            class="inline-flex px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300">Inactive</span>
                        <% } else { %>
                            <span
                                class="inline-flex px-2.5 py-1 rounded-full text-xs font-medium bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400">Suspended</span>
                            <% } %>
            </div>
            <div class="p-4 bg-gray-50 dark:bg-gray-900/50 rounded-lg">
                <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Service</p>
                <p class="font-medium text-gray-900 dark:text-white"><%= pelanggan.service || '-' %></p>
            </div>
            <div class="p-4 bg-gray-50 dark:bg-gray-900/50 rounded-lg">
                <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Bandwidth</p>
                <p class="font-medium text-gray-900 dark:text-white"><%= pelanggan.bandwidth || '-' %></p>
            </div>
            <div class="p-4 bg-gray-50 dark:bg-gray-900/50 rounded-lg">
                <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Akses</p>
                <p class="font-medium text-gray-900 dark:text-white"><%= pelanggan.akses || '-' %></p>
            </div>
            <div class="p-4 bg-gray-50 dark:bg-gray-900/50 rounded-lg">
                <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Node</p>
                <p class="font-medium text-gray-900 dark:text-white"><%= pelanggan.node || '-' %></p>
            </div>
            <div class="p-4 bg-gray-50 dark:bg-gray-900/50 rounded-lg">
                <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Kota</p>
                <p class="font-medium text-gray-900 dark:text-white"><%= pelanggan.kota || '-' %></p>
            </div>
            <div class="p-4 bg-gray-50 dark:bg-gray-900/50 rounded-lg">
                <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Koordinat</p>
                <p class="font-medium text-gray-900 dark:text-white break-words">
                    <% const koordinatHref = mapsHref(pelanggan.koordinat); %>
                    <% if (koordinatHref) { %>
                        <a href="<%= koordinatHref %>" target="_blank" rel="noopener noreferrer" title="Buka di Google Maps"
                            class="text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 hover:underline"><%= pelanggan.koordinat %></a>
                    <% } else { %>
                        <%= pelanggan.koordinat || '-' %>
                    <% } %>
                </p>
            </div>
            <div class="p-4 bg-gray-50 dark:bg-gray-900/50 rounded-lg">
                <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Kontak</p>
                <p class="font-medium text-gray-900 dark:text-white">
                    <%= pelanggan.kontak || '-' %>
                </p>
            </div>
            <div class="p-4 bg-gray-50 dark:bg-gray-900/50 rounded-lg">
                <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Email</p>
                <p class="font-medium text-gray-900 dark:text-white">
                    <%= pelanggan.email || '-' %>
                </p>
            </div>
            <div class="p-4 bg-gray-50 dark:bg-gray-900/50 rounded-lg">
                <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Layanan Aktif</p>
                <p class="font-medium text-gray-900 dark:text-white">
                    <% let activeServices=[]; if (aksesFoList && aksesFoList.length> 0) activeServices.push('Akses FO');
                        if (vsatStarlinkList && vsatStarlinkList.length > 0) activeServices.push('VSAT Starlink');
                        if (m2mList && m2mList.length > 0) activeServices.push('M2M');
                        if (vsatTdmaList && vsatTdmaList.length > 0) activeServices.push('VSAT TDMA');
                        if (cpeList && cpeList.length > 0) activeServices.push('CPE');
                        if (radioLinkList && radioLinkList.length > 0) activeServices.push('Radio Link');
                        if (aksesThirdPartyList && aksesThirdPartyList.length > 0) activeServices.push('3rd Party');
                        %>
                        <%= activeServices.length> 0 ? activeServices.join(', ') : '-' %>
                </p>
            </div>
            <div class="p-4 bg-gray-50 dark:bg-gray-900/50 rounded-lg md:col-span-2 lg:col-span-3">
                <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Alamat</p>
                <p class="font-medium text-gray-900 dark:text-white">
                    <%= pelanggan.alamat || '-' %>
                </p>
            </div>
            <div class="p-4 bg-gray-50 dark:bg-gray-900/50 rounded-lg md:col-span-2 lg:col-span-3">
                <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">Keterangan</p>
                <p class="font-medium text-gray-900 dark:text-white">
                    <%- formatText(pelanggan.keterangan) %>
                </p>
            </div>
        </div>
    </div>

    <!-- Services Summary -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 text-center">
            <p class="text-2xl font-bold text-blue-600">
                <%= aksesFoList.length %>
            </p>
            <p class="text-xs text-gray-500 dark:text-gray-400">Akses FO</p>
        </div>
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 text-center">
            <p class="text-2xl font-bold text-purple-600">
                <%= vsatStarlinkList.length %>
            </p>
            <p class="text-xs text-gray-500 dark:text-gray-400">VSAT Starlink</p>
        </div>
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 text-center">
            <p class="text-2xl font-bold text-pink-600">
                <%= m2mList.length %>
            </p>
            <p class="text-xs text-gray-500 dark:text-gray-400">M2M</p>
        </div>
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 text-center">
            <p class="text-2xl font-bold text-teal-600">
                <%= vsatTdmaList.length %>
            </p>
            <p class="text-xs text-gray-500 dark:text-gray-400">VSAT TDMA</p>
        </div>
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 text-center">
            <p class="text-2xl font-bold text-indigo-600">
                <%= cpeList.length %>
            </p>
            <p class="text-xs text-gray-500 dark:text-gray-400">CPE</p>
        </div>
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 text-center">
            <p class="text-2xl font-bold text-cyan-600">
                <%= radioLinkList.length %>
            </p>
            <p class="text-xs text-gray-500 dark:text-gray-400">Radio Link</p>
        </div>
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 text-center">
            <p class="text-2xl font-bold text-pink-600">
                <%= aksesThirdPartyList.length %>
            </p>
            <p class="text-xs text-gray-500 dark:text-gray-400">3rd Party</p>
        </div>
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 text-center">
            <p class="text-2xl font-bold text-amber-600">
                <%= pendingGgnList.length %>
            </p>
            <p class="text-xs text-gray-500 dark:text-gray-400">Pending GGN</p>
        </div>
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 text-center">
            <p class="text-2xl font-bold text-green-600">
                <%= recordGgnList.length %>
            </p>
            <p class="text-xs text-gray-500 dark:text-gray-400">Record GGN</p>
        </div>
    </div>

    <!-- Akses FO Section -->
    <% if (aksesFoList.length> 0) { %>
        <div
            class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 flex items-center gap-2">
                <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0">
                    </path>
                </svg>
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Akses FO (<%= aksesFoList.length %>)
                </h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50 dark:bg-gray-900/50">
                        <tr>
                            <th
                                class="px-4 py-3 text-left text-sm font-semibold text-gray-600 dark:text-gray-400 w-1 whitespace-nowrap">
                                Node</th>
                            <th
                                class="px-4 py-3 text-left text-sm font-semibold text-gray-600 dark:text-gray-400 w-1 whitespace-nowrap">
                                Port OLT</th>
                            <th
                                class="px-4 py-3 text-left text-sm font-semibold text-gray-600 dark:text-gray-400 w-1 whitespace-nowrap">
                                SN Modem</th>
                            <th
                                class="px-4 py-3 text-left text-sm font-semibold text-gray-600 dark:text-gray-400 w-1 whitespace-nowrap">
                                Redaman</th>
                            <th
                                class="px-4 py-3 text-left text-sm font-semibold text-gray-600 dark:text-gray-400 w-1 whitespace-nowrap">
                                Bandwidth</th>
                            <th
                                class="px-4 py-3 text-left text-sm font-semibold text-gray-600 dark:text-gray-400 min-w-[200px]">
                                Keterangan</th>
                            <th
                                class="px-4 py-3 text-center text-sm font-semibold text-gray-600 dark:text-gray-400 sticky right-0 top-0 bg-gray-50 dark:bg-gray-900 z-30 shadow-[-4px_0_8px_-4px_rgba(0,0,0,0.1)] w-1 whitespace-nowrap">
                                Aksi</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                        <% aksesFoList.forEach(function(item) { %>
                            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                                <td
                                    class="px-4 py-3 text-sm text-gray-900 dark:text-white align-top w-1 whitespace-nowrap">
                                    <%= item.nodeInfo ? item.nodeInfo.node : '-' %>
                                </td>
                                <td
                                    class="px-4 py-3 text-sm text-gray-700 dark:text-gray-300 align-top w-1 whitespace-nowrap">
                                    <%= item.port_olt %>
                                </td>
                                <td
                                    class="px-4 py-3 text-sm text-gray-700 dark:text-gray-300 font-mono align-top w-1 whitespace-nowrap">
                                    <%= item.sn_modem || '-' %>
                                </td>
                                <td
                                    class="px-4 py-3 text-sm text-gray-700 dark:text-gray-300 align-top w-1 whitespace-nowrap">
                                    <%= item.redaman_value ? item.redaman_value + ' dB' : '-' %>
                                </td>
                                <td
                                    class="px-4 py-3 text-sm text-gray-700 dark:text-gray-300 align-top w-1 whitespace-nowrap">
                                    <%= item.bandwidth || '-' %>
                                </td>
                                <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-300 align-top"
                                    style="vertical-align: top !important; min-width: 200px;"><%- formatText(item.keterangan) %></td>
                                <td
                                    class="px-4 py-3 text-sm text-gray-700 dark:text-gray-300 sticky right-0 bg-white dark:bg-gray-800 z-20 shadow-[-4px_0_8px_-4px_rgba(0,0,0,0.1)] w-1 whitespace-nowrap">
                                    <div class="flex items-center justify-center gap-2">
                                        <a href="<%= (item.nodeInfo && item.nodeInfo.jenis === 'FO_P2P') ? '/akses-fo-p2p' : ((item.nodeInfo && item.nodeInfo.jenis === 'DIRECT_LAN') ? '/akses-direct-lan' : ((item.nodeInfo && item.nodeInfo.jenis === 'FO_XCONNECT') ? '/akses-fo-xconnect' : '/akses-fo')) %>/node/<%= item.nodeInfo ? item.nodeInfo.id : '' %>?search=<%= encodeURIComponent(pelanggan.nama_pelanggan) %>"
                                            class="text-blue-600 hover:text-blue-700 bg-blue-50 hover:bg-blue-100 p-1.5 rounded transition-colors"
                                            title="Detail">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z">
                                                </path>
                                            </svg>
                                        </a>
                                        <% if (isEditor) { %>
                                            <a href="<%= (item.nodeInfo && item.nodeInfo.jenis === 'FO_P2P') ? '/akses-fo-p2p' : ((item.nodeInfo && item.nodeInfo.jenis === 'DIRECT_LAN') ? '/akses-direct-lan' : ((item.nodeInfo && item.nodeInfo.jenis === 'FO_XCONNECT') ? '/akses-fo-xconnect' : '/akses-fo')) %>/<%= item.id %>/edit?return_url=/pelanggan/<%= pelanggan.id %>"
                                                class="text-amber-600 hover:text-amber-700 bg-amber-50 hover:bg-amber-100 p-1.5 rounded transition-colors"
                                                title="Edit">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor"
                                                    viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z">
                                                    </path>
                                                </svg>
                                            </a>
                                            <form
                                                action="<%= (item.nodeInfo && item.nodeInfo.jenis === 'FO_P2P') ? '/akses-fo-p2p' : ((item.nodeInfo && item.nodeInfo.jenis === 'DIRECT_LAN') ? '/akses-direct-lan' : ((item.nodeInfo && item.nodeInfo.jenis === 'FO_XCONNECT') ? '/akses-fo-xconnect' : '/akses-fo')) %>/<%= item.id %>?_method=DELETE&return_url=/pelanggan/<%= pelanggan.id %>"
                                                method="POST" class="inline"
                                                onsubmit="return confirmSubmit(this, 'Yakin hapus data ini?');">
                                                <button type="submit"
                                                    class="text-red-600 hover:text-red-700 bg-red-50 hover:bg-red-100 p-1.5 rounded transition-colors"
                                                    title="Hapus">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor"
                                                        viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            stroke-width="2"
                                                            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                                                        </path>
                                                    </svg>
                                                </button>
                                            </form>
                                            <% } %>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
        <% } %>

            <!-- VSAT Starlink Section -->
            <% if (vsatStarlinkList.length> 0) { %>
                <div
                    class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl shadow-sm overflow-hidden">
                    <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 flex items-center gap-2">
                        <svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z">
                            </path>
                        </svg>
                        <h3 class="text-lg font-semibold text-gray-900 dark:text-white">VSAT Starlink (<%=
                                vsatStarlinkList.length %>)</h3>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <thead class="bg-gray-50 dark:bg-gray-900/50">
                                <tr>
                                    <th
                                        class="px-4 py-3 text-left text-sm font-semibold text-gray-600 dark:text-gray-400 w-1 whitespace-nowrap">
                                        Type</th>
                                    <th
                                        class="px-4 py-3 text-left text-sm font-semibold text-gray-600 dark:text-gray-400 w-1 whitespace-nowrap">
                                        SN KIT</th>
                                    <th
                                        class="px-4 py-3 text-left text-sm font-semibold text-gray-600 dark:text-gray-400 w-1 whitespace-nowrap">
                                        SN Mikrotik</th>
                                    <th
                                        class="px-4 py-3 text-left text-sm font-semibold text-gray-600 dark:text-gray-400 w-1 whitespace-nowrap">
                                        No Reg PSU</th>
                                    <th
                                        class="px-4 py-3 text-left text-sm font-semibold text-gray-600 dark:text-gray-400 w-1 whitespace-nowrap">
                                        No Reg KIT</th>
                                    <th
                                        class="px-4 py-3 text-left text-sm font-semibold text-gray-600 dark:text-gray-400 min-w-[150px]">
                                        Web PRTG</th>
                                    <th
                                        class="px-4 py-3 text-center text-sm font-semibold text-gray-600 dark:text-gray-400 sticky right-0 top-0 bg-gray-50 dark:bg-gray-900 z-30 shadow-[-4px_0_8px_-4px_rgba(0,0,0,0.1)] w-1 whitespace-nowrap">
                                        Aksi</th>
                                </tr>
                            </thead>
