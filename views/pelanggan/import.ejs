<div class="space-y-6">
    <div class="flex items-center gap-4">
        <a href="/pelanggan" class="p-2 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition-colors">
            <svg class="w-5 h-5 text-gray-600 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
        </a>
        <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Import Data Customer</h1>
            <p class="text-sm text-gray-500 dark:text-gray-400">Masukkan data dari sheet DATA CUSTOMER. No jaringan yang sudah ada akan diperbarui.</p>
        </div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
        <section class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl shadow-sm p-6 space-y-5">
            <div>
                <h2 class="text-lg font-semibold text-gray-900 dark:text-white">File SIMPELL.xlsx</h2>
                <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Impor langsung sheet DATA CUSTOMER yang ada di workbook aplikasi.</p>
            </div>
            <% if (workbookInfo) { %>
                <dl class="grid grid-cols-2 gap-4 text-sm">
                    <div class="rounded-lg bg-gray-50 dark:bg-gray-900 px-4 py-3">
                        <dt class="text-gray-500 dark:text-gray-400">Sheet</dt>
                        <dd class="mt-1 font-medium text-gray-900 dark:text-white"><%= workbookInfo.sheetName %></dd>
                    </div>
                    <div class="rounded-lg bg-gray-50 dark:bg-gray-900 px-4 py-3">
                        <dt class="text-gray-500 dark:text-gray-400">Baris siap impor</dt>
                        <dd class="mt-1 font-medium text-gray-900 dark:text-white"><%= workbookInfo.total %></dd>
                    </div>
                </dl>
                <form action="/pelanggan/import/workbook" method="POST"
                    onsubmit="return confirmSubmit(this, 'Impor <%= workbookInfo.total %> customer dari sheet <%= workbookInfo.sheetName %>? No jaringan yang sudah ada akan diperbarui.');">
                    <button type="submit"
                        class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-amber-600 hover:bg-amber-700 text-white text-sm font-medium rounded-lg transition-colors shadow-sm">
                        Impor SIMPELL.xlsx
                    </button>
                </form>
            <% } else { %>
                <p class="text-sm text-red-600 dark:text-red-400">File SIMPELL.xlsx atau sheet DATA CUSTOMER tidak ditemukan.</p>
            <% } %>
        </section>

        <section class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl shadow-sm p-6 space-y-5">
            <div>
                <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Unggah file Excel</h2>
                <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Gunakan file .xlsx yang punya sheet DATA CUSTOMER dengan kolom yang sama.</p>
            </div>
            <form action="/pelanggan/import" method="POST" enctype="multipart/form-data" class="space-y-4"
                onsubmit="return confirmSubmit(this, 'Impor data customer dari file ini? No jaringan yang sudah ada akan diperbarui.');">
                <div>
                    <label for="file" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">File Excel</label>
                    <input type="file" name="file" id="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required
                        class="block w-full text-sm text-gray-700 dark:text-gray-300 file:mr-4 file:rounded-lg file:border-0 file:bg-amber-50 file:px-4 file:py-2.5 file:text-sm file:font-medium file:text-amber-700 hover:file:bg-amber-100 dark:file:bg-amber-900/30 dark:file:text-amber-300">
                </div>
                <button type="submit"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors shadow-sm">
                    Impor file
                </button>
            </form>
        </section>
    </div>

    <section class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl shadow-sm p-6">
        <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Kolom yang dibaca</h2>
        <div class="mt-4 flex flex-wrap gap-2">
            <% columns.forEach(function (column) { %>
                <span class="inline-flex px-3 py-1 rounded-full text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-200"><%= column %></span>
            <% }); %>
        </div>
        <p class="mt-4 text-sm text-gray-500 dark:text-gray-400">Status yang dikenali: Active, Inactive, dan Suspended. Alamat, kontak, dan email yang sudah tersimpan tidak diubah oleh sheet DATA CUSTOMER.</p>
    </section>
</div>
