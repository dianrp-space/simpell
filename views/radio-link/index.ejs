<div class="space-y-6">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Radio Link</h1>
            <p class="text-gray-500 dark:text-gray-400">Manajemen Access Point & Client • <%= pagination.total %> Access
                    Point</p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3">
            <a href="/radio-link/export<%= typeof search !== 'undefined' && search ? '?search=' + search : '' %>"
                class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-lg shadow-sm transition-colors cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z">
                    </path>
                </svg>
                Download Excel
            </a>
            <% if (isEditor) { %>
                <a href="/radio-link/create"
                    class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors shadow-sm cursor-pointer">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                    Tambah Access Point
                </a>
                <% } %>
        </div>
    </div>

    <!-- Search -->
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm">
        <form id="searchForm" action="/radio-link" method="GET" class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1">
                <input type="text" id="searchInput" name="search"
                    value="<%= typeof search !== 'undefined' ? search : '' %>"
                    placeholder="Cari Access Point, No Jaringan, atau Customer..."
                    class="w-full px-4 py-2.5 pl-10 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                <div class="absolute left-3 top-1/2 -translate-y-1/2">
                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </div>
            </div>
            <button type="submit"
                class="px-4 py-2.5 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 font-medium rounded-lg hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors">
                Cari
            </button>
            <% if (typeof search !=='undefined' && search) { %>
                <a href="/radio-link"
                    class="px-4 py-2.5 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors text-center max-w-fit">
                    Reset
                </a>
                <% } %>
        </form>
    </div>

    <script>
        const searchInput = document.getElementById('searchInput');
        const searchForm = document.getElementById('searchForm');
        let timeout = null;

        if (searchInput) {
            searchInput.addEventListener('input', function (e) {
                clearTimeout(timeout);
                timeout = setTimeout(function () {
                    // Search immediately if 3+ chars or empty (reset)
                    if (searchInput.value.length >= 3 || searchInput.value.length === 0) {
                        searchForm.submit();
                    }
                }, 500); // 500ms delay
            });

            // Focus and move cursor to end
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.has('search')) {
                searchInput.focus();
                const val = searchInput.value;
                searchInput.value = '';
                searchInput.value = val;
            }
        }
    </script>

    <!-- Table Card -->
    <div
        class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl shadow-sm overflow-hidden">
        <div class="overflow-auto max-h-[70vh]">
            <table class="w-full text-left border-collapse">
                <thead class="bg-gray-50 dark:bg-gray-700 sticky top-0 z-50 shadow-sm">
                    <tr>
                        <th
                            class="px-6 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                            Access Point</th>
                        <th
                            class="px-6 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                            IP NMS</th>
                        <th
                            class="px-6 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                            MAC Address</th>
                        <th
                            class="px-6 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                            SSID</th>
                        <th
                            class="px-6 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                            Frequency</th>
                        <th
                            class="px-6 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                            Bandwidth</th>
                        <th
                            class="px-6 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                            Power</th>
                        <th
                            class="px-6 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                            Antenna</th>
                        <th
                            class="px-6 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                            Net Mode</th>
                        <th
                            class="px-6 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                            Mod Mode</th>
                        <th
                            class="px-6 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                            Country</th>
                        <th
                            class="px-6 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                            Username</th>
                        <th
                            class="px-6 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                            Password</th>
                        <th
                            class="px-6 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                            Latitude</th>
                        <th
                            class="px-6 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                            Longitude</th>
                        <th
                            class="px-6 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                            Clients</th>
                        <th
                            class="px-3 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider text-center sticky right-0 top-0 bg-gray-50 dark:bg-gray-900 z-30 shadow-[-4px_0_8px_-4px_rgba(0,0,0,0.1)] w-1">
                            Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                    <% if (data.length===0) { %>
                        <tr>
                            <td colspan="17" class="px-6 py-12 text-center">
                                <p class="text-gray-500 dark:text-gray-400">Belum ada data Access Point</p>
                            </td>
                        </tr>
                        <% } else { %>
                            <% data.forEach(item=> { %>
                                <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                                    <td
                                        class="px-6 py-4 text-gray-900 dark:text-white font-medium align-top text-sm whitespace-nowrap">
                                        <%= item.nama_ap %>
                                    </td>
                                    <td
                                        class="px-6 py-4 text-gray-700 dark:text-gray-300 font-mono text-sm align-top whitespace-nowrap">
                                        <%= item.ip_nms || '-' %>
                                    </td>
                                    <td
                                        class="px-6 py-4 text-gray-700 dark:text-gray-300 font-mono text-sm align-top whitespace-nowrap">
                                        <%= item.mac_address || '-' %>
                                    </td>
                                    <td
                                        class="px-6 py-4 text-gray-700 dark:text-gray-300 align-top text-sm whitespace-nowrap">
                                        <%= item.ssid || '-' %>
                                    </td>
                                    <td
                                        class="px-6 py-4 text-gray-700 dark:text-gray-300 align-top text-sm whitespace-nowrap">
                                        <%= item.frequency || '-' %>
                                    </td>
                                    <td
                                        class="px-6 py-4 text-gray-700 dark:text-gray-300 align-top text-sm whitespace-nowrap">
                                        <%= item.channel_bandwidth || '-' %>
                                    </td>
                                    <td
                                        class="px-6 py-4 text-gray-700 dark:text-gray-300 align-top text-sm whitespace-nowrap">
                                        <%= item.power || '-' %>
                                    </td>
                                    <td
                                        class="px-6 py-4 text-gray-700 dark:text-gray-300 align-top text-sm whitespace-nowrap">
                                        <%= item.antenna_gain || '-' %>
                                    </td>
                                    <td
                                        class="px-6 py-4 text-gray-700 dark:text-gray-300 align-top text-sm whitespace-nowrap">
                                        <%= item.network_mode || '-' %>
                                    </td>
                                    <td
                                        class="px-6 py-4 text-gray-700 dark:text-gray-300 align-top text-sm whitespace-nowrap">
                                        <%= item.module_mode || '-' %>
                                    </td>
                                    <td
                                        class="px-6 py-4 text-gray-700 dark:text-gray-300 align-top text-sm whitespace-nowrap">
                                        <%= item.country || '-' %>
                                    </td>
                                    <td
                                        class="px-6 py-4 text-gray-700 dark:text-gray-300 align-top text-sm whitespace-nowrap">
                                        <%= item.username || '-' %>
                                    </td>
                                    <td
                                        class="px-6 py-4 text-gray-700 dark:text-gray-300 align-top text-sm whitespace-nowrap">
                                        <%= item.password || '-' %>
                                    </td>
                                    <td
                                        class="px-6 py-4 text-gray-700 dark:text-gray-300 align-top font-mono text-sm whitespace-nowrap">
                                        <%= item.latitude || '-' %>
                                    </td>
                                    <td
                                        class="px-6 py-4 text-gray-700 dark:text-gray-300 align-top font-mono text-sm whitespace-nowrap">
                                        <%= item.longitude || '-' %>
                                    </td>
                                    <td
                                        class="px-6 py-4 text-gray-700 dark:text-gray-300 align-top text-sm whitespace-nowrap">
                                        <span
                                            class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400">
                                            <%= item.clients ? item.clients.length : 0 %> Client
                                        </span>
                                    </td>
                                    <td
                                        class="px-3 py-4 align-top text-center sticky right-0 bg-white dark:bg-gray-800 z-20 shadow-[-4px_0_8px_-4px_rgba(0,0,0,0.1)] w-1 text-sm">
                                        <div class="flex items-center justify-center gap-2">
                                            <a href="/radio-link/<%= item.id %>"
                                                class="p-2 text-blue-600 hover:bg-blue-50 dark:hover:bg-blue-900/20 rounded-lg transition-colors"
                                                title="Detail & Clients">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor"
                                                    viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z">
                                                    </path>
                                                </svg>
                                            </a>
                                            <% if (isEditor) { %>
                                                <a href="/radio-link/<%= item.id %>/edit"
                                                    class="p-2 text-amber-600 hover:bg-amber-50 dark:hover:bg-amber-900/20 rounded-lg transition-colors"
                                                    title="Edit AP">
                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor"
                                                        viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            stroke-width="2"
                                                            d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z">
                                                        </path>
                                                    </svg>
                                                </a>
                                                <form action="/radio-link/<%= item.id %>?_method=DELETE" method="POST"
                                                    class="inline"
                                                    onsubmit="return confirmSubmit(this, 'Hapus AP ini beserta semua client-nya?')">
                                                    <button type="submit"
                                                        class="p-2 text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-lg transition-colors"
                                                        title="Hapus">
                                                        <svg class="w-5 h-5" fill="none" stroke="currentColor"
                                                            viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                                stroke-width="2"
                                                                d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                                                            </path>
                                                        </svg>
                                                    </button>
                                                </form>
                                                <% } %>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                                    <% } %>
                </tbody>
            </table>
            <%- include('../partials/pagination') %>
        </div>
    </div>
</div>