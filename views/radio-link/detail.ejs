<div class="space-y-6">
    <!-- Header & Back -->
    <div class="flex items-center gap-4">
        <a href="/radio-link"
            class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:text-white dark:hover:bg-gray-700 rounded-lg transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18">
                </path>
            </svg>
        </a>
        <div class="flex-1">
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
                <%= data.nama_ap %>
            </h1>
            <p class="text-gray-500 dark:text-gray-400 text-sm">Access Point Detail</p>
        </div>
        <% if (isEditor) { %>
            <div>
                <a href="/radio-link/<%= data.id %>/client/create"
                    class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors shadow-sm cursor-pointer">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                    Tambah Client
                </a>
            </div>
            <% } %>
    </div>

    <!-- AP Info Card -->
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6 shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Informasi Perangkat</h3>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-sm">
            <div>
                <p class="text-gray-500">IP NMS</p>
                <p class="font-mono text-gray-900 dark:text-white">
                    <%= data.ip_nms || '-' %>
                </p>
            </div>
            <div>
                <p class="text-gray-500">MAC Address</p>
                <p class="font-mono text-gray-900 dark:text-white">
                    <%= data.mac_address || '-' %>
                </p>
            </div>
            <div>
                <p class="text-gray-500">SSID</p>
                <p class="font-medium text-gray-900 dark:text-white">
                    <%= data.ssid || '-' %>
                </p>
            </div>
            <div>
                <p class="text-gray-500">Frequency</p>
                <p class="text-gray-900 dark:text-white">
                    <%= data.frequency || '-' %>
                </p>
            </div>
            <div>
                <p class="text-gray-500">Bandwidth</p>
                <p class="text-gray-900 dark:text-white">
                    <%= data.channel_bandwidth || '-' %>
                </p>
            </div>
            <div>
                <p class="text-gray-500">Power</p>
                <p class="text-gray-900 dark:text-white">
                    <%= data.power || '-' %>
                </p>
            </div>
            <div>
                <p class="text-gray-500">Antenna Gain</p>
                <p class="text-gray-900 dark:text-white">
                    <%= data.antenna_gain || '-' %>
                </p>
            </div>
            <div>
                <p class="text-gray-500">Network Mode</p>
                <p class="text-gray-900 dark:text-white">
                    <%= data.network_mode || '-' %>
                </p>
            </div>
            <div>
                <p class="text-gray-500">Module Mode</p>
                <p class="text-gray-900 dark:text-white">
                    <%= data.module_mode || '-' %>
                </p>
            </div>
            <div>
                <p class="text-gray-500">Country</p>
                <p class="text-gray-900 dark:text-white">
                    <%= data.country || '-' %>
                </p>
            </div>
            <div>
                <p class="text-gray-500">Username</p>
                <p class="text-gray-900 dark:text-white">
                    <%= data.username || '-' %>
                </p>
            </div>
            <div>
                <p class="text-gray-500">Password</p>
                <p class="text-gray-900 dark:text-white">
                    <%= data.password || '-' %>
                </p>
            </div>
            <div>
                <p class="text-gray-500">Koordinat</p>
                <% if (data.latitude && data.longitude) { %>
                    <a href="https://www.google.com/maps?q=<%= data.latitude %>,<%= data.longitude %>" target="_blank"
                        class="font-mono text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1">
                        <%= data.latitude %>, <%= data.longitude %>
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14">
                                    </path>
                                </svg>
                    </a>
                    <% } else { %>
                        <p class="text-gray-900 dark:text-white">-</p>
                        <% } %>
            </div>
        </div>
    </div>

    <!-- Client Search -->
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm">
        <form id="clientSearchForm" action="" method="GET" class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1">
                <input type="text" id="clientSearchInput" name="search"
                    value="<%= typeof search !== 'undefined' ? search : '' %>"
                    placeholder="Cari No Jaringan atau Customer..."
                    class="w-full px-4 py-2.5 pl-10 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                <div class="absolute left-3 top-1/2 -translate-y-1/2">
                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </div>
            </div>
            <button type="submit"
                class="px-4 py-2.5 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 font-medium rounded-lg hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors">
                Cari
            </button>

        </form>
    </div>

    <script>
        const clientSearchInput = document.getElementById('clientSearchInput');
        const clientSearchForm = document.getElementById('clientSearchForm');
        let clientTimeout = null;

        if (clientSearchInput) {
            clientSearchInput.addEventListener('input', function (e) {
                clearTimeout(clientTimeout);
                clientTimeout = setTimeout(function () {
                    if (clientSearchInput.value.length >= 3 || clientSearchInput.value.length === 0) {
                        clientSearchForm.submit();
                    }
                }, 500);
            });

            // Focus
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.has('search')) {
                clientSearchInput.focus();
                const val = clientSearchInput.value;
                clientSearchInput.value = '';
                clientSearchInput.value = val;
            }
        }
    </script>

    <!-- Clients Table -->
    <div
        class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl shadow-sm overflow-hidden">
        <div class="p-4 border-b border-gray-200 dark:border-gray-700">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Daftar Client (<%= data.clients ?
                    data.clients.length : 0 %>)</h3>
        </div>
        <div class="overflow-auto max-h-[60vh]">
            <table class="w-full text-left border-collapse">
                <thead class="bg-gray-50 dark:bg-gray-700 sticky top-0 z-50 shadow-sm">
                    <tr>
                        <th
                            class="px-6 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                            No Jaringan</th>
                        <th
                            class="px-6 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap min-w-[200px]">
                            Customer</th>
                        <th
                            class="px-6 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                            IP NMS</th>
                        <th
                            class="px-6 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                            MAC Address</th>
                        <th
                            class="px-6 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                            SSID</th>
                        <th
                            class="px-6 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                            Frequency</th>
                        <th
                            class="px-6 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                            Bandwidth</th>
                        <th
                            class="px-6 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                            Power</th>
                        <th
                            class="px-6 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                            Antenna</th>
                        <th
                            class="px-6 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                            Net Mode</th>
                        <th
                            class="px-6 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                            Mod Mode</th>
                        <th
                            class="px-6 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                            Country</th>
                        <th
                            class="px-6 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                            Username</th>
                        <th
                            class="px-6 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                            Password</th>
                        <th
                            class="px-6 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                            Latitude</th>
                        <th
                            class="px-6 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                            Longitude</th>
                        <th
                            class="px-2 py-4 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider text-center sticky right-0 top-0 bg-gray-50 dark:bg-gray-700 z-30 shadow-[-4px_0_8_px_-4px_rgba(0,0,0,0.1)] w-1">
                            Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                    <% if (!data.clients || data.clients.length===0) { %>
                        <tr>
                            <td colspan="17" class="px-6 py-8 text-center text-gray-500">Tidak ada client terhubung</td>
                        </tr>
                        <% } else { %>
                            <% data.clients.forEach(client=> { %>
                                <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                                    <td
                                        class="px-6 py-4 text-sm font-medium text-gray-900 dark:text-white whitespace-nowrap">
                                        <%= client.pelanggan ? client.pelanggan.no_jaringan : '-' %>
                                    </td>
                                    <td
                                        class="px-6 py-4 text-sm text-gray-900 dark:text-white whitespace-nowrap min-w-[200px]">
                                        <%= client.pelanggan ? client.pelanggan.nama_pelanggan : '-' %>
                                    </td>
                                    <td
                                        class="px-6 py-4 text-sm font-mono text-gray-700 dark:text-gray-300 whitespace-nowrap">
                                        <%= client.ip_nms || '-' %>
                                    </td>
                                    <td
                                        class="px-6 py-4 text-sm font-mono text-gray-700 dark:text-gray-300 whitespace-nowrap">
                                        <%= client.mac_address || '-' %>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300 whitespace-nowrap">
                                        <%= client.ssid || '-' %>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300 whitespace-nowrap">
                                        <%= client.frequency || '-' %>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300 whitespace-nowrap">
                                        <%= client.channel_bandwidth || '-' %>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300 whitespace-nowrap">
                                        <%= client.power || '-' %>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300 whitespace-nowrap">
                                        <%= client.antenna_gain || '-' %>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300 whitespace-nowrap">
                                        <%= client.network_mode || '-' %>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300 whitespace-nowrap">
                                        <%= client.module_mode || '-' %>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300 whitespace-nowrap">
                                        <%= client.country || '-' %>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300 whitespace-nowrap">
                                        <%= client.username || '-' %>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300 whitespace-nowrap">
                                        <%= client.password || '-' %>
                                    </td>
                                    <td
                                        class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300 whitespace-nowrap font-mono">
                                        <% if (client.latitude && client.longitude) { %>
                                            <a href="https://www.google.com/maps?q=<%= client.latitude %>,<%= client.longitude %>"
                                                target="_blank"
                                                class="flex items-center gap-1 text-blue-500 hover:underline"
                                                title="Buka di Google Maps">
                                                <%= client.latitude %>
                                            </a>
                                        <% } else { %><%= client.latitude || '-' %><% } %>
                                    </td>
                                    <td
                                        class="px-6 py-4 text-sm text-gray-700 dark:text-gray-300 whitespace-nowrap font-mono">
                                        <% if (client.latitude && client.longitude) { %>
                                            <a href="https://www.google.com/maps?q=<%= client.latitude %>,<%= client.longitude %>"
                                                target="_blank"
                                                class="flex items-center gap-1 text-blue-500 hover:underline"
                                                title="Buka di Google Maps">
                                                <%= client.longitude %>
                                            </a>
                                        <% } else { %><%= client.longitude || '-' %><% } %>
                                    </td>
                                    <td
                                        class="px-2 py-4 whitespace-nowrap text-center sticky right-0 bg-white dark:bg-gray-800 z-20 shadow-[-4px_0_8px_-4px_rgba(0,0,0,0.1)] w-1 text-sm">
                                        <div class="flex items-center justify-center gap-1">
                                            <% if (isEditor) { %>
                                                <a href="/radio-link/<%= data.id %>/client/<%= client.id %>/edit"
                                                    class="p-2 text-amber-600 hover:bg-amber-50 dark:hover:bg-amber-900/30 rounded-lg transition-colors"
                                                    title="Edit Client">
                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor"
                                                        viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            stroke-width="2"
                                                            d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z">
                                                        </path>
                                                    </svg>
                                                </a>
                                                <form action="/radio-link/client/<%= client.id %>?_method=DELETE"
                                                    method="POST" class="inline"
                                                    onsubmit="return confirmSubmit(this, 'Hapus client ini?')">
                                                    <input type="hidden" name="ap_id" value="<%= data.id %>">
                                                    <button type="submit"
                                                        class="p-2 text-red-600 hover:bg-red-50 dark:hover:bg-red-900/30 rounded-lg transition-colors"
                                                        title="Hapus">
                                                        <svg class="w-5 h-5" fill="none" stroke="currentColor"
                                                            viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                                stroke-width="2"
                                                                d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                                                            </path>
                                                        </svg>
                                                    </button>
                                                </form>
                                                <% } %>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>