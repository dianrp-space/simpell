<div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center gap-4">
        <a href="/radio-link/<%= ap.id %>"
            class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:text-white dark:hover:bg-gray-700 rounded-lg transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18">
                </path>
            </svg>
        </a>
        <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
                <%= clientData ? 'Edit' : 'Tambah' %> Client
            </h1>
            <p class="text-sm text-gray-500">AP: <%= ap.nama_ap %>
            </p>
        </div>
    </div>

    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6 shadow-sm">
        <form
            action="<%= clientData ? '/radio-link/' + ap.id + '/client/' + clientData.id + '?_method=PUT' : '/radio-link/' + ap.id + '/client' %>"
            method="POST" class="space-y-6">

            <!-- Customer Selection -->
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Customer <span
                        class="text-blue-500 text-xs">(Cari & Pilih)</span></label>
                <div class="relative">
                    <input type="text" id="pelanggan_search" placeholder="Cari No Jaringan / Customer..."
                        autocomplete="off"
                        class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all">
                    <input type="hidden" id="pelanggan_id" name="pelanggan_id"
                        value="<%= clientData ? clientData.pelanggan_id : '' %>">

                    <!-- Dropdown Results -->
                    <div id="pelanggan_dropdown"
                        class="absolute z-50 w-full mt-1 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-xl shadow-lg max-h-60 overflow-y-auto hidden">
                    </div>
                </div>

                <!-- Selected Pelanggan Display -->
                <div id="selected_pelanggan" class="mt-2 <%= clientData && clientData.pelanggan ? '' : 'hidden' %>">
                    <div
                        class="flex items-center gap-2 p-2 bg-blue-50 dark:bg-blue-900/30 border border-blue-200 dark:border-blue-700 rounded-lg">
                        <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                        <span id="selected_text" class="text-sm text-blue-700 dark:text-blue-300">
                            <% if (clientData && clientData.pelanggan) { %>
                                <%= clientData.pelanggan.no_jaringan %> - <%= clientData.pelanggan.nama_pelanggan %>
                                        <% } %>
                        </span>
                        <button type="button" id="clear_pelanggan" class="ml-auto text-blue-500 hover:text-blue-700">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Hidden No Jaringan (Auto-filled) - REMOVED -->
            <!-- <input type="hidden" name="no_jaringan" value="<%= clientData ? clientData.no_jaringan : '' %>"> -->

            <!-- Detail Network 1 -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">IP NMS</label>
                    <input type="text" name="ip_nms" value="<%= clientData ? clientData.ip_nms : '' %>"
                        class="w-full px-4 py-2 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">MAC Address</label>
                    <input type="text" name="mac_address" value="<%= clientData ? clientData.mac_address : '' %>"
                        class="w-full px-4 py-2 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg">
                </div>
            </div>

            <!-- Detail Network 2 -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">SSID</label>
                    <input type="text" name="ssid" value="<%= clientData ? clientData.ssid : '' %>"
                        class="w-full px-4 py-2 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Frequency (CH
                        FRQ)</label>
                    <input type="text" name="frequency" value="<%= clientData ? clientData.frequency : '' %>"
                        class="w-full px-4 py-2 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg">
                </div>
            </div>

            <!-- Technical Stats -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Power</label>
                    <input type="text" name="power" value="<%= clientData ? clientData.power : '' %>"
                        class="w-full px-4 py-2 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Antenna Gain</label>
                    <input type="text" name="antenna_gain" value="<%= clientData ? clientData.antenna_gain : '' %>"
                        class="w-full px-4 py-2 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Bandwidth</label>
                    <input type="text" name="channel_bandwidth"
                        value="<%= clientData ? clientData.channel_bandwidth : '' %>"
                        class="w-full px-4 py-2 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg">
                </div>
            </div>

            <!-- Mode & Region -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Network Mode</label>
                    <input type="text" name="network_mode" value="<%= clientData ? clientData.network_mode : '' %>"
                        class="w-full px-4 py-2 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Module Mode</label>
                    <input type="text" name="module_mode" value="<%= clientData ? clientData.module_mode : '' %>"
                        class="w-full px-4 py-2 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Country</label>
                    <input type="text" name="country" value="<%= clientData ? clientData.country : '' %>"
                        class="w-full px-4 py-2 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg">
                </div>
            </div>

            <!-- Auth -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Username</label>
                    <input type="text" name="username" value="<%= clientData ? clientData.username : '' %>"
                        class="w-full px-4 py-2 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Password</label>
                    <input type="text" name="password" value="<%= clientData ? clientData.password : '' %>"
                        class="w-full px-4 py-2 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg">
                </div>
            </div>

            <!-- Coordinate -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Latitude</label>
                    <input type="text" name="latitude" value="<%= clientData ? clientData.latitude : '' %>"
                        class="w-full px-4 py-2 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Longitude</label>
                    <input type="text" name="longitude" value="<%= clientData ? clientData.longitude : '' %>"
                        class="w-full px-4 py-2 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg">
                </div>
            </div>

            <div class="flex gap-3 pt-4 border-t border-gray-200 dark:border-gray-700">
                <button type="submit"
                    class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg shadow-sm transition-colors">
                    Simpan Client
                </button>
                <a href="<%= (typeof returnUrl !== 'undefined' && returnUrl) ? returnUrl : '/radio-link/' + (ap ? ap.id : '#') %>"
                    class="inline-flex items-center px-5 py-2.5 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                    Batal
                </a>
            </div>
        </form>
    </div>
</div>

<input type="hidden" id="pelanggan_list_data" value='<%- JSON.stringify(pelangganList || []) %>'>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const pelangganSearch = document.getElementById('pelanggan_search');
        const pelangganDropdown = document.getElementById('pelanggan_dropdown');
        const pelangganIdInput = document.getElementById('pelanggan_id');
        const selectedPelangganDiv = document.getElementById('selected_pelanggan');
        const selectedText = document.getElementById('selected_text');
        const clearButton = document.getElementById('clear_pelanggan');

        // Input fields to autofill
        // const noJaringanInput = document.querySelector('input[name="no_jaringan"]'); // Removed

        let pelangganList = [];
        try {
            pelangganList = JSON.parse(document.getElementById('pelanggan_list_data').value);
        } catch (e) { }

        // Filter Function
        pelangganSearch.addEventListener('input', function () {
            const query = this.value.toLowerCase();
            pelangganDropdown.innerHTML = '';

            if (query.length < 1) {
                pelangganDropdown.classList.add('hidden');
                return;
            }

            const filtered = pelangganList.filter(p =>
                (p.nama_pelanggan && p.nama_pelanggan.toLowerCase().includes(query)) ||
                (p.no_jaringan && p.no_jaringan.toLowerCase().includes(query))
            ).slice(0, 10);

            if (filtered.length > 0) {
                pelangganDropdown.innerHTML = filtered.map(p => `
                    <div class="item px-4 py-3 hover:bg-gray-100 dark:hover:bg-gray-700 cursor-pointer border-b border-gray-100 dark:border-gray-700 last:border-0" 
                         data-id="${p.id}" 
                         data-nama="${p.nama_pelanggan}"
                         data-no="${p.no_jaringan || ''}">
                        <div class="font-medium text-sm text-gray-900 dark:text-white">${p.no_jaringan || '-'}</div>
                        <div class="text-sm text-gray-500 dark:text-gray-400">${p.nama_pelanggan}</div>
                    </div>
                `).join('');
                pelangganDropdown.classList.remove('hidden');
            } else {
                pelangganDropdown.innerHTML = '<div class="px-4 py-3 text-sm text-gray-500">Tidak ada pelanggan ditemukan</div>';
                pelangganDropdown.classList.remove('hidden');
            }
        });

        // Select Item
        pelangganDropdown.addEventListener('click', function (e) {
            const item = e.target.closest('.item');
            if (item) {
                const id = item.dataset.id;
                const nama = item.dataset.nama;
                const no = item.dataset.no;

                pelangganIdInput.value = id;
                selectedText.textContent = `${no} - ${nama}`;

                // Autofill No Jaringan if empty or user wants it
                // if (noJaringanInput) noJaringanInput.value = no; // Removed

                selectedPelangganDiv.classList.remove('hidden');
                pelangganSearch.value = '';
                pelangganDropdown.classList.add('hidden');
            }
        });

        // Clear Selection
        if (clearButton) {
            clearButton.addEventListener('click', function () {
                pelangganIdInput.value = '';
                // if (noJaringanInput) noJaringanInput.value = ''; // Removed
                selectedPelangganDiv.classList.add('hidden');
            });
        }

        // Close on click outside
        document.addEventListener('click', function (e) {
            if (!pelangganSearch.contains(e.target) && !pelangganDropdown.contains(e.target)) {
                pelangganDropdown.classList.add('hidden');
            }
        });
    });
</script>

<script src="/js/coordinate-converter.js"></script>