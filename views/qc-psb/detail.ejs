<div class="max-w-4xl space-y-6">
    <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-4">
            <a href="/qc-psb" class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:text-white dark:hover:bg-gray-700 rounded-lg">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            </a>
            <div>
                <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Detail QC PSB & Project</h1>
                <p class="text-sm text-gray-500 dark:text-gray-400"><%= data.nojar || data.customer || '-' %></p>
            </div>
        </div>
        <% if (isEditor) { %>
            <a href="/qc-psb/<%= data.id %>/edit" class="px-4 py-2.5 bg-amber-500 hover:bg-amber-600 text-white text-sm font-medium rounded-lg">Edit</a>
        <% } %>
    </div>

    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6 shadow-sm grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-4 bg-gray-50 dark:bg-gray-900/50 rounded-lg">
            <p class="text-xs text-gray-500 mb-1">Tanggal</p>
            <p class="font-medium text-gray-900 dark:text-white"><%= data.tanggal ? moment(data.tanggal).format('DD/MM/YYYY') : '-' %></p>
        </div>
        <div class="p-4 bg-gray-50 dark:bg-gray-900/50 rounded-lg">
            <p class="text-xs text-gray-500 mb-1">No Tiket</p>
            <p class="font-medium text-gray-900 dark:text-white"><%= data.notik || '-' %></p>
        </div>
        <div class="p-4 bg-gray-50 dark:bg-gray-900/50 rounded-lg">
            <p class="text-xs text-gray-500 mb-1">No Jaringan</p>
            <p class="font-medium text-gray-900 dark:text-white"><%= data.nojar || '-' %></p>
        </div>
        <div class="p-4 bg-gray-50 dark:bg-gray-900/50 rounded-lg">
            <p class="text-xs text-gray-500 mb-1">QC ke</p>
            <p class="font-medium text-gray-900 dark:text-white"><%= data.qc_ke || '-' %></p>
        </div>
        <div class="p-4 bg-gray-50 dark:bg-gray-900/50 rounded-lg">
            <p class="text-xs text-gray-500 mb-1">Jenis</p>
            <p class="font-medium text-gray-900 dark:text-white"><%= data.jenis || '-' %></p>
        </div>
        <div class="p-4 bg-gray-50 dark:bg-gray-900/50 rounded-lg md:col-span-2">
            <p class="text-xs text-gray-500 mb-1">Customer</p>
            <p class="font-medium text-gray-900 dark:text-white"><%= data.customer || '-' %></p>
        </div>
        <div class="p-4 bg-gray-50 dark:bg-gray-900/50 rounded-lg">
            <p class="text-xs text-gray-500 mb-1">Akses</p>
            <p class="font-medium text-gray-900 dark:text-white"><%= data.akses || '-' %></p>
        </div>
        <div class="p-4 bg-gray-50 dark:bg-gray-900/50 rounded-lg">
            <p class="text-xs text-gray-500 mb-1">PJ</p>
            <p class="font-medium text-gray-900 dark:text-white"><%= data.pj || '-' %></p>
        </div>
        <div class="p-4 bg-gray-50 dark:bg-gray-900/50 rounded-lg">
            <p class="text-xs text-gray-500 mb-1">Status</p>
            <p class="font-medium text-gray-900 dark:text-white"><%= data.status || '-' %></p>
        </div>
        <div class="p-4 bg-gray-50 dark:bg-gray-900/50 rounded-lg md:col-span-2">
            <p class="text-xs text-gray-500 mb-1">Keterangan</p>
            <p class="font-medium text-gray-900 dark:text-white whitespace-pre-wrap"><%- formatText(data.keterangan) %></p>
        </div>
    </div>
</div>
