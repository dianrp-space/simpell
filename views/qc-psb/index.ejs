<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white">QC PSB & Project</h1>
            <p class="text-gray-500 dark:text-gray-400">Tanggal, no jaringan, customer, QC ke, jenis, akses, PJ, status, keterangan</p>
        </div>
        <div class="flex items-center gap-3">
            <% if (isEditor) { %>
                <a href="/qc-psb/create"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white font-medium rounded-lg shadow-lg shadow-blue-500/25 transition-all">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                    Tambah Data
                </a>
            <% } %>
            <a href="/qc-psb/export?search=<%= encodeURIComponent(search) %>&status=<%= encodeURIComponent(status) %>"
                class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-green-600 hover:bg-green-700 text-white font-medium rounded-lg shadow-lg shadow-green-500/25 transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                Download Excel
            </a>
        </div>
    </div>

    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm">
        <form id="searchForm" action="/qc-psb" method="GET" class="flex flex-col md:flex-row gap-3">
            <div class="relative flex-1">
                <input type="text" id="searchInput" name="search" value="<%= search %>"
                    placeholder="Cari no jaringan, customer, QC, jenis, PJ..."
                    class="w-full px-4 py-2.5 pl-10 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                <div class="absolute left-3 top-1/2 -translate-y-1/2">
                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </div>
            </div>
            <div class="w-full md:w-48">
                <select name="status" id="statusFilter"
                    class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    <option value="">Semua Status</option>
                    <% statuses.forEach(function (item) { %>
                        <option value="<%= item %>" <%= status === item ? 'selected' : '' %>><%= item %></option>
                    <% }); %>
                </select>
            </div>
            <% if (search || status) { %>
                <a href="/qc-psb" class="px-4 py-2.5 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors text-center">Reset</a>
            <% } %>
        </form>
    </div>
</div>

<div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl shadow-sm overflow-hidden">
    <div class="overflow-auto max-h-[80vh] relative">
        <table class="w-full">
            <thead class="sticky top-0 z-50 bg-gray-50 dark:bg-gray-900 border-b border-gray-200 dark:border-gray-700 shadow-sm">
                <tr>
                    <% ['Tanggal', 'No Jaringan', 'Customer', 'QC ke', 'Jenis', 'Akses', 'PJ', 'Status', 'Keterangan'].forEach(function (label) { %>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap"><%= label %></th>
                    <% }); %>
                    <th class="px-3 py-3 text-center text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider sticky right-0 top-0 bg-gray-50 dark:bg-gray-900 z-30 shadow-[-4px_0_8px_-4px_rgba(0,0,0,0.1)]">Aksi</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                <% if (!data.length) { %>
                    <tr>
                        <td colspan="10" class="px-6 py-12 text-center text-gray-500 dark:text-gray-400">Tidak ada data</td>
                    </tr>
                <% } else { %>
                    <% data.forEach(function (item) { %>
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 text-sm">
                            <td class="px-4 py-4 whitespace-nowrap text-gray-700 dark:text-gray-300 align-top"><%= item.tanggal ? moment(item.tanggal).format('DD/MM/YYYY') : '-' %></td>
                            <td class="px-4 py-4 whitespace-nowrap text-gray-900 dark:text-white align-top"><%= item.nojar || '-' %></td>
                            <td class="px-4 py-4 text-gray-900 dark:text-white align-top min-w-[220px]"><%= item.customer || '-' %></td>
                            <td class="px-4 py-4 whitespace-nowrap text-gray-900 dark:text-white align-top"><%= item.qc_ke || '-' %></td>
                            <td class="px-4 py-4 text-gray-900 dark:text-white align-top min-w-[160px]"><%= item.jenis || '-' %></td>
                            <td class="px-4 py-4 whitespace-nowrap text-gray-700 dark:text-gray-300 align-top"><%= item.akses || '-' %></td>
                            <td class="px-4 py-4 whitespace-nowrap text-gray-700 dark:text-gray-300 align-top"><%= item.pj || '-' %></td>
                            <td class="px-4 py-4 whitespace-nowrap align-top">
                                <% const statusClass = item.status === 'Done'
                                    ? 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400'
                                    : (item.status === 'Progress'
                                        ? 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400'
                                        : 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400'); %>
                                <span class="inline-flex px-2.5 py-0.5 rounded-full text-xs font-medium <%= statusClass %>"><%= item.status %></span>
                            </td>
                            <td class="px-4 py-4 text-gray-700 dark:text-gray-300 align-top min-w-[280px]"><%- formatText(item.keterangan) %></td>
                            <td class="px-3 py-4 whitespace-nowrap align-top sticky right-0 bg-white dark:bg-gray-800 z-20 shadow-[-4px_0_8px_-4px_rgba(0,0,0,0.1)]">
                                <div class="flex items-center justify-center gap-1">
                                    <a href="/qc-psb/<%= item.id %>" class="p-2 text-blue-600 hover:bg-blue-50 dark:hover:bg-blue-900/20 rounded-lg" title="Detail">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                    </a>
                                    <% if (isEditor) { %>
                                        <a href="/qc-psb/<%= item.id %>/edit" class="p-2 text-amber-600 hover:bg-amber-50 dark:hover:bg-amber-900/20 rounded-lg" title="Edit">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                        </a>
                                        <form action="/qc-psb/<%= item.id %>?_method=DELETE" method="POST" class="inline" onsubmit="return confirmSubmit(this, 'Hapus data ini?')">
                                            <button type="submit" class="p-2 text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-lg" title="Hapus">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                            </button>
                                        </form>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                <% } %>
            </tbody>
        </table>
        <%- include('../partials/pagination') %>
    </div>
</div>

<script>
    const searchInput = document.getElementById('searchInput');
    const searchForm = document.getElementById('searchForm');
    const statusFilter = document.getElementById('statusFilter');
    let timeout = null;
    searchInput.addEventListener('input', function () {
        clearTimeout(timeout);
        timeout = setTimeout(function () { searchForm.submit(); }, 500);
    });
    statusFilter.addEventListener('change', function () { searchForm.submit(); });
</script>
