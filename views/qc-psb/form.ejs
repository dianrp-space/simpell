<div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center gap-4">
        <a href="/qc-psb" class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:text-white dark:hover:bg-gray-700 rounded-lg">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        </a>
        <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white"><%= data ? 'Edit' : 'Tambah' %> QC PSB & Project</h1>
            <p class="text-gray-500 dark:text-gray-400">Tanggal, no tiket, no jaringan, QC ke, jenis, customer, akses, PJ, status, keterangan</p>
        </div>
    </div>

    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6 shadow-sm">
        <form action="<%= data ? '/qc-psb/' + data.id + '?_method=PUT' : '/qc-psb' %>" method="POST" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label for="tanggal" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Tanggal <span class="text-red-500">*</span></label>
                    <input type="date" id="tanggal" name="tanggal" required value="<%= data && data.tanggal ? moment(data.tanggal).format('YYYY-MM-DD') : moment().format('YYYY-MM-DD') %>"
                        class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500">
                </div>
                <div>
                    <label for="notik" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">No Tiket</label>
                    <input type="text" id="notik" name="notik" value="<%= data ? data.notik || '' : '' %>"
                        class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500"
                        placeholder="Nomor tiket">
                </div>
                <div>
                    <label for="nojar" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">No Jaringan</label>
                    <input type="text" id="nojar" name="nojar" value="<%= data ? data.nojar || '' : '' %>"
                        class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500"
                        placeholder="Nomor jaringan">
                </div>
                <div>
                    <label for="qc_ke" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">QC ke</label>
                    <input list="qc_list" type="text" id="qc_ke" name="qc_ke" value="<%= data ? data.qc_ke || '' : '' %>"
                        class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500"
                        placeholder="Contoh: QC 1">
                    <datalist id="qc_list"><% qcKe.forEach(function (item) { %><option value="<%= item %>"><% }); %></datalist>
                </div>
                <div>
                    <label for="jenis" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Jenis</label>
                    <input list="jenis_list" type="text" id="jenis" name="jenis" value="<%= data ? data.jenis || '' : '' %>"
                        class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500"
                        placeholder="Contoh: PSB / RELOKASI / PM">
                    <datalist id="jenis_list"><% jenis.forEach(function (item) { %><option value="<%= item %>"><% }); %></datalist>
                </div>
                <div class="md:col-span-2">
                    <label for="customer" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Customer</label>
                    <input type="text" id="customer" name="customer" value="<%= data ? data.customer || '' : '' %>"
                        class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500"
                        placeholder="Nama customer">
                </div>
                <div>
                    <label for="akses" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Akses</label>
                    <input list="akses_list" type="text" id="akses" name="akses" value="<%= data ? data.akses || '' : '' %>"
                        class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500"
                        placeholder="Contoh: FO">
                    <datalist id="akses_list"><% akses.forEach(function (item) { %><option value="<%= item %>"><% }); %></datalist>
                </div>
                <div>
                    <label for="pj" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">PJ</label>
                    <input list="pj_list" type="text" id="pj" name="pj" value="<%= data ? data.pj || '' : '' %>"
                        class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500"
                        placeholder="Penanggung jawab">
                    <datalist id="pj_list"><% pj.forEach(function (item) { %><option value="<%= item %>"><% }); %></datalist>
                </div>
                <div>
                    <label for="status" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Status</label>
                    <input list="status_list" type="text" id="status" name="status" value="<%= data ? data.status || 'Pending' : 'Pending' %>"
                        class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500">
                    <datalist id="status_list"><% statuses.forEach(function (item) { %><option value="<%= item %>"><% }); %></datalist>
                </div>
            </div>
            <div>
                <label for="keterangan" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Keterangan</label>
                <textarea id="keterangan" name="keterangan" rows="4"
                    class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500"><%= data ? data.keterangan || '' : '' %></textarea>
            </div>
            <div class="flex justify-end gap-3 pt-4 border-t border-gray-200 dark:border-gray-700">
                <a href="/qc-psb" class="px-4 py-2.5 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-200 text-sm font-medium rounded-lg">Batal</a>
                <button type="submit" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg"><%= data ? 'Simpan Perubahan' : 'Tambah Data' %></button>
            </div>
        </form>
    </div>
</div>
