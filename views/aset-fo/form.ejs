<!-- Aset FO Form -->
<div class="max-w-2xl mx-auto space-y-6">
        <!-- Page Header -->
        <div class="flex items-center gap-4">
                <a href="/aset-fo"
                        class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:text-white dark:hover:bg-gray-700 rounded-lg transition-colors">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M10 19l-7-7m0 0l7-7m-7 7h18">
                                </path>
                        </svg>
                </a>
                <div>
                        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
                                <%= data ? 'Edit' : 'Tambah' %> Aset FO
                        </h1>
                        <p class="text-gray-500 dark:text-gray-400">Data Aset Fiber Optik</p>
                </div>
        </div>

        <!-- Form Card -->
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6 shadow-sm">
                <form action="<%= data ? '/aset-fo/' + data.id + '?_method=PUT' : '/aset-fo' %>" method="POST"
                        class="space-y-5">

                        <!-- Node & Kota -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                        <label for="nama_node"
                                                class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                                                Nama Node <span class="text-red-500">*</span>
                                        </label>
                                        <input type="text" id="nama_node" name="nama_node" required
                                                value="<%= data ? data.nama_node : '' %>"
                                                class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                                                placeholder="Nama node">
                                </div>
                                <div>
                                        <label for="kota"
                                                class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Kota</label>
                                        <input type="text" id="kota" name="kota"
                                                value="<%= data ? data.kota || '' : '' %>"
                                                class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                                                placeholder="Nama kota">
                                </div>
                        </div>

                        <!-- Node ID & Splitter -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                        <label for="node"
                                                class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Node</label>
                                        <input type="text" id="node" name="node"
                                                value="<%= data ? data.node || '' : '' %>"
                                                class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                                                placeholder="Kode node">
                                </div>
                                <div>
                                        <label for="splitter_odp"
                                                class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                                                Splitter/ODP
                                        </label>
                                        <input type="text" id="splitter_odp" name="splitter_odp"
                                                value="<%= data ? data.splitter_odp || '' : '' %>"
                                                class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                                                placeholder="Splitter ODP">
                                </div>
                        </div>

                        <!-- Counts: ONT, P2P, HH -->
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                                <div>
                                        <label for="jumlah_si_ont"
                                                class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Jml
                                                SI [ONT]</label>
                                        <input type="number" id="jumlah_si_ont" name="jumlah_si_ont"
                                                value="<%= data ? data.jumlah_si_ont || 0 : 0 %>"
                                                class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all">
                                </div>
                                <div>
                                        <label for="jumlah_si_p2p"
                                                class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Jml
                                                SI [P2P]</label>
                                        <input type="number" id="jumlah_si_p2p" name="jumlah_si_p2p"
                                                value="<%= data ? data.jumlah_si_p2p || 0 : 0 %>"
                                                class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all">
                                </div>
                                <div>
                                        <label for="jumlah_hh"
                                                class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Jml
                                                HH</label>
                                        <input type="number" id="jumlah_hh" name="jumlah_hh"
                                                value="<%= data ? data.jumlah_hh || 0 : 0 %>"
                                                class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all">
                                </div>
                        </div>

                        <!-- Lengths & Tiang -->
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                                <div>
                                        <label for="panjang_backbone"
                                                class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Backbone
                                                (m)</label>
                                        <input type="number" id="panjang_backbone" name="panjang_backbone"
                                                value="<%= data ? data.panjang_backbone || '' : '' %>"
                                                class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all">
                                </div>
                                <div>
                                        <label for="panjang_lastmile"
                                                class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Lastmile
                                                (m)</label>
                                        <input type="number" id="panjang_lastmile" name="panjang_lastmile"
                                                value="<%= data ? data.panjang_lastmile || '' : '' %>"
                                                class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all">
                                </div>
                                <div>
                                        <label for="jumlah_tiang"
                                                class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Jml
                                                Tiang</label>
                                        <input type="number" id="jumlah_tiang" name="jumlah_tiang"
                                                value="<%= data ? data.jumlah_tiang || 0 : 0 %>"
                                                class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all">
                                </div>
                        </div>

                        <div class="flex gap-3 pt-4 border-t border-gray-200 dark:border-gray-700">
                                <button type="submit"
                                        class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white font-medium rounded-lg shadow-lg shadow-blue-500/25 transition-all transform hover:scale-[1.02]">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                        d="M5 13l4 4L19 7"></path>
                                        </svg>
                                        <%= data ? 'Simpan Perubahan' : 'Simpan' %>
                                </button>
                                <a href="/aset-fo"
                                        class="inline-flex items-center px-5 py-2.5 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                                        Batal
                                </a>
                        </div>
                </form>
        </div>
</div>