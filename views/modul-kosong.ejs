<div class="max-w-3xl space-y-6">
    <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-blue-600 dark:text-blue-400"><%= page.group %></p>
        <h1 class="mt-1 text-2xl font-bold text-gray-900 dark:text-white"><%= page.title %></h1>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-300"><%= page.note %></p>
    </div>
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6 shadow-sm">
        <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Kolom di SIMPELL.xlsx</h2>
        <ul class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-2">
            <% page.columns.forEach(function (column) { %>
                <li class="px-3 py-2 rounded-lg bg-gray-50 dark:bg-gray-900 text-sm text-gray-700 dark:text-gray-200"><%= column %></li>
            <% }); %>
        </ul>
        <p class="mt-4 text-sm text-gray-500 dark:text-gray-400">Halaman isian belum dibuat. Data modul lama yang tidak masuk menu baru tetap tersimpan dan bisa dibuka lewat URL lama.</p>
    </div>
</div>
