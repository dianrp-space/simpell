<!-- OTB PHD Sector Detail - Table with Tube Rowspan -->
<% const colorCSS={ 'Blue' : '#0000FF' , 'Orange' : '#FF8000' , 'Green' : '#00FF00' , 'Brown' : '#8B4513' , 'Gray'
    : '#808080' , 'White' : '#FFFFFF' , 'Red' : '#FF0000' , 'Black' : '#000000' , 'Yellow' : '#FFFF00' , 'Purple'
    : '#800080' , 'Pink' : '#FFC0CB' , 'Aqua' : '#00FFFF' }; const colorMapCSS={ 'Blue' : 'bg-blue-500' , 'Orange'
    : 'bg-orange-500' , 'Green' : 'bg-green-500' , 'Brown' : 'bg-amber-700' , 'Gray' : 'bg-gray-400' , 'White'
    : 'bg-gray-100 border border-gray-300' , 'Red' : 'bg-red-500' , 'Black' : 'bg-gray-900' , 'Yellow' : 'bg-yellow-400'
    , 'Purple' : 'bg-purple-500' , 'Pink' : 'bg-pink-400' , 'Aqua' : 'bg-cyan-400' }; %>

    <div class="space-y-6">
        <!-- Page Header -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div class="flex items-center gap-4">
                <a href="<%= (typeof central !== 'undefined' && central) ? fiberBase + '/central/' + central.id : fiberBase %>"
                    class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:text-white dark:hover:bg-gray-700 rounded-lg transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                </a>
                <div>
                    <h1 class="text-xl md:text-2xl font-bold text-gray-900 dark:text-white">
                        <%= sectorName %>
                    </h1>
                </div>
            </div>
            <% const extraColumns = typeof customColumns !== 'undefined' ? customColumns : []; %>
            <div class="flex flex-col sm:flex-row sm:items-center gap-2">
            <% if (isEditor && typeof customColumns !== 'undefined') { %>
                <form action="<%= fiberBase %>/sector/<%= encodeURIComponent(sectorName) %>/columns" method="POST" class="flex items-center gap-2">
                    <input type="text" name="name" required maxlength="40" placeholder="Nama kolom baru"
                        class="w-44 px-3 py-2 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-600 rounded-lg text-sm text-gray-900 dark:text-white placeholder-gray-400 focus:ring-2 focus:ring-blue-500">
                    <button type="submit"
                        class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors">
                        Tambah Kolom
                    </button>
                </form>
            <% } %>
            <% if (isEditor) { %>
                <a href="<%= fiberBase %>/sector/<%= encodeURIComponent(sectorName) %>/edit?return_to=<%= fiberBase %>/sector/<%= encodeURIComponent(sectorName) %>"
                    class="inline-flex items-center gap-2 px-4 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z">
                        </path>
                    </svg>
                    Edit Sector
                </a>
                <% } %>
            </div>
        </div>

        <!-- Summary Stats -->
        <% let totalAvailable=0, totalActive=0, totalAlokasi=0, totalCut=0; tubes.forEach(t=> {
            totalAvailable += t.cores.filter(c => c.status === 'None' || c.status === 'Idle').length;
            totalActive += t.cores.filter(c => c.status === 'Active').length;
            totalAlokasi += t.cores.filter(c => c.status === 'Alokasi').length;
            totalCut += t.cores.filter(c => c.status === 'Cut').length;
            });
            %>
            <div class="grid grid-cols-2 lg:grid-cols-5 gap-4">
                <!-- Total Core -->
                <div
                    class="bg-blue-50 dark:bg-blue-900/10 border border-blue-100 dark:border-blue-900/20 rounded-xl p-3 flex items-center gap-3">
                    <div class="p-2 bg-blue-100 dark:bg-blue-900/30 rounded-lg text-blue-600 dark:text-blue-400">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-[10px] font-bold text-blue-600 dark:text-blue-400 uppercase tracking-wider">Total
                            Core</p>
                        <p class="text-xl font-bold text-gray-900 dark:text-white leading-none mt-0.5">
                            <%= totalCores %>
                        </p>
                    </div>
                </div>

                <!-- Available -->
                <div
                    class="bg-sky-50 dark:bg-sky-900/10 border border-sky-100 dark:border-sky-900/20 rounded-xl p-3 flex items-center gap-3">
                    <div class="p-2 bg-sky-100 dark:bg-sky-900/30 rounded-lg text-sky-600 dark:text-sky-400">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-[10px] font-bold text-sky-600 dark:text-sky-400 uppercase tracking-wider">
                            Available (None/Idle)</p>
                        <p class="text-xl font-bold text-gray-900 dark:text-white leading-none mt-0.5">
                            <%= totalAvailable %>
                        </p>
                    </div>
                </div>

                <!-- Active -->
                <div
                    class="bg-green-50 dark:bg-green-900/10 border border-green-100 dark:border-green-900/20 rounded-xl p-3 flex items-center gap-3">
                    <div class="p-2 bg-green-100 dark:bg-green-900/30 rounded-lg text-green-600 dark:text-green-400">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-[10px] font-bold text-green-600 dark:text-green-400 uppercase tracking-wider">
                            Active</p>
                        <p class="text-xl font-bold text-gray-900 dark:text-white leading-none mt-0.5">
                            <%= totalActive %>
                        </p>
                    </div>
                </div>

                <!-- Alokasi -->
                <div
                    class="bg-indigo-50 dark:bg-indigo-900/10 border border-indigo-100 dark:border-indigo-900/20 rounded-xl p-3 flex items-center gap-3">
                    <div
                        class="p-2 bg-indigo-100 dark:bg-indigo-900/30 rounded-lg text-indigo-600 dark:text-indigo-400">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-[10px] font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider">
                            Alokasi</p>
                        <p class="text-xl font-bold text-gray-900 dark:text-white leading-none mt-0.5">
                            <%= totalAlokasi %>
                        </p>
                    </div>
                </div>

                <!-- Cut -->
                <div
                    class="bg-red-50 dark:bg-red-900/10 border border-red-100 dark:border-red-900/20 rounded-xl p-3 flex items-center gap-3">
                    <div class="p-2 bg-red-100 dark:bg-red-900/30 rounded-lg text-red-600 dark:text-red-400">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-[10px] font-bold text-red-600 dark:text-red-400 uppercase tracking-wider">Cut</p>
                        <p class="text-xl font-bold text-gray-900 dark:text-white leading-none mt-0.5">
                            <%= totalCut %>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Desktop Table with Tube Rowspan -->
            <div
                class="hidden md:block bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl shadow-sm">
                <div class="overflow-auto max-h-[80vh] relative">
                    <table class="w-full text-sm border-collapse">
                        <thead class="sticky top-0 z-50 bg-white dark:bg-gray-800 shadow-md">
                            <tr
                                class="bg-gradient-to-r from-blue-600 to-blue-700 text-white uppercase text-xs font-semibold tracking-wider">
                                <th class="p-3 text-left border-r border-blue-500 w-24">Tube</th>
                                <th class="p-3 text-center border-r border-blue-500 w-20">Core</th>
                                <th class="p-3 text-center border-r border-blue-500 w-28">Status</th>
                                <th class="p-3 text-left border-r border-blue-500">Description Core</th>
                                <th class="p-3 text-left border-r border-blue-500">Destination</th>
                                <th class="p-3 text-left border-r border-blue-500">Customer</th>
                                <th class="p-3 text-left border-r border-blue-500">Keterangan</th>
                                <% extraColumns.forEach(function (column) { %>
                                    <th class="p-3 text-left border-r border-blue-500 min-w-[140px]">
                                        <div class="flex items-center justify-between gap-2 normal-case">
                                            <span><%= column.name %></span>
                                            <% if (isEditor) { %>
                                                <form action="<%= fiberBase %>/sector/<%= encodeURIComponent(sectorName) %>/columns/<%= column.id %>?_method=DELETE" method="POST" class="inline" onsubmit="return confirmSubmit(this, 'Hapus kolom <%= column.name %>?')">
                                                    <button type="submit" class="text-white/80 hover:text-white" title="Hapus kolom" aria-label="Hapus kolom <%= column.name %>">×</button>
                                                </form>
                                            <% } %>
                                        </div>
                                    </th>
                                <% }); %>
                            </tr>
                        </thead>
                        <tbody>
                            <% tubes.forEach(tube=> {
                                const tubeColor = tube.tube_color || coreColors[(tube.tube_number - 1) % 12];
                                const tubeClass = colorMapCSS[tubeColor] || 'bg-gray-200';
                                const isWhite = tubeColor === 'White';
                                %>
                                <% tube.cores.forEach((core, coreIndex)=> {
                                    const coreColor = core.core_color || coreColors[(core.core_number - 1) % 12];
                                    const coreClass = colorMapCSS[coreColor] || 'bg-gray-200';
                                    const isCoreWhite = coreColor === 'White';
                                    const isFirstCore = coreIndex === 0;
                                    const isLastCore = coreIndex === tube.cores.length - 1;
                                    %>
                                    <tr
                                        class="border-b border-gray-100 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors <%= isLastCore ? 'border-b-2 border-b-gray-300 dark:border-b-gray-600' : '' %>">
                                        <% if (isFirstCore) { %>
                                            <td rowspan="<%= tube.cores.length %>"
                                                class="p-0 border-r border-gray-200 dark:border-gray-700 align-top <%= tubeClass %> <%= isWhite ? 'text-gray-800' : 'text-white' %> sticky left-0 z-20">
                                                <div
                                                    class="sticky top-12 flex flex-col items-center justify-center h-full max-h-full py-4 px-3">
                                                    <span class="font-bold text-lg">T<%= tube.tube_number %></span>
                                                    <span class="text-xs opacity-80">
                                                        <%= tubeColor %>
                                                    </span>
                                                </div>
                                            </td>
                                            <% } %>
                                                <td class="p-2 border-r border-gray-200 dark:border-gray-700">
                                                    <div class="flex items-center gap-2 justify-center">
                                                        <div
                                                            class="w-6 h-6 rounded-full <%= coreClass %> flex items-center justify-center shadow-sm">
                                                            <span
                                                                class="text-xs font-bold <%= isCoreWhite ? 'text-gray-800' : 'text-white' %>">
                                                                <%= core.core_number %>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td
                                                    class="p-2 border-r border-gray-200 dark:border-gray-700 text-center">
                                                    <% if (isEditor) { %>
                                                        <select onchange="updateCoreStatus(this, '<%= core.id %>')"
                                                            class="text-xs font-medium rounded-md border-gray-300 focus:border-blue-500 focus:ring-blue-500 cursor-pointer py-1 pl-2 pr-8 transition-colors
                                                    <%= core.status === 'Active' ? 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400' :
                                                       core.status === 'Alokasi' ? 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400' :
                                                       core.status === 'Cut' ? 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400' :
                                                       core.status === 'Idle' ? 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400' :
                                                       'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300' %>">
                                                            <% statuses.forEach(s=> { %>
                                                                <option value="<%= s %>" <%=core.status===s ? 'selected'
                                                                    : '' %>
                                                                    class="bg-white text-gray-900 dark:bg-gray-800
                                                                    dark:text-white"><%= s %>
                                                                </option>
                                                                <% }) %>
                                                        </select>
                                                        <% } else { %>
                                                            <span
                                                                class="text-xs font-bold <%= core.status === 'Active' ? 'text-green-600' : (core.status === 'Alokasi' ? 'text-blue-600' : (core.status === 'Cut' ? 'text-red-600' : (core.status === 'Idle' ? 'text-yellow-600' : 'text-gray-400'))) %>">
                                                                <%= core.status || 'NONE' %>
                                                            </span>
                                                            <% } %>
                                                </td>
                                                <td
                                                    class="p-2 border-r border-gray-200 dark:border-gray-700 text-sm align-middle">
                                                    <% if (isEditor) { %>
                                                        <button type="button"
                                                            onclick="openOtbEditModal(this.dataset.id, this.dataset.field, this.dataset.value, this.dataset.core)" data-id="<%= core.id %>" data-field="description_core" data-value="<%= core.description_core || '' %>" data-core="<%= core.core_number %>"
                                                            class="w-full text-left block hover:bg-blue-50 dark:hover:bg-blue-900/20 rounded p-1 -m-1 transition-colors min-h-[1.5rem]">
                                                            <% if (core.description_core) { %>
                                                                <span class="text-gray-900 dark:text-white">
                                                                    <%- formatText(core.description_core) %>
                                                                </span>
                                                                <% } else { %>
                                                                    <span
                                                                        class="text-gray-300 dark:text-gray-600 hover:text-blue-400 text-xs">+
                                                                        Add Desc Core</span>
                                                                    <% } %>
                                                        </button>
                                                        <% } else { %>
                                                            <span class="text-gray-900 dark:text-white">
                                                                <%= core.description_core || '-' %>
                                                            </span>
                                                            <% } %>
                                                </td>
                                                <td
                                                    class="p-2 border-r border-gray-200 dark:border-gray-700 text-sm align-middle">
                                                    <% if (isEditor) { %>
                                                        <button type="button"
                                                            onclick="openOtbEditModal(this.dataset.id, this.dataset.field, this.dataset.value, this.dataset.core)" data-id="<%= core.id %>" data-field="destination" data-value="<%= core.destination || '' %>" data-core="<%= core.core_number %>"
                                                            class="w-full text-left block hover:bg-blue-50 dark:hover:bg-blue-900/20 rounded p-1 -m-1 transition-colors min-h-[1.5rem]">
                                                            <% if (core.destination) { %>
                                                                <span class="text-gray-900 dark:text-white">
                                                                    <%- formatText(core.destination) %>
                                                                </span>
                                                                <% } else { %>
                                                                    <span
                                                                        class="text-gray-300 dark:text-gray-600 hover:text-blue-400 text-xs">+
                                                                        Add Dest</span>
                                                                    <% } %>
                                                        </button>
                                                        <% } else { %>
                                                            <span class="text-gray-900 dark:text-white">
                                                                <%= core.destination || '-' %>
                                                            </span>
                                                            <% } %>
                                                </td>
                                                <td
                                                    class="p-2 border-r border-gray-200 dark:border-gray-700 text-sm align-middle">
                                                    <% if (isEditor) { %>
                                                        <button type="button"
                                                            onclick="openOtbEditModal(this.dataset.id, this.dataset.field, this.dataset.value, this.dataset.core)" data-id="<%= core.id %>" data-field="customer" data-value="<%= core.customer || '' %>" data-core="<%= core.core_number %>"
                                                            class="w-full text-left block hover:bg-blue-50 dark:hover:bg-blue-900/20 rounded p-1 -m-1 transition-colors min-h-[1.5rem]">
                                                            <% if (core.customer) { %>
                                                                <span class="text-gray-900 dark:text-white">
                                                                    <%- formatText(core.customer) %>
                                                                </span>
                                                                <% } else { %>
                                                                    <span
                                                                        class="text-gray-300 dark:text-gray-600 hover:text-blue-400 text-xs">+
                                                                        Add Cust</span>
                                                                    <% } %>
                                                        </button>
                                                        <% } else { %>
                                                            <span class="text-gray-900 dark:text-white font-medium">
                                                                <%= core.customer || '-' %>
                                                            </span>
                                                            <% } %>
                                                </td>
                                                <td
                                                    class="p-2 border-r border-gray-200 dark:border-gray-700 text-sm align-middle">
                                                    <% if (isEditor) { %>
                                                        <button type="button"
                                                            onclick="openOtbEditModal(this.dataset.id, this.dataset.field, this.dataset.value, this.dataset.core)" data-id="<%= core.id %>" data-field="keterangan" data-value="<%= core.keterangan || '' %>" data-core="<%= core.core_number %>"
                                                            class="w-full text-left block hover:bg-blue-50 dark:hover:bg-blue-900/20 rounded p-1 -m-1 transition-colors min-h-[1.5rem]">
                                                            <% if (core.keterangan) { %>
                                                                <span class="text-gray-500 dark:text-gray-400 italic">
                                                                    <%- formatText(core.keterangan) %>
                                                                </span>
                                                                <% } else { %>
                                                                    <span
                                                                        class="text-gray-300 dark:text-gray-600 hover:text-blue-400 text-xs">+
                                                                        Add Ket</span>
                                                                    <% } %>
                                                        </button>
                                                        <% } else { %>
                                                            <span class="text-gray-500 dark:text-gray-400 italic">
                                                                <%= core.keterangan || '-' %>
                                                            </span>
                                                            <% } %>
                                                </td>
                                                <% extraColumns.forEach(function (column) { %>
                                                    <% const customValue = core.custom_values && core.custom_values[String(column.id)] ? core.custom_values[String(column.id)] : ''; %>
                                                    <td class="p-2 border-r border-gray-200 dark:border-gray-700 text-sm align-middle">
                                                        <% if (isEditor) { %>
                                                            <button type="button"
                                                                onclick="openOtbEditModal(this.dataset.id, 'custom', this.dataset.value, this.dataset.core, this.dataset.columnId, this.dataset.label)"
                                                                data-id="<%= core.id %>" data-value="<%= customValue %>" data-core="<%= core.core_number %>" data-column-id="<%= column.id %>" data-label="<%= column.name %>"
                                                                class="w-full text-left block hover:bg-blue-50 dark:hover:bg-blue-900/20 rounded p-1 -m-1 transition-colors min-h-[1.5rem]">
                                                                <% if (customValue) { %>
                                                                    <span class="text-gray-900 dark:text-white"><%- formatText(customValue) %></span>
                                                                <% } else { %>
                                                                    <span class="text-gray-300 dark:text-gray-600 hover:text-blue-400 text-xs">+ <%= column.name %></span>
                                                                <% } %>
                                                            </button>
                                                        <% } else { %>
                                                            <span class="text-gray-900 dark:text-white"><%= customValue || '-' %></span>
                                                        <% } %>
                                                    </td>
                                                <% }); %>
                                    </tr>
                                    <% }); %>
                                        <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Mobile Card Layout - Grouped by Tube -->
            <div class="md:hidden space-y-4">
                <% tubes.forEach(tube=> {
                    const tubeColor = tube.tube_color || coreColors[(tube.tube_number - 1) % 12];
                    const tubeBg = colorCSS[tubeColor] || '#808080';
                    const tubeText = ['White', 'Yellow', 'Aqua', 'Pink', 'Green'].includes(tubeColor) ? '#000000' :
                    '#FFFFFF';
                    %>
                    <div
                        class="bg-white dark:bg-gray-800 rounded-xl shadow-sm overflow-hidden border border-gray-200 dark:border-gray-700">
                        <!-- Tube Header -->
                        <div class="px-4 py-3 flex items-center gap-3"
                            style="background-color: <%= tubeBg %>; color: <%= tubeText %>;">
                            <span class="text-lg font-bold">Tube <%= tube.tube_number %></span>
                            <span class="text-sm opacity-80">
                                <%= tubeColor %>
                            </span>
                            <span class="ml-auto text-xs px-2 py-0.5 rounded-full"
                                style="background-color: rgba(255,255,255,0.2);">
                                <%= tube.cores.length %> core
                            </span>
                        </div>

                        <!-- Cores Grid -->
                        <div class="p-3 grid grid-cols-2 xs:grid-cols-3 gap-2">
                            <% tube.cores.forEach(core=> {
                                const coreColor = core.core_color || coreColors[(core.core_number - 1) % 12];
                                const coreBg = colorCSS[coreColor] || '#808080';
                                const coreText = ['White', 'Yellow', 'Aqua', 'Pink', 'Green'].includes(coreColor) ?
                                '#000000' : '#FFFFFF';
                                %>
                                <div
                                    class="border border-gray-200 dark:border-gray-700 rounded-lg p-2 text-xs relative bg-gray-50 dark:bg-gray-900 shadow-sm">
                                    <div class="flex items-center gap-2 mb-1">
                                        <span
                                            class="inline-flex items-center justify-center w-5 h-5 rounded-full font-bold text-[10px]"
                                            style="background-color: <%= coreBg %>; color: <%= coreText %>;">
                                            <%= core.core_number %>
                                        </span>
                                        <% if (core.status==='Active' ) { %>
                                            <span class="font-bold text-green-600">ACT</span>
                                            <% } else if (core.status==='Alokasi' ) { %>
                                                <span class="font-bold text-blue-600">ALK</span>
                                                <% } else if (core.status==='Cut' ) { %>
                                                    <span class="font-bold text-red-600">CUT</span>
                                                    <% } else if (core.status==='Idle' ) { %>
                                                        <span class="font-bold text-yellow-600">IDL</span>
                                                        <% } else { %>
                                                            <span class="font-bold text-gray-500">NON</span>
                                                            <% } %>
                                    </div>
                                    <div class="space-y-0.5 mt-2">
                                        <% if (core.customer) { %>
                                            <div class="truncate font-medium text-gray-900 dark:text-white"
                                                title="<%= core.customer %>">
                                                <%= core.customer %>
                                            </div>
                                            <% } %>
                                                <% if (core.destination) { %>
                                                    <div class="truncate text-gray-500" title="<%= core.destination %>">
                                                        <%= core.destination %>
                                                    </div>
                                                    <% } %>
                                                <% extraColumns.forEach(function (column) { %>
                                                    <% const customValue = core.custom_values && core.custom_values[String(column.id)] ? core.custom_values[String(column.id)] : ''; %>
                                                    <% if (customValue) { %>
                                                        <div class="truncate text-gray-500" title="<%= column.name %>: <%= customValue %>">
                                                            <span class="font-medium"><%= column.name %>:</span> <%= customValue %>
                                                        </div>
                                                    <% } %>
                                                <% }); %>
                                    </div>
                                    <% if (isEditor) { %>
                                        <a href="<%= fiberBase %>/<%= core.id %>/edit"
                                            class="absolute top-2 right-2 text-gray-400 hover:text-blue-500"
                                            title="Edit">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z">
                                                </path>
                                            </svg>
                                        </a>
                                        <% } %>
                                </div>
                                <% }); %>
                        </div>
                    </div>
                    <% }); %>
            </div>
    </div>


    <!-- OTB Edit Modal -->
    <div id="otbEditModal" class="fixed inset-0 z-[100] hidden overflow-y-auto" aria-labelledby="modal-title"
        role="dialog" aria-modal="true">
        <div class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
            <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true"
                onclick="closeOtbEditModal()"></div>
            <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
            <div
                class="inline-block align-bottom bg-white dark:bg-gray-800 rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg w-full">
                <form id="otbEditForm" method="POST" action="">
                    <div class="bg-white dark:bg-gray-800 px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                        <div class="sm:flex sm:items-start">
                            <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left w-full">
                                <h3 class="text-lg leading-6 font-medium text-gray-900 dark:text-white" id="modalTitle">
                                    Edit Data</h3>
                                <div class="mt-4" id="inputContainer">
                                    <!-- Dynamic Input Injected Here -->
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="bg-gray-50 dark:bg-gray-700 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
                        <button type="submit"
                            class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-blue-600 text-base font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 sm:ml-3 sm:w-auto sm:text-sm">
                            Simpan
                        </button>
                        <button type="button" onclick="closeOtbEditModal()"
                            class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 dark:border-gray-500 shadow-sm px-4 py-2 bg-white dark:bg-gray-800 text-base font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">
                            Batal
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        // Update Status (Refined Style)
        function updateCoreStatus(select, coreId) {
            const value = select.value;

            // Update visual style immediately
            const clsMap = {
                'Active': 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400',
                'Alokasi': 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400',
                'Cut': 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400',
                'Idle': 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400',
                'None': 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300'
            };

            // Apply base class + color class
            select.className = "text-xs font-medium rounded-md border-gray-300 focus:border-blue-500 focus:ring-blue-500 cursor-pointer py-1 pl-2 pr-8 transition-colors " + (clsMap[value] || clsMap['None']);

            fetch(`<%= fiberBase %>/${coreId}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({ status: value })
            })
                .then(res => res.json())
                .then(data => {
                    if (!data.success) {
                        alert('Gagal memperbarui status: ' + (data.message || 'Unknown error'));
                        // Optional: Revert style on failure
                    }
                })
                .catch(err => {
                    console.error(err);
                    alert('Terjadi kesalahan saat memperbarui status');
                });
        }

        // Modal Functions
        function openOtbEditModal(coreId, field, currentValue, coreNumber, columnId, columnLabel) {
            const modal = document.getElementById('otbEditModal');
            const form = document.getElementById('otbEditForm');
            const title = document.getElementById('modalTitle');
            const inputContainer = document.getElementById('inputContainer');

            // Set Form Action (Method Override handled by default POST if using middleware, but fetch/action usually needs _method)
            // Assuming method-override is set up in app.js for ?_method=PUT
            form.action = `<%= fiberBase %>/${coreId}?_method=PUT`;

            // Determine Field Config
            let label = '';
            let inputHtml = '';

            switch (field) {
                case 'description_core':
                    label = 'Description Core';
                    inputHtml = `<textarea name="description_core" rows="3" class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white sm:text-sm p-2" placeholder="Masukkan Description Core...">${currentValue}</textarea>`;
                    break;
                case 'destination':
                    label = 'Destination';
                    inputHtml = `<input type="text" name="destination" value="${currentValue}" class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white sm:text-sm p-2" placeholder="Masukkan Destination...">`;
                    break;
                case 'customer':
                    label = 'Customer';
                    inputHtml = `<input type="text" name="customer" value="${currentValue}" class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white sm:text-sm p-2" placeholder="Masukkan Customer...">`;
                    break;
                case 'keterangan':
                    label = 'Keterangan';
                    inputHtml = `<textarea name="keterangan" rows="3" class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white sm:text-sm p-2" placeholder="Masukkan Keterangan...">${currentValue}</textarea>`;
                    break;
                case 'custom':
                    label = columnLabel || 'Kolom';
                    const safeCustom = String(currentValue || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
                    const safeLabel = String(label).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
                    inputHtml = `<input type="hidden" name="custom_column_id" value="${columnId}"><input type="text" name="custom_value" value="${safeCustom}" class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white sm:text-sm p-2" placeholder="Masukkan ${safeLabel}...">`;
                    break;
            }

            // Update UI
            title.textContent = `Edit ${label} (Core ${coreNumber})`;
            inputContainer.innerHTML = `
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">${label}</label>
                ${inputHtml}
            `;

            // Show Modal
            modal.classList.remove('hidden');

            // Focus input
            setTimeout(() => {
                const input = inputContainer.querySelector('input, textarea');
                if (input) input.focus();
            }, 100);
        }

        function closeOtbEditModal() {
            document.getElementById('otbEditModal').classList.add('hidden');
        }

        // Close on Escape
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeOtbEditModal();
        });
    </script>