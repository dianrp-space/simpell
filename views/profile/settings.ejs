<div class="flex items-center justify-center min-h-screen py-10 px-4">
    <div
        class="bg-white dark:bg-gray-800 rounded-[2rem] shadow-2xl w-full max-w-lg overflow-hidden border border-gray-100 dark:border-gray-700">
        <!-- Header -->
        <div class="bg-gradient-to-r from-gray-900 to-gray-800 p-8 text-center relative">
            <h1 class="text-2xl font-black text-white tracking-tight">Tampilan</h1>
            <p class="text-gray-400 text-sm mt-1">Pilih tema aplikasi Anda</p>
            <a href="/portal"
                class="absolute top-4 right-4 p-2 bg-white/10 hover:bg-white/20 rounded-xl text-white transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12">
                    </path>
                </svg>
            </a>
        </div>

        <div class="p-8">
            <div class="space-y-4">
                <!-- Light Mode -->
                <button onclick="setTheme('light')"
                    class="w-full group relative flex items-center gap-4 p-4 border-2 rounded-2xl hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-all duration-200 focus:outline-none theme-btn text-left"
                    data-theme="light">
                    <div
                        class="w-12 h-12 bg-white border border-gray-200 rounded-xl flex items-center justify-center shadow-sm text-gray-600">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z">
                            </path>
                        </svg>
                    </div>
                    <div class="flex-grow">
                        <span class="block font-bold text-gray-900 dark:text-white">Mode Terang</span>
                        <span class="text-xs text-gray-500">Tampilan bersih dan cerah</span>
                    </div>
                    <div
                        class="w-6 h-6 rounded-full border-2 border-gray-300 dark:border-gray-600 flex items-center justify-center check-icon">
                        <div class="w-3 h-3 bg-blue-600 rounded-full hidden"></div>
                    </div>
                </button>

                <!-- Dark Mode -->
                <button onclick="setTheme('dark')"
                    class="w-full group relative flex items-center gap-4 p-4 border-2 rounded-2xl hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-all duration-200 focus:outline-none theme-btn text-left"
                    data-theme="dark">
                    <div
                        class="w-12 h-12 bg-gray-900 border border-gray-800 rounded-xl flex items-center justify-center shadow-sm text-white">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z">
                            </path>
                        </svg>
                    </div>
                    <div class="flex-grow">
                        <span class="block font-bold text-gray-900 dark:text-white">Mode Gelap</span>
                        <span class="text-xs text-gray-500">Nyaman di mata saat malam</span>
                    </div>
                    <div
                        class="w-6 h-6 rounded-full border-2 border-gray-300 dark:border-gray-600 flex items-center justify-center check-icon">
                        <div class="w-3 h-3 bg-blue-600 rounded-full hidden"></div>
                    </div>
                </button>

                <!-- System Mode -->
                <button onclick="setTheme('system')"
                    class="w-full group relative flex items-center gap-4 p-4 border-2 rounded-2xl hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-all duration-200 focus:outline-none theme-btn text-left"
                    data-theme="system">
                    <div
                        class="w-12 h-12 bg-gradient-to-br from-white to-gray-900 border border-gray-200 rounded-xl flex items-center justify-center shadow-sm text-gray-500">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z">
                            </path>
                        </svg>
                    </div>
                    <div class="flex-grow">
                        <span class="block font-bold text-gray-900 dark:text-white">Ikuti Sistem</span>
                        <span class="text-xs text-gray-500">Sesuaikan dengan perangkat</span>
                    </div>
                    <div
                        class="w-6 h-6 rounded-full border-2 border-gray-300 dark:border-gray-600 flex items-center justify-center check-icon">
                        <div class="w-3 h-3 bg-blue-600 rounded-full hidden"></div>
                    </div>
                </button>
            </div>

            <div class="mt-8 text-center">
                <a href="/portal"
                    class="text-sm font-bold text-gray-400 hover:text-gray-600 dark:hover:text-gray-200">Kembali
                    ke Beranda</a>
            </div>
        </div>
    </div>
</div>

<script>
    function updateActiveButton(theme) {
        document.querySelectorAll('.theme-btn').forEach(btn => {
            btn.classList.remove('border-blue-600', 'bg-blue-50', 'dark:bg-blue-900/10');
            btn.classList.add('border-gray-200', 'dark:border-gray-700');
            btn.querySelector('.check-icon').classList.remove('border-blue-600');
            btn.querySelector('.check-icon').classList.add('border-gray-300', 'dark:border-gray-600');
            btn.querySelector('.check-icon div').classList.add('hidden');
        });

        const activeBtn = document.querySelector(`.theme-btn[data-theme="${theme}"]`);
        if (activeBtn) {
            activeBtn.classList.remove('border-gray-200', 'dark:border-gray-700');
            activeBtn.classList.add('border-blue-600', 'bg-blue-50', 'dark:bg-blue-900/10');
            activeBtn.querySelector('.check-icon').classList.remove('border-gray-300', 'dark:border-gray-600');
            activeBtn.querySelector('.check-icon').classList.add('border-blue-600');
            activeBtn.querySelector('.check-icon div').classList.remove('hidden');
        }
    }

    async function setTheme(t) {
        const dark = (t === 'dark' || (t === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches));
        document.documentElement.classList.toggle('dark', dark);
        localStorage.setItem('theme', t);
        document.cookie = `theme=${t}; path=/; max-age=31536000; SameSite=Lax`;
        updateActiveButton(t);

        try {
            await fetch('/profile/theme', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ theme: t })
            });
        } catch (err) {
            console.error('Failed to sync theme to server:', err);
        }
    }

    const savedTheme = localStorage.getItem('theme') || 'system';
    updateActiveButton(savedTheme);
</script>