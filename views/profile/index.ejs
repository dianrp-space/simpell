<div class="flex items-center justify-center min-h-screen py-10 px-4">
    <!-- Widened Container -->
    <div
        class="bg-white dark:bg-gray-800 rounded-[2rem] shadow-2xl w-full max-w-2xl overflow-hidden border border-gray-100 dark:border-gray-700">
        <!-- Header -->
        <div class="bg-gradient-to-r from-blue-600 to-blue-500 p-8 text-center relative">
            <h1 class="text-2xl font-black text-white tracking-tight">Edit Profil</h1>
            <p class="text-blue-100 text-sm mt-1">Perbarui informasi akun Anda</p>
            <a href="/portal"
                class="absolute top-4 right-4 p-2 bg-white/20 hover:bg-white/30 rounded-xl text-white transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12">
                    </path>
                </svg>
            </a>
        </div>

        <div class="p-8">
            <form action="/profile/settings" method="POST" enctype="multipart/form-data" class="space-y-8">
                <!-- Photo with Obvious Edit Overlay -->
                <div class="flex flex-col items-center -mt-16 mb-6">
                    <div class="relative group">
                        <div class="w-32 h-32 bg-white dark:bg-gray-700 rounded-full flex items-center justify-center border-4 border-white dark:border-gray-800 shadow-xl overflow-hidden relative cursor-pointer"
                            onclick="document.getElementById('foto').click()">
                            <% if (user.foto) { %>
                                <img src="/uploads/profiles/<%= user.foto %>" alt="Profile" id="profile-preview"
                                    class="w-full h-full object-contain">
                                <% } else { %>
                                    <span class="text-4xl font-bold text-blue-600 dark:text-blue-400">
                                        <%= user.nama.charAt(0).toUpperCase() %>
                                    </span>
                                    <% } %>

                                        <!-- Always Visible Overlay Hint -->
                                        <div
                                            class="absolute inset-0 bg-black/30 flex items-center justify-center transition-opacity group-hover:bg-black/50">
                                            <div
                                                class="bg-white/20 backdrop-blur-sm p-2 rounded-full border border-white/50">
                                                <svg class="w-6 h-6 text-white drop-shadow-md" fill="none"
                                                    stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z">
                                                    </path>
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                                </svg>
                                            </div>
                                        </div>
                        </div>
                    </div>
                    <div class="mt-3 flex flex-col items-center">
                        <input type="file" name="foto" id="foto" accept="image/*" class="hidden">
                    </div>
                </div>

                <!-- Messages after Photo to avoid overlap -->
                <% if (success_msg && success_msg.length> 0) { %>
                    <div
                        class="alert-box mb-6 p-4 bg-green-50 dark:bg-green-900/30 border border-green-200 dark:border-green-800 rounded-2xl flex items-center gap-3 text-green-700 dark:text-green-400 animate-in fade-in slide-in-from-top-4 duration-300">
                        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <p class="text-sm font-semibold text-center w-full">
                            <%= success_msg %>
                        </p>
                    </div>
                    <% } %>

                        <% if (error_msg && error_msg.length> 0) { %>
                            <div
                                class="mb-6 p-4 bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 rounded-2xl flex items-center gap-3 text-red-700 dark:text-red-400 animate-in fade-in slide-in-from-top-4 duration-300">
                                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                <p class="text-sm font-semibold text-center w-full">
                                    <%= error_msg %>
                                </p>
                            </div>
                            <% } %>

                                <!-- Fields Grid -->
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <!-- Nama (Editable) -->
                                    <div class="col-span-1 md:col-span-2">
                                        <label
                                            class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-2">Nama
                                            Lengkap</label>
                                        <input type="text" name="nama" value="<%= user.nama %>" required
                                            class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 font-medium text-gray-900 dark:text-white transition-all">
                                    </div>

                                    <!-- Email (Read Only) -->
                                    <div>
                                        <label
                                            class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-2">Email</label>
                                        <div class="relative">
                                            <input type="email" value="<%= user.email %>" disabled
                                                class="w-full px-4 py-3 bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl text-gray-500 dark:text-gray-400 font-medium cursor-not-allowed select-none">
                                            <div
                                                class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                                                <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor"
                                                    viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z">
                                                    </path>
                                                </svg>
                                            </div>
                                        </div>
                                        <p class="mt-1 text-[10px] text-gray-400">Hubungi admin untuk ubah email</p>
                                    </div>

                                    <!-- No HP (Pre-filled Value) -->
                                    <div>
                                        <label
                                            class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-2">Nomor
                                            WhatsApp / HP</label>
                                        <input type="tel" name="no_hp" value="<%= user.no_hp || '' %>"
                                            placeholder="08..."
                                            class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 font-medium text-gray-900 dark:text-white transition-all placeholder-gray-500 dark:placeholder-gray-400">
                                        <p class="mt-1 text-[10px] text-gray-500 dark:text-gray-400">Isi hanya jika
                                            ingin mengubah nomor
                                        </p>
                                    </div>
                                </div>

                                <div class="pt-4">
                                    <button type="submit"
                                        class="w-full py-4 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl shadow-lg shadow-blue-500/30 transition-all active:scale-95 flex items-center justify-center gap-2 text-lg">
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M5 13l4 4L19 7">
                                            </path>
                                        </svg>
                                        Simpan Perubahan
                                    </button>
                                </div>
            </form>

            <div class="mt-8 pt-6 border-t border-gray-100 dark:border-gray-700 space-y-4">
                <!-- Smaller Toggle Button -->
                <button onclick="document.getElementById('password-form').classList.toggle('hidden')"
                    class="w-auto px-6 py-2 mx-auto border border-gray-200 dark:border-gray-700 text-gray-500 dark:text-gray-400 text-sm font-semibold rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors flex items-center justify-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z">
                        </path>
                    </svg>
                    Ganti Password
                </button>

                <div id="password-form"
                    class="hidden space-y-4 bg-gray-50 dark:bg-gray-900/50 p-6 rounded-2xl border border-gray-100 dark:border-gray-700/50">
                    <form action="/profile/password" method="POST" class="space-y-4">
                        <!-- Password Lama -->
                        <div class="relative">
                            <input type="password" name="current_password" id="current_password"
                                placeholder="Password Lama" required
                                class="w-full px-4 py-3 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl focus:ring-2 focus:ring-orange-500 transition-all pr-12 text-gray-900 dark:text-white">
                            <button type="button" onclick="togglePassword('current_password')"
                                class="absolute inset-y-0 right-0 px-4 flex items-center text-gray-400 hover:text-blue-500 transition-colors">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path id="eyeIcon_current_password" stroke-linecap="round" stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z">
                                    </path>
                                </svg>
                            </button>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <!-- Password Baru -->
                            <div class="relative">
                                <input type="password" name="new_password" id="new_password" placeholder="Password Baru"
                                    required minlength="6"
                                    class="w-full px-4 py-3 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl focus:ring-2 focus:ring-orange-500 transition-all pr-12 text-gray-900 dark:text-white">
                                <button type="button" onclick="togglePassword('new_password')"
                                    class="absolute inset-y-0 right-0 px-4 flex items-center text-gray-400 hover:text-blue-500 transition-colors">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path id="eyeIcon_new_password" stroke-linecap="round" stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z">
                                        </path>
                                    </svg>
                                </button>
                            </div>

                            <!-- Konfirmasi Password -->
                            <div class="relative">
                                <input type="password" name="confirm_password" id="confirm_password"
                                    placeholder="Konfirmasi Password" required minlength="6"
                                    class="w-full px-4 py-3 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl focus:ring-2 focus:ring-orange-500 transition-all pr-12 text-gray-900 dark:text-white">
                                <button type="button" onclick="togglePassword('confirm_password')"
                                    class="absolute inset-y-0 right-0 px-4 flex items-center text-gray-400 hover:text-blue-500 transition-colors">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path id="eyeIcon_confirm_password" stroke-linecap="round"
                                            stroke-linejoin="round" stroke-width="2"
                                            d="M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z">
                                        </path>
                                    </svg>
                                </button>
                            </div>
                        </div>
                        <button type="submit"
                            class="w-full py-3 bg-orange-600 hover:bg-orange-700 text-white font-bold rounded-xl shadow-lg shadow-orange-500/20 transition-all active:scale-95">Update
                            Password</button>
                    </form>
                </div>
            </div>

            <div class="mt-8 text-center">
                <a href="/portal"
                    class="text-xs font-bold text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 uppercase tracking-widest transition-colors">Kembali
                    ke Beranda</a>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('foto').addEventListener('change', function (e) {
        if (e.target.files && e.target.files[0]) {
            const reader = new FileReader();
            reader.onload = function (e) {
                let img = document.getElementById('profile-preview');
                if (!img) {
                    const container = document.querySelector('.w-32.h-32');
                    container.innerHTML = `<img src="${e.target.result}" alt="Profile" id="profile-preview" class="w-full h-full object-contain">`;
                } else {
                    img.src = e.target.result;
                }
            }
            reader.readAsDataURL(e.target.files[0]);
        }
    });

    function togglePassword(inputId) {
        const input = document.getElementById(inputId);
        const path = document.getElementById('eyeIcon_' + inputId);

        if (input.type === 'password') {
            input.type = 'text';
            // Show eye-off icon or just change color for now
            input.nextElementSibling.classList.add('text-blue-500');
        } else {
            input.type = 'password';
            input.nextElementSibling.classList.remove('text-blue-500');
        }
    }

    // Auto-hide alerts after 3 seconds
    setTimeout(() => {
        document.querySelectorAll('.alert-box').forEach(alert => {
            alert.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
            alert.style.opacity = '0';
            alert.style.transform = 'translateY(-10px)';
            setTimeout(() => alert.remove(), 500);
        });
    }, 3000);
</script>