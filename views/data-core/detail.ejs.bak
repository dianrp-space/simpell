<!-- Data Core Detail - Jaringan with Sectors -->
<div class="space-y-4 md:space-y-6">
    <!-- Page Header - Mobile First -->
    <div class="flex flex-col gap-4">
        <div class="flex items-start gap-3">
            <a href="/data-core"
                class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:text-white dark:hover:bg-gray-700 rounded-lg transition-colors flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M10 19l-7-7m0 0l7-7m-7 7h18">
                    </path>
                </svg>
            </a>
            <div class="min-w-0 flex-1">
                <h1 class="text-lg md:text-2xl font-bold text-gray-900 dark:text-white truncate">
                    <%= data.nama_lokasi %>
                </h1>
                <p class="text-xs md:text-sm text-gray-500 dark:text-gray-400 font-mono">
                    <%= data.no_jaringan %>
                </p>
            </div>
        </div>
        <div class="flex items-center gap-2 flex-wrap">
            <a href="/data-core/<%= data.id %>/edit"
                class="inline-flex items-center gap-1.5 px-3 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 text-sm font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z">
                    </path>
                </svg>
                <span class="hidden sm:inline">Edit</span>
            </a>
            <form action="/data-core/<%= data.id %>?_method=DELETE" method="POST" class="inline"
                onsubmit="return confirm('Hapus jaringan ini dan semua sectornya?')">
                <button type="submit"
                    class="inline-flex items-center gap-1.5 px-3 py-2 border border-red-300 dark:border-red-600 text-red-600 dark:text-red-400 text-sm font-medium rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                        </path>
                    </svg>
                    <span class="hidden sm:inline">Hapus</span>
                </button>
            </form>
        </div>
    </div>

    <!-- Interactive Map Section (Google Maps Embed) -->
    <% // 1. Filter sectors: Must have lat/lng and not be empty strings const mapSectors=(data.sectors ||
        []).filter(function(s) { return s.latitude && s.longitude && String(s.latitude).trim() !=="" &&
        String(s.longitude).trim() !=="" ; }); let mapsUrl="" ; let centerLat=0; let centerLng=0; if (mapSectors.length>
        0) {
        // A. If multiple points, create a ROUTE
        if (mapSectors.length > 1) {
        // Start point
        var saddr = mapSectors[0].latitude + "," + mapSectors[0].longitude;
        // End point
        var daddr = mapSectors[mapSectors.length - 1].latitude + "," + mapSectors[mapSectors.length - 1].longitude;
        // Waypoints
        var waypoints = "";
        for (var i = 1; i < mapSectors.length - 1; i++) { waypoints +="+to:" + mapSectors[i].latitude + "," +
            mapSectors[i].longitude; } mapsUrl="https://maps.google.com/maps?saddr=" + saddr + "&daddr=" + daddr +
            waypoints + "&output=embed" ; } // B. If single point, just show that point else {
            centerLat=parseFloat(mapSectors[0].latitude); centerLng=parseFloat(mapSectors[0].longitude);
            mapsUrl="https://maps.google.com/maps?q=" + centerLat + "," + centerLng + "&z=15&output=embed" ; } } %>


            <% if (mapSectors.length> 0) { %>
                <div id="mapSection"
                    class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl shadow-sm overflow-hidden mb-6">
                    <div
                        class="px-4 md:px-6 py-3 md:py-4 border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900/50 flex items-center justify-between">
                        <h3
                            class="font-semibold text-gray-900 dark:text-white text-sm md:text-base flex items-center gap-2">
                            <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z">
                                </path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                            <span>Lokasi Jalur Fiber</span>
                        </h3>
                        <button type="button"
                            onclick="document.getElementById('googleMapFrame').classList.toggle('hidden')"
                            class="text-xs px-2 py-1 bg-gray-100 dark:bg-gray-700 rounded hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors">
                            Toggle Map
                        </button>
                    </div>
                    <div id="googleMapFrame" class="relative z-0 h-[400px] w-full bg-gray-100 dark:bg-gray-900">
                        <iframe width="100%" height="100%" frameborder="0" style="border:0" src="<%= mapsUrl %>"
                            allowfullscreen>
                        </iframe>
                    </div>
                    <div
                        class="px-4 py-2 bg-gray-50 dark:bg-gray-800/50 text-xs text-gray-500 text-center border-t border-gray-100 dark:border-gray-700">
                        Menampilkan rute dari <%= mapSectors.length %> titik sector. Klik "Buka di Google Maps"
                            pada kartu sector untuk detail presisi.
                    </div>
                </div>
                <% } else { %>
                    <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-4 mb-6 flex items-start gap-3">
                        <svg class="w-5 h-5 text-yellow-500 mt-0.5" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <div>
                            <h4 class="text-sm font-semibold text-yellow-800">Peta Tidak Muncul</h4>
                            <p class="text-xs text-yellow-700 mt-1">
                                Tidak ditemukan koordinat (Latitude/Longitude) valid pada <%= (data.sectors ||
                                    []).length %>
                                    sector yang ada.
                                    <br>Pastikan Anda sudah menginput Latitude dan Longitude di data Sector.
                            </p>
                        </div>
                    </div>
                    <% } %>

                        <!-- Sectors Section -->
                        <div
                            class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl shadow-sm overflow-hidden">
                            <div
                                class="px-4 md:px-6 py-3 md:py-4 border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900/50 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                                <h3 class="font-semibold text-gray-900 dark:text-white text-sm md:text-base">
                                    Daftar Sector (<%= data.sectors ? data.sectors.length : 0 %>)
                                </h3>
                                <a href="/data-core/<%= data.id %>/sector/create"
                                    class="inline-flex items-center justify-center gap-1.5 px-3 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors w-full sm:w-auto">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M12 4v16m8-8H4"></path>
                                    </svg>
                                    Tambah Sector
                                </a>
                            </div>

                            <% if (!data.sectors || data.sectors.length===0) { %>
                                <div class="px-4 md:px-6 py-10 md:py-12 text-center">
                                    <svg class="w-10 h-10 md:w-12 md:h-12 text-gray-300 dark:text-gray-600 mx-auto mb-4"
                                        fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2">
                                        </path>
                                    </svg>
                                    <p class="text-gray-500 dark:text-gray-400 mb-4 text-sm md:text-base">Belum ada
                                        sector
                                        untuk
                                        jaringan
                                        ini</p>
                                    <a href="/data-core/<%= data.id %>/sector/create"
                                        class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors text-sm md:text-base">
                                        <svg class="w-4 h-4 md:w-5 md:h-5" fill="none" stroke="currentColor"
                                            viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M12 4v16m8-8H4"></path>
                                        </svg>
                                        Tambah Sector Pertama
                                    </a>
                                </div>
                                <% } else { %>
                                    <!-- Sectors Grid - Clean Layout -->
                                    <div class="p-4 md:p-6">
                                        <!-- Zoom Controls -->
                                        <div class="flex items-center gap-2 mb-4">
                                            <span class="text-xs text-gray-500 dark:text-gray-400">Zoom:</span>
                                            <button type="button" onclick="zoomCards(-0.1)"
                                                class="p-1.5 rounded-lg bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-600 dark:text-gray-300 transition-colors"
                                                title="Zoom Out">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor"
                                                    viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2" d="M20 12H4">
                                                    </path>
                                                </svg>
                                            </button>
                                            <span id="zoomLevel"
                                                class="text-xs font-mono text-gray-600 dark:text-gray-300 w-10 text-center">100%</span>
                                            <button type="button" onclick="zoomCards(0.1)"
                                                class="p-1.5 rounded-lg bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-600 dark:text-gray-300 transition-colors"
                                                title="Zoom In">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor"
                                                    viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2" d="M12 4v16m8-8H4"></path>
                                                </svg>
                                            </button>
                                            <button type="button" onclick="resetZoom()"
                                                class="p-1.5 rounded-lg bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-600 dark:text-gray-300 transition-colors text-xs"
                                                title="Reset">
                                                Reset
                                            </button>
                                        </div>

                                        <!-- Horizontal Scrollable Sectors Container -->
                                        <div id="sectorsContainer"
                                            class="flex gap-4 overflow-x-auto pb-4 snap-x snap-mandatory scroll-smooth"
                                            style="transform-origin: left top;">
                                            <% data.sectors.forEach((sector, index)=> { %>
                                                <!-- Sector Card -->
                                                <div class="relative flex-shrink-0 snap-start" style="width: 280px;">
                                                    <div
                                                        class="bg-white dark:bg-slate-700 border-2 border-gray-200 dark:border-slate-600 rounded-xl shadow-sm overflow-hidden hover:shadow-lg hover:border-blue-400 dark:hover:border-blue-500 transition-all duration-200 h-full flex flex-col">
                                                        <!-- Card Header with Number -->
                                                        <div
                                                            class="bg-gradient-to-r from-blue-500 to-indigo-600 dark:from-blue-600 dark:to-indigo-700 px-4 py-3">
                                                            <div class="flex items-center gap-3">
                                                                <div
                                                                    class="flex items-center justify-center w-6 h-6 rounded-full bg-white/20 text-white font-bold text-xs">
                                                                    <%= index + 1 %>
                                                                </div>
                                                                <p class="text-sm font-semibold text-white truncate flex-1"
                                                                    title="<%= sector.nama_sector %>">
                                                                    <%= sector.nama_sector %>
                                                                </p>
                                                            </div>
                                                        </div>
                                                        <!-- Card Body -->
                                                        <div class="p-4 flex-1">
                                                            <% if (sector.keterangan) { %>
                                                                <p
                                                                    class="text-xs text-gray-600 dark:text-slate-300 whitespace-pre-line leading-relaxed">
                                                                    <%= sector.keterangan %>
                                                                </p>
                                                                <% } else { %>
                                                                    <p
                                                                        class="text-xs text-gray-400 dark:text-slate-500 italic">
                                                                        Tidak ada keterangan</p>
                                                                    <% } %>

                                                                        <!-- Koordinat Display -->
                                                                        <% if (sector.latitude && sector.longitude) { %>
                                                                            <div
                                                                                class="mt-3 pt-3 border-t border-gray-100 dark:border-slate-600/50">
                                                                                <div
                                                                                    class="flex items-center gap-2 text-xs text-gray-500 dark:text-slate-400">
                                                                                    <svg class="w-3.5 h-3.5 text-blue-500"
                                                                                        fill="none"
                                                                                        stroke="currentColor"
                                                                                        viewBox="0 0 24 24">
                                                                                        <path stroke-linecap="round"
                                                                                            stroke-linejoin="round"
                                                                                            stroke-width="2"
                                                                                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z">
                                                                                        </path>
                                                                                        <path stroke-linecap="round"
                                                                                            stroke-linejoin="round"
                                                                                            stroke-width="2"
                                                                                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z">
                                                                                        </path>
                                                                                    </svg>
                                                                                    <a href="https://www.google.com/maps?q=<%= sector.latitude %>,<%= sector.longitude %>"
                                                                                        target="_blank"
                                                                                        class="font-mono text-blue-600 dark:text-blue-400 hover:underline"
                                                                                        title="Buka di Google Maps">
                                                                                        <%= sector.latitude %>, <%=
                                                                                                sector.longitude %>
                                                                                    </a>
                                                                                </div>
                                                                            </div>
                                                                            <% } %>
                                                        </div>
                                                        <!-- Card Footer -->
                                                        <div
                                                            class="bg-gray-50 dark:bg-slate-800/50 px-4 py-2.5 flex items-center justify-end gap-2 border-t border-gray-100 dark:border-slate-600/50 mt-auto">
                                                            <a href="/data-core/<%= data.id %>/sector/<%= sector.id %>/edit"
                                                                class="inline-flex items-center gap-1 px-2.5 py-1.5 bg-blue-50 hover:bg-blue-100 dark:bg-blue-900/30 dark:hover:bg-blue-900/50 text-blue-600 dark:text-blue-300 text-xs font-medium rounded transition-colors">
                                                                <svg class="w-3.5 h-3.5" fill="none"
                                                                    stroke="currentColor" viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                                        stroke-width="2"
                                                                        d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z">
                                                                    </path>
                                                                </svg>
                                                                Edit
                                                            </a>
                                                            <form
                                                                action="/data-core/<%= data.id %>/sector/<%= sector.id %>?_method=DELETE"
                                                                method="POST" class="inline"
                                                                onsubmit="return confirm('Hapus sector ini?')">
                                                                <button type="submit"
                                                                    class="inline-flex items-center gap-1 px-2.5 py-1.5 bg-red-50 hover:bg-red-100 dark:bg-red-900/30 dark:hover:bg-red-900/50 text-red-600 dark:text-red-300 text-xs font-medium rounded transition-colors">
                                                                    <svg class="w-3.5 h-3.5" fill="none"
                                                                        stroke="currentColor" viewBox="0 0 24 24">
                                                                        <path stroke-linecap="round"
                                                                            stroke-linejoin="round" stroke-width="2"
                                                                            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                                                                        </path>
                                                                    </svg>
                                                                    Hapus
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                                <% }); %>
                                        </div>
                                    </div>
                                    <% } %>
                        </div>
</div>

<script>
    let currentZoom = 1;
    const minZoom = 0.5;
    const maxZoom = 1.5;

    function zoomCards(delta) {
        currentZoom = Math.max(minZoom, Math.min(maxZoom, currentZoom + delta));
        applyZoom();
    }

    function resetZoom() {
        currentZoom = 1;
        applyZoom();
    }

    function applyZoom() {
        const container = document.getElementById('sectorsContainer');
        const zoomLabel = document.getElementById('zoomLevel');
        if (container) {
            container.style.transform = `scale(${currentZoom})`;
            container.style.width = `${100 / currentZoom}%`;
        }
        if (zoomLabel) {
            zoomLabel.textContent = Math.round(currentZoom * 100) + '%';
        }
    }

    // Map Toggle
    function toggleMapPanel() {
        const panel = document.getElementById('mapPanel');
        const btn = document.getElementById('mapToggleBtn');
        if (panel.classList.contains('hidden')) {
            panel.classList.remove('hidden');
            btn.textContent = 'Sembunyikan';
        } else {
            panel.classList.add('hidden');
            btn.textContent = 'Tampilkan';
        }
    }
</script>