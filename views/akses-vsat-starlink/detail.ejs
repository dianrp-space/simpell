<!-- VSAT Starlink Detail -->
<div class="max-w-2xl mx-auto space-y-6">
    <!-- Page Header -->
    <div class="flex items-center gap-4">
        <a href="javascript:history.back()"
            class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:text-white dark:hover:bg-gray-700 rounded-lg transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18">
                </path>
            </svg>
        </a>
        <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
                Detail VSAT Starlink
            </h1>
            <p class="text-gray-500 dark:text-gray-400">Detail Layanan VSAT Starlink</p>
        </div>
    </div>

    <!-- Form Card -->
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6 shadow-sm">
        <div class="space-y-5">
            <!-- Pelanggan Display -->
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Customer</label>
                <input type="text" disabled
                    value="<%= data && data.pelanggan ? (data.pelanggan.no_jaringan + ' - ' + data.pelanggan.nama_pelanggan) : '-' %>"
                    class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white opacity-70 cursor-not-allowed">
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">SN KIT</label>
                    <input type="text" disabled value="<%= data ? data.sn_kit || '' : '' %>"
                        class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white opacity-70 cursor-not-allowed">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">SN Mikrotik</label>
                    <input type="text" disabled value="<%= data ? data.sn_mikrotik || '' : '' %>"
                        class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white opacity-70 cursor-not-allowed">
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">No Registrasi
                        PSU</label>
                    <input type="text" disabled value="<%= data ? data.no_registrasi_psu || '' : '' %>"
                        class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white opacity-70 cursor-not-allowed">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">No Registrasi
                        KIT</label>
                    <input type="text" disabled value="<%= data ? data.no_registrasi_kit || '' : '' %>"
                        class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white opacity-70 cursor-not-allowed">
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Starlink Type</label>
                <input type="text" disabled value="<%= data ? data.starlink_type || '' : '' %>"
                    class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white opacity-70 cursor-not-allowed">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Web PRTG</label>
                <input type="text" disabled value="<%= data ? data.web_prtg || '' : '' %>"
                    class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white opacity-70 cursor-not-allowed">
            </div>

            <div class="flex gap-3 pt-4 border-t border-gray-200 dark:border-gray-700">
                <a href="javascript:history.back()"
                    class="inline-flex items-center px-5 py-2.5 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                    Kembali
                </a>
                <% if (isEditor && data) { %>
                    <a href="/akses-vsat-starlink/<%= data.id %>/edit"
                        class="inline-flex items-center px-5 py-2.5 bg-amber-500 hover:bg-amber-600 text-white font-medium rounded-lg transition-colors shadow-lg shadow-amber-500/25">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z">
                            </path>
                        </svg>
                        Edit Data
                    </a>
                    <% } %>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="pelanggan_data_json"
    value="<%= (typeof pelangganList !== 'undefined' && pelangganList) ? JSON.stringify(pelangganList) : '[]' %>">

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Pelanggan data from server
        const pelangganDataEl = document.getElementById('pelanggan_data_json');
        const pelangganList = pelangganDataEl ? JSON.parse(pelangganDataEl.value || '[]') : [];

        const searchInput = document.getElementById('pelanggan_search');
        const dropdown = document.getElementById('pelanggan_dropdown');
        // const noJaringanInput = document.getElementById('no_jaringan'); // Removed
        // const namaPelangganInput = document.getElementById('nama_pelanggan'); // Removed
        const pelangganIdInput = document.getElementById('pelanggan_id');
        const selectedContainer = document.getElementById('selected_pelanggan');
        const selectedText = document.getElementById('selected_text');
        const clearButton = document.getElementById('clear_pelanggan');

        // Filter & Show Dropdown
        searchInput.addEventListener('input', function () {
            const query = this.value.toLowerCase();
            dropdown.innerHTML = '';

            if (query.length < 1) {
                dropdown.classList.add('hidden');
                return;
            }

            const filtered = pelangganList.filter(p =>
                (p.no_jaringan && p.no_jaringan.toLowerCase().includes(query)) ||
                (p.nama_pelanggan && p.nama_pelanggan.toLowerCase().includes(query))
            ).slice(0, 10);

            if (filtered.length === 0) {
                dropdown.innerHTML = '<div class="px-4 py-3 text-sm text-gray-500">Tidak ada pelanggan ditemukan</div>';
            } else {
                dropdown.innerHTML = filtered.map(p => `
                    <div class="pelanggan-item px-4 py-3 hover:bg-gray-100 dark:hover:bg-gray-700 cursor-pointer border-b border-gray-100 dark:border-gray-700 last:border-0"
                         data-id="${p.id}" data-no="${p.no_jaringan}" data-nama="${p.nama_pelanggan}">
                        <div class="font-medium text-sm text-gray-900 dark:text-white">${p.no_jaringan}</div>
                        <div class="text-sm text-gray-500 dark:text-gray-400">${p.nama_pelanggan}</div>
                    </div>
                `).join('');
            }
            dropdown.classList.remove('hidden');
        });

        // Select Pelanggan (Event Delegation)
        dropdown.addEventListener('click', function (e) {
            const item = e.target.closest('.pelanggan-item');
            if (item) {
                const id = item.dataset.id;
                const no = item.dataset.no;
                const nama = item.dataset.nama;

                // noJaringanInput.value = no; // Removed
                // namaPelangganInput.value = nama; // Removed
                pelangganIdInput.value = id;

                selectedText.textContent = `${no} - ${nama}`;
                selectedContainer.classList.remove('hidden');

                searchInput.value = '';
                dropdown.classList.add('hidden');
            }
        });

        // Clear Selection
        clearButton.addEventListener('click', function () {
            // noJaringanInput.value = ''; // Removed
            // namaPelangganInput.value = ''; // Removed
            pelangganIdInput.value = '';
            selectedContainer.classList.add('hidden');
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', function (e) {
            if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) {
                dropdown.classList.add('hidden');
            }
        });
    });
</script>