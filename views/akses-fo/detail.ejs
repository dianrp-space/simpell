<!-- Akses FO Node Detail - All OLT Ports -->
<div class="space-y-6">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-4">
            <a href="<%= aksesBase %>"
                class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:text-white dark:hover:bg-gray-700 rounded-lg transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
            </a>
            <div>
                <h1 class="text-xl md:text-2xl font-bold text-gray-900 dark:text-white">Node <%= nodeName %>
                </h1>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                    <%= ports.length %> Port
                </p>
            </div>
        </div>
        <% if (isEditor) { %>
            <a href="<%= aksesBase %>/node/<%= nodeId %>/port/create"
                class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                Tambah Port
            </a>
            <% } %>
    </div>


    <!-- Search Port -->
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm">
        <form action="<%= aksesBase %>/node/<%= nodeId %>" method="GET" class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1">
                <input type="text" id="searchInput" name="search"
                    value="<%= typeof search !== 'undefined' ? search : '' %>"
                    placeholder="Cari customer atau no jaringan..."
                    class="w-full px-4 py-2.5 pl-10 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                <script>
                    const searchInput = document.getElementById('searchInput');
                    let searchTimeout = null;

                    if (searchInput) {
                        searchInput.addEventListener('input', function (e) {
                            clearTimeout(searchTimeout);
                            searchTimeout = setTimeout(() => {
                                if (searchInput.value.length === 0 || searchInput.value.length >= 1) {
                                    searchInput.form.submit();
                                }
                            }, 500);
                        });

                        // Focus input after reload if searching
                        if (window.location.search.includes('search=')) {
                            searchInput.focus();
                            const val = searchInput.value;
                            searchInput.value = '';
                            searchInput.value = val;
                        }
                    }
                </script>
                <div class="absolute left-3 top-1/2 -translate-y-1/2">
                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </div>
            </div>
            <button type="submit"
                class="px-4 py-2.5 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 font-medium rounded-lg hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors">
                Cari
            </button>
            <% if (typeof search !=='undefined' && search) { %>
                <a href="<%= aksesBase %>/node/<%= nodeId %>"
                    class="px-4 py-2.5 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors text-center">
                    Reset
                </a>
                <% } %>
        </form>
    </div>

    <!-- Desktop Table -->
    <div
        class="hidden md:block bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900/50">
            <h3 class="font-semibold text-gray-900 dark:text-white">Daftar Port</h3>
        </div>
        <div class="overflow-auto max-h-[70vh] relative">
            <table class="w-full">
                <thead class="sticky top-0 z-20 shadow-md">
                    <tr>
                        <th
                            class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider bg-blue-600 text-white">
                            Port</th>
                        <th
                            class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider bg-blue-600 text-white">
                            <%= (aksesJenis === 'FO_P2P' || aksesJenis === 'DIRECT_LAN' || aksesJenis === 'FO_XCONNECT') ? 'NODE' : 'SN Modem' %></th>
                        <th
                            class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider bg-blue-600 text-white">
                            No Jaringan</th>
                        <th
                            class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider bg-blue-600 text-white">
                            Customer
                        </th>
                        <th
                            class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider bg-blue-600 text-white">
                            Redaman</th>
                        <th
                            class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider bg-blue-600 text-white">
                            Bandwidth</th>
                        <th
                            class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider bg-blue-600 text-white">
                            Keterangan</th>
                        <th
                            class="px-2 py-3 text-center text-xs font-semibold uppercase tracking-wider w-1 bg-blue-600 text-white">
                            Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                    <% ports.forEach(port=> { %>
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                            <td class="px-4 py-3">
                                <span class="font-mono text-sm font-medium text-gray-900 dark:text-white">
                                    <%= port.port_olt %>
                                </span>
                            </td>
                            <td class="px-4 py-3">
                                <span class="font-mono text-sm text-gray-700 dark:text-gray-300">
                                    <%= port.sn_modem || '-' %>
                                </span>
                            </td>
                            <td class="px-4 py-3 text-gray-700 dark:text-gray-300 text-sm">
                                <%= port.pelanggan ? port.pelanggan.no_jaringan : '-' %>
                            </td>
                            <td class="px-4 py-3">
                                <span class="font-medium text-sm text-gray-900 dark:text-white">
                                    <%= port.pelanggan ? port.pelanggan.nama_pelanggan : '-' %>
                                </span>
                            </td>
                            <td class="px-4 py-3">
                                <% if (port.redaman_value) { %>
                                    <div>
                                        <span class="font-medium text-sm text-gray-900 dark:text-white">
                                            <%= port.redaman_value %> dB
                                        </span>
                                        <% if (port.redaman_date) { %>
                                            <p class="text-xs text-gray-500">
                                                <%= new Date(port.redaman_date).toLocaleDateString('id-ID') %>
                                            </p>
                                            <% } %>
                                    </div>
                                    <% } else { %>
                                        <span class="text-gray-400">-</span>
                                        <% } %>
                            </td>
                            <td class="px-4 py-3">
                                <% if (port.bandwidth) { %>
                                    <span
                                        class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-400">
                                        <%= port.bandwidth %>
                                    </span>
                                    <% } else { %>
                                        <span class="text-gray-400">-</span>
                                        <% } %>
                            </td>
                            <td class="px-4 py-3 text-sm text-gray-700 dark:text-gray-300 align-top min-w-[200px]">
                                <%- formatText(port.keterangan) %>
                            </td>
                            <td class="px-2 py-3 w-1">
                                <div class="flex items-center justify-center gap-1">
                                    <% if (isEditor) { %>
                                        <a href="<%= aksesBase %>/<%= port.id %>/edit"
                                            class="p-1.5 text-amber-600 hover:bg-amber-50 dark:hover:bg-amber-900/20 rounded-lg transition-colors"
                                            title="Edit">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z">
                                                </path>
                                            </svg>
                                        </a>
                                        <form action="<%= aksesBase %>/<%= port.id %>?_method=DELETE" method="POST"
                                            class="inline" onsubmit="return confirmSubmit(this, 'Hapus port ini?')">
                                            <button type="submit"
                                                class="p-1.5 text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-lg transition-colors"
                                                title="Hapus">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor"
                                                    viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                                                    </path>
                                                </svg>
                                            </button>
                                        </form>
                                        <% } else { %>
                                            <span class="text-gray-400 text-xs text-center">-</span>
                                            <% } %>
                                </div>
                            </td>
                        </tr>
                        <% }); %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Mobile Card Layout -->
    <div class="md:hidden space-y-3">
        <div
            class="px-2 py-2 bg-gray-50 dark:bg-gray-900/50 rounded-t-xl border-b border-gray-200 dark:border-gray-700">
            <h3 class="font-semibold text-gray-900 dark:text-white">Daftar Port (<%= ports.length %>)</h3>
        </div>
        <% ports.forEach(port=> { %>
            <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm">
                <div class="flex items-start justify-between mb-3">
                    <div>
                        <span class="font-mono text-sm font-bold text-blue-600 dark:text-blue-400">
                            <%= port.port_olt %>
                        </span>
                        <% if (port.bandwidth) { %>
                            <span
                                class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-400">
                                <%= port.bandwidth %>
                            </span>
                            <% } %>
                    </div>
                    <% if (isEditor) { %>
                        <div class="flex items-center gap-1">
                            <a href="<%= aksesBase %>/<%= port.id %>/edit" class="p-1.5 text-amber-600 hover:text-amber-700"
                                title="Edit">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z">
                                    </path>
                                </svg>
                            </a>
                            <form action="<%= aksesBase %>/<%= port.id %>?_method=DELETE" method="POST" class="inline"
                                onsubmit="return confirmSubmit(this, 'Hapus?')">
                                <button type="submit" class="p-1.5 text-red-600 hover:text-red-700" title="Hapus">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M6 18L18 6M6 6l12 12"></path>
                                    </svg>
                                </button>
                            </form>
                        </div>
                        <% } %>
                </div>

                <div class="space-y-2 text-sm">
                    <% if (port.pelanggan && port.pelanggan.nama_pelanggan) { %>
                        <div class="flex items-start gap-2">
                            <svg class="w-4 h-4 text-gray-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor"
                                viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                            </svg>
                            <span class="font-medium text-gray-900 dark:text-white">
                                <%= port.pelanggan.nama_pelanggan %>
                            </span>
                        </div>
                        <% } %>

                            <% if (port.sn_modem) { %>
                                <div class="flex items-start gap-2">
                                    <svg class="w-4 h-4 text-gray-400 mt-0.5 flex-shrink-0" fill="none"
                                        stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z">
                                        </path>
                                    </svg>
                                    <span class="font-mono text-xs text-gray-600 dark:text-gray-400">
                                        <%= port.sn_modem %>
                                    </span>
                                </div>
                                <% } %>

                                    <% if (port.pelanggan && port.pelanggan.no_jaringan) { %>
                                        <div class="flex items-start gap-2">
                                            <svg class="w-4 h-4 text-gray-400 mt-0.5 flex-shrink-0" fill="none"
                                                stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"></path>
                                            </svg>
                                            <span class="text-gray-600 dark:text-gray-400">
                                                <%= port.pelanggan.no_jaringan %>
                                            </span>
                                        </div>
                                        <% } %>

                                            <% if (port.redaman_value) { %>
                                                <div class="flex items-start gap-2">
                                                    <svg class="w-4 h-4 text-gray-400 mt-0.5 flex-shrink-0" fill="none"
                                                        stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                                                    </svg>
                                                    <div>
                                                        <span class="font-medium text-gray-900 dark:text-white">
                                                            <%= port.redaman_value %> dB
                                                        </span>
                                                        <% if (port.redaman_date) { %>
                                                            <span class="text-xs text-gray-500 ml-1">(<%= new
                                                                    Date(port.redaman_date).toLocaleDateString('id-ID')
                                                                    %>)</span>
                                                            <% } %>
                                                    </div>
                                                </div>
                                                <% } %>

                                                    <% if (port.keterangan) { %>
                                                        <div
                                                            class="mt-2 pt-2 border-t border-gray-100 dark:border-gray-700">
                                                            <p class="text-sm text-gray-700 dark:text-gray-300 italic">
                                                                <%- formatText(port.keterangan) %>
                                                            </p>
                                                        </div>
                                                        <% } %>
                </div>
            </div>
            <% }); %>
    </div>
</div>