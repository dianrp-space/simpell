<!-- Port OLT Form -->
<div class="max-w-2xl mx-auto space-y-6">
    <!-- Page Header -->
    <div class="flex items-center gap-4">
        <a href="<%= aksesBase %>/node/<%= nodeId %>"
            class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:text-white dark:hover:bg-gray-700 rounded-lg transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18">
                </path>
            </svg>
        </a>
        <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
                <%= data ? 'Edit' : 'Tambah' %> Port
            </h1>
            <p class="text-gray-500 dark:text-gray-400">Node: <span
                    class="font-mono font-bold text-blue-600 dark:text-blue-400">
                    <%= nodeName %>
                </span></p>
        </div>
    </div>

    <!-- Form Card -->
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6 shadow-sm">
        <form
            action="<%= data ? aksesBase + '/' + data.id + '?_method=PUT' + (typeof returnUrl !== 'undefined' && returnUrl ? '&return_url=' + encodeURIComponent(returnUrl) : '') : aksesBase + '/node/' + nodeId + '/port' %>"
            method="POST" class="space-y-5">

            <!-- Port OLT -->
            <div>
                <label for="port_olt" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                    Port <span class="text-red-500">*</span>
                </label>
                <input type="text" id="port_olt" name="port_olt" required value="<%= data ? data.port_olt : '' %>"
                    class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all font-mono"
                    placeholder="1/1/1">
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label for="sn_modem" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">SN
                        Modem</label>
                    <input type="text" id="sn_modem" name="sn_modem" value="<%= data ? data.sn_modem || '' : '' %>"
                        class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all font-mono"
                        placeholder="SerialNumber">
                </div>
                <div>
                    <label for="pelanggan_select"
                        class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Customer
                        <span class="text-blue-500 text-xs">(Cari & Pilih)</span></label>
                    <div class="relative">
                        <input type="text" id="pelanggan_search" placeholder="Cari No Jaringan / Customer..."
                            autocomplete="off"
                            class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all">
                        <!-- Hidden inputs `no_jaringan` & `nama_pelanggan` removed -->
                        <input type="hidden" id="pelanggan_id" name="pelanggan_id"
                            value="<%= data ? data.pelanggan_id || '' : '' %>">

                        <!-- Dropdown Results -->
                        <div id="pelanggan_dropdown"
                            class="absolute z-50 w-full mt-1 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-xl shadow-lg max-h-60 overflow-y-auto hidden">
                        </div>
                    </div>
                    <!-- Selected Pelanggan Display -->
                    <div id="selected_pelanggan" class="mt-2 <%= data && data.pelanggan_id ? '' : 'hidden' %>">
                        <div
                            class="flex items-center gap-2 p-2 bg-blue-50 dark:bg-blue-900/30 border border-blue-200 dark:border-blue-700 rounded-lg">
                            <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z">
                                </path>
                            </svg>
                            <span id="selected_text" class="text-sm text-blue-700 dark:text-blue-300">
                                <% if (data && data.pelanggan) { %>
                                    <%= data.pelanggan.no_jaringan %> - <%= data.pelanggan.nama_pelanggan %>
                                            <% } %>
                            </span>
                            <button type="button" id="clear_pelanggan"
                                class="ml-auto text-blue-500 hover:text-blue-700">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M6 18L18 6M6 6l12 12"></path>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Removed redundant Nama Pelanggan input -->

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label for="redaman_value"
                        class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Update Redaman
                        (dB)</label>
                    <input type="number" step="0.01" id="redaman_value" name="redaman_value"
                        value="<%= data ? data.redaman_value || '' : '' %>"
                        class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                        placeholder="-20.5">
                </div>
                <div>
                    <label for="redaman_date"
                        class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Tanggal Redaman</label>
                    <input type="date" id="redaman_date" name="redaman_date"
                        value="<%= data && data.redaman_date ? new Date(data.redaman_date).toISOString().split('T')[0] : '' %>"
                        class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all">
                </div>
            </div>

            <div>
                <label for="bandwidth"
                    class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Bandwidth</label>
                <input type="text" id="bandwidth" name="bandwidth" value="<%= data ? data.bandwidth || '' : '' %>"
                    class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                    placeholder="Contoh: 100 Mbps">
            </div>

            <div>
                <label for="keterangan"
                    class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Keterangan</label>
                <textarea id="keterangan" name="keterangan" rows="3"
                    class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                    placeholder="Catatan tambahan..."><%= data ? data.keterangan || '' : '' %></textarea>
            </div>

            <div class="flex gap-3 pt-4 border-t border-gray-200 dark:border-gray-700">
                <button type="submit"
                    class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white font-medium rounded-lg shadow-lg shadow-blue-500/25 transition-all">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    <%= data ? 'Simpan Perubahan' : 'Simpan' %>
                </button>
                <a href="<%= (typeof returnUrl !== 'undefined' && returnUrl) ? returnUrl : aksesBase + '/node/' + nodeId %>"
                    class="inline-flex items-center px-5 py-2.5 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                    Batal
                </a>
            </div>
        </form>
    </div>
</div>

<input type="hidden" id="pelanggan_data_json"
    value="<%= (typeof pelangganList !== 'undefined' && pelangganList) ? JSON.stringify(pelangganList) : '[]' %>">

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Pelanggan data from server
        const pelangganDataEl = document.getElementById('pelanggan_data_json');
        const pelangganList = pelangganDataEl ? JSON.parse(pelangganDataEl.value || '[]') : [];

        const searchInput = document.getElementById('pelanggan_search');
        const dropdown = document.getElementById('pelanggan_dropdown');
        // const noJaringanInput = document.getElementById('no_jaringan'); // Removed
        // const namaPelangganInput = document.getElementById('nama_pelanggan'); // Removed
        const pelangganIdInput = document.getElementById('pelanggan_id');
        const selectedContainer = document.getElementById('selected_pelanggan');
        const selectedText = document.getElementById('selected_text');
        const clearButton = document.getElementById('clear_pelanggan');

        // Filter & Show Dropdown
        searchInput.addEventListener('input', function () {
            const query = this.value.toLowerCase();
            dropdown.innerHTML = '';

            if (query.length < 1) {
                dropdown.classList.add('hidden');
                return;
            }

            const filtered = pelangganList.filter(p =>
                (p.no_jaringan && p.no_jaringan.toLowerCase().includes(query)) ||
                (p.nama_pelanggan && p.nama_pelanggan.toLowerCase().includes(query))
            ).slice(0, 10);

            if (filtered.length === 0) {
                dropdown.innerHTML = '<div class="px-4 py-3 text-sm text-gray-500">Tidak ada pelanggan ditemukan</div>';
            } else {
                dropdown.innerHTML = filtered.map(p => `
                    <div class="pelanggan-item px-4 py-3 hover:bg-gray-100 dark:hover:bg-gray-700 cursor-pointer border-b border-gray-100 dark:border-gray-700 last:border-0"
                         data-id="${p.id}" data-no="${p.no_jaringan}" data-nama="${p.nama_pelanggan}">
                        <div class="font-medium text-sm text-gray-900 dark:text-white">${p.no_jaringan}</div>
                        <div class="text-sm text-gray-500 dark:text-gray-400">${p.nama_pelanggan}</div>
                    </div>
                `).join('');
            }
            dropdown.classList.remove('hidden');
        });

        // Select Pelanggan (Event Delegation)
        dropdown.addEventListener('click', function (e) {
            const item = e.target.closest('.pelanggan-item');
            if (item) {
                const id = item.dataset.id;
                const no = item.dataset.no;
                const nama = item.dataset.nama;

                // noJaringanInput.value = no; // Removed
                // namaPelangganInput.value = nama; // Removed
                pelangganIdInput.value = id;

                selectedText.textContent = `${no} - ${nama}`;
                selectedContainer.classList.remove('hidden');

                searchInput.value = '';
                dropdown.classList.add('hidden');
            }
        });

        // Clear Selection
        clearButton.addEventListener('click', function () {
            // noJaringanInput.value = ''; // Removed
            // namaPelangganInput.value = ''; // Removed
            pelangganIdInput.value = '';
            selectedContainer.classList.add('hidden');
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', function (e) {
            if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) {
                dropdown.classList.add('hidden');
            }
        });
    });
</script>