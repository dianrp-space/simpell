<!-- Access FO Port Detail -->
<div class="max-w-2xl mx-auto space-y-6">
    <!-- Page Header -->
    <div class="flex items-center gap-4">
        <a href="javascript:history.back()"
            class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:text-white dark:hover:bg-gray-700 rounded-lg transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18">
                </path>
            </svg>
        </a>
        <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
                Detail Port OLT
            </h1>
            <p class="text-gray-500 dark:text-gray-400">Node: <span
                    class="font-mono font-bold text-blue-600 dark:text-blue-400">
                    <%= data && data.nodeInfo ? data.nodeInfo.node : (nodeName || '-' ) %>
                </span></p>
        </div>
    </div>

    <!-- Form Card -->
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6 shadow-sm">
        <div class="space-y-5">
            <!-- Port OLT -->
            <div>
                <label class="block text-sm font-medium text-gray-500 dark:text-gray-400 mb-1">
                    Port
                </label>
                <div
                    class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900/50 border border-gray-100 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white font-mono font-medium">
                    <%= data ? data.port_olt : '-' %>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-500 dark:text-gray-400 mb-1"><%= (aksesJenis === 'FO_P2P' || aksesJenis === 'DIRECT_LAN' || aksesJenis === 'FO_XCONNECT') ? 'NODE' : 'SN Modem' %></label>
                    <div
                        class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900/50 border border-gray-100 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white font-mono">
                        <%= data ? data.sn_modem || '-' : '-' %>
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-500 dark:text-gray-400 mb-1">Customer</label>
                    <div
                        class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900/50 border border-gray-100 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white">
                        <%= data && data.pelanggan ? (data.pelanggan.no_jaringan + ' - ' +
                            data.pelanggan.nama_pelanggan) : '-' %>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-500 dark:text-gray-400 mb-1">Redaman (dB)</label>
                    <div
                        class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900/50 border border-gray-100 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white">
                        <%= data ? data.redaman_value || '-' : '-' %>
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-500 dark:text-gray-400 mb-1">Tanggal
                        Redaman</label>
                    <div
                        class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900/50 border border-gray-100 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white">
                        <%= data && data.redaman_date ? new Date(data.redaman_date).toLocaleDateString('id-ID', {
                            day: 'numeric' , month: 'long' , year: 'numeric' }) : '-' %>
                    </div>
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-500 dark:text-gray-400 mb-1">Bandwidth</label>
                <div
                    class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900/50 border border-gray-100 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white">
                    <%= data ? data.bandwidth || '-' : '-' %>
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-500 dark:text-gray-400 mb-1">Keterangan</label>
                <div
                    class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900/50 border border-gray-100 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white whitespace-pre-wrap">
                    <%= data ? data.keterangan || '-' : '-' %>
                </div>
            </div>

            <div class="flex gap-3 pt-4 border-t border-gray-200 dark:border-gray-700">
                <a href="javascript:history.back()"
                    class="inline-flex items-center px-5 py-2.5 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                    Kembali
                </a>
                <% if (isEditor && data) { %>
                    <a href="<%= aksesBase %>/<%= data.id %>/edit"
                        class="inline-flex items-center px-5 py-2.5 bg-amber-500 hover:bg-amber-600 text-white font-medium rounded-lg transition-colors shadow-lg shadow-amber-500/25">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z">
                            </path>
                        </svg>
                        Edit Data
                    </a>
                    <% } %>
            </div>
        </div>
    </div>
</div>