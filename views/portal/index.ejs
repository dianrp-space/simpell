<audio id="batamAudio" loop>
    <source src="/sounds/bg_music.mp3" type="audio/mpeg">
</audio>

<script>
    // Easter Egg Logic (Ctrl + A + L)
    const batamKeys = {};
    const batamModal = document.getElementById('batamModal');
    const batamModalContent = document.getElementById('batamModalContent');
    const batamAudio = document.getElementById('batamAudio');
    let easterSlideInterval = null;

    // Preload audio
    if (batamAudio) batamAudio.load();

    document.addEventListener('keydown', (e) => {
        // Only trigger if no other inputs are focused
        if (['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName)) return;

        const key = e.key.toLowerCase();

        if (e.ctrlKey) {
            if (['a', 'l'].includes(key)) {
                e.preventDefault();
                batamKeys[key] = true;
            }

            // Check if both 'a' and 'l' are pressed while Ctrl is held
            if (batamKeys['a'] && batamKeys['l']) {
                openBatamModal();
                // Reset keys to prevent multiple triggers
                batamKeys['a'] = false;
                batamKeys['l'] = false;
            }
        }
    });

    document.addEventListener('keyup', (e) => {
        const key = e.key.toLowerCase();
        if (['a', 'l'].includes(key)) {
            batamKeys[key] = false;
        }
        // Also reset on Ctrl release just in case
        if (key === 'control') {
            batamKeys['a'] = false;
            batamKeys['l'] = false;
        }
    });

    function startEasterSlideshow() {
        const slides = document.querySelectorAll('.easter-slide');
        if (slides.length < 2) return;
        let current = 0;
        // Reset to first slide
        slides.forEach((s, i) => s.classList.toggle('opacity-0', i !== 0));
        slides[0].classList.remove('opacity-0');

        easterSlideInterval = setInterval(() => {
            slides[current].classList.add('opacity-0');
            current = (current + 1) % slides.length;
            slides[current].classList.remove('opacity-0');
        }, 4000);
    }

    function stopEasterSlideshow() {
        if (easterSlideInterval) {
            clearInterval(easterSlideInterval);
            easterSlideInterval = null;
        }
    }

    function openBatamModal() {
        if (!batamModal.classList.contains('hidden')) return; // Already open

        // Hide Navbar to prevent overlap
        const navbar = document.querySelector('nav');
        if (navbar) navbar.style.display = 'none';

        batamModal.classList.remove('hidden');

        // Trigger reflow
        void batamModal.offsetWidth;

        // Animate in
        requestAnimationFrame(() => {
            batamModalContent.classList.remove('scale-95', 'opacity-0');
            batamModalContent.classList.add('scale-100', 'opacity-100');
        });

        // Start photo slideshow
        startEasterSlideshow();

        // Play Music with fade in
        if (batamAudio) {
            batamAudio.currentTime = 0;
            batamAudio.volume = 0;
            const playPromise = batamAudio.play();

            if (playPromise !== undefined) {
                playPromise.then(_ => {
                    // Fade in
                    let vol = 0;
                    const interval = setInterval(() => {
                        if (vol < 0.5) {
                            vol += 0.05;
                            batamAudio.volume = vol;
                        } else {
                            clearInterval(interval);
                        }
                    }, 100);
                })
                    .catch(error => {
                        console.log("Audio autoplay blocked by browser policy:", error);
                    });
            }
        }
    }

    function closeBatamModal() {
        // Stop slideshow
        stopEasterSlideshow();

        // Animate out
        batamModalContent.classList.remove('scale-100', 'opacity-100');
        batamModalContent.classList.add('scale-95', 'opacity-0');

        // Fade out music
        if (batamAudio) {
            let vol = batamAudio.volume;
            const interval = setInterval(() => {
                if (vol > 0.05) {
                    vol -= 0.05;
                    batamAudio.volume = vol;
                } else {
                    clearInterval(interval);
                    batamAudio.pause();
                    batamAudio.currentTime = 0;
                }
            }, 50);
        }

        setTimeout(() => {
            batamModal.classList.add('hidden');
            // Restore Navbar
            const navbar = document.querySelector('nav');
            if (navbar) navbar.style.display = '';
        }, 300); // 300ms matches transition duration (if set, else 500ms from class)
    }

    // Close on click background
    batamModal.addEventListener('click', (e) => {
        // Check if identified as the backdrop wrapper
        if (e.target.closest('#batamModalContent') === null) {
            closeBatamModal();
        }
    });
</script>

