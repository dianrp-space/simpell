<div class="space-y-6">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
                <%= title %>
            </h1>
            <p class="text-gray-500 dark:text-gray-400">
                Memantau aktivitas user di platform SIMPELL.
            </p>
        </div>
    </div>

    <!-- Filters -->
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm">
        <form id="filterForm" action="/activity-log" method="GET" class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1">
                <input type="text" name="search" id="search" value="<%= query.search || '' %>"
                    placeholder="Cari User/Deskripsi..."
                    class="w-full px-4 py-2.5 pl-10 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                <div class="absolute left-3 top-1/2 -translate-y-1/2">
                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </div>
            </div>
            <div class="w-full sm:w-auto">
                <select name="action" id="action"
                    class="w-full sm:w-auto px-4 py-2.5 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent cursor-pointer">
                    <option value="">Semua Aksi</option>
                    <% actions.forEach(action=> { %>
                        <option value="<%= action %>" <%=query.action===action ? 'selected' : '' %>><%= action %>
                        </option>
                        <% }); %>
                </select>
            </div>
            <button type="submit"
                class="inline-flex items-center justify-center px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg shadow-lg shadow-blue-500/25 transition-all transform hover:scale-[1.02]">
                Cari
            </button>
        </form>
    </div>

    <!-- Table -->
    <div
        class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl shadow-sm overflow-hidden">
        <div id="logsTableContainer" class="overflow-auto max-h-[80vh] relative">
            <table class="w-full">
                <thead
                    class="sticky top-0 z-50 bg-gray-50 dark:bg-gray-900 border-b border-gray-200 dark:border-gray-700 shadow-sm">
                    <tr>
                        <th scope="col"
                            class="px-6 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider sticky left-0 z-30 bg-gray-50 dark:bg-gray-900 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.1)]">
                            Waktu</th>
                        <th scope="col"
                            class="px-6 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider">
                            User</th>
                        <th scope="col"
                            class="px-6 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider">
                            Aksi</th>
                        <th scope="col"
                            class="px-6 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider">
                            Deskripsi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                    <% if (logs.length> 0) { %>
                        <% logs.forEach(log=> { %>
                            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                                <td
                                    class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-white sticky left-0 z-20 bg-white dark:bg-gray-800 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.1)]">
                                    <%= moment(log.timestamp).format('DD MMM YYYY, HH:mm:ss') %>
                                </td>
                                <td
                                    class="px-6 py-4 text-sm font-medium text-gray-900 dark:text-white whitespace-nowrap">
                                    <%= log.user %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span
                                        class="px-2 py-0.5 text-[11px] font-bold bg-gray-100 text-gray-700 rounded dark:bg-gray-700 dark:text-gray-300 uppercase">
                                        <%= log.action %>
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-sm text-gray-600 dark:text-gray-400 min-w-[300px]">
                                    <%= log.description || '-' %>
                                </td>
                            </tr>
                            <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="4" class="px-6 py-12 text-center">
                                            <p class="text-gray-500 dark:text-gray-400">Tidak ada log aktivitas</p>
                                        </td>
                                    </tr>
                                    <% } %>
                </tbody>
            </table>
            <%- include('../partials/pagination') %>
        </div>
    </div>
</div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('search');
        const actionSelect = document.getElementById('action');
        const form = document.getElementById('filterForm');
        const tableContainer = document.getElementById('logsTableContainer');
        let debounceTimer;

        function fetchLogs() {
            const formData = new FormData(form);
            const searchParams = new URLSearchParams(formData);

            fetch(`/activity-log?${searchParams.toString()}`)
                .then(response => response.text())
                .then(html => {
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    const newTableContainer = doc.getElementById('logsTableContainer');
                    if (newTableContainer) {
                        tableContainer.innerHTML = newTableContainer.innerHTML;
                    }
                })
                .catch(error => console.error('Error fetching logs:', error));
        }

        searchInput.addEventListener('input', function () {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => {
                fetchLogs();
            }, 300);
        });

        actionSelect.addEventListener('change', function () {
            fetchLogs();
        });

        form.addEventListener('submit', function (e) {
            e.preventDefault();
            fetchLogs();
        });
    });
</script>