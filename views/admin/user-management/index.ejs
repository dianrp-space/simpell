<div class="container mx-auto px-4 py-2">
    <div class="mb-3 flex justify-between items-start">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Management User</h1>
            <p class="text-gray-600 dark:text-gray-400">Kelola permintaan akun dan data pengguna.</p>
        </div>
        <div class="flex items-center gap-2">
        <% if (locals.isAdmin) { %>
            <%- include('../../partials/notif-bell') %>
        <% } %>
        <a href="/portal"
            class="flex items-center gap-2 px-3 py-2 text-sm text-red-600 bg-red-50 hover:bg-red-100 hover:text-red-700 dark:text-red-400 dark:bg-red-900/10 dark:hover:bg-red-900/20 dark:hover:text-red-300 rounded-lg transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6">
                </path>
            </svg>
            Home
        </a>
        </div>
    </div>

    <!-- Tabs -->
    <div class="mb-3 border-b border-gray-200 dark:border-gray-700">
        <ul class="flex flex-wrap -mb-px text-sm font-medium text-center" id="myTab" data-tabs-toggle="#myTabContent"
            role="tablist">
            <li class="mr-2" role="presentation">
                <button
                    class="inline-block p-4 border-b-2 rounded-t-lg hover:text-gray-600 hover:border-gray-300 dark:hover:text-gray-300"
                    id="requests-tab" data-tabs-target="#requests" type="button" role="tab" aria-controls="requests"
                    aria-selected="false">Request Pembuatan Akun</button>
            </li>
            <li class="mr-2" role="presentation">
                <button
                    class="inline-block p-4 border-b-2 rounded-t-lg hover:text-gray-600 hover:border-border-300 dark:hover:text-gray-300"
                    id="resets-tab" data-tabs-target="#resets" type="button" role="tab" aria-controls="resets"
                    aria-selected="false">Request Reset Password</button>
            </li>
            <li class="mr-2" role="presentation">
                <button
                    class="inline-block p-4 border-b-2 rounded-t-lg hover:text-gray-600 hover:border-gray-300 dark:hover:text-gray-300"
                    id="accounts-tab" data-tabs-target="#accounts" type="button" role="tab" aria-controls="accounts"
                    aria-selected="false">Management Akun</button>
            </li>
        </ul>
    </div>

    <div id="myTabContent">
        <!-- Requests Tab -->
        <div class="hidden p-2 rounded-lg bg-gray-50 dark:bg-gray-800" id="requests" role="tabpanel"
            aria-labelledby="requests-tab">
            <h2 class="text-base font-semibold mb-3 text-gray-900 dark:text-white">Daftar Permintaan Akun</h2>
            <!-- Table -->
            <div class="relative overflow-x-auto overflow-y-auto shadow-md sm:rounded-lg max-h-[530px]">
                <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
                    <thead
                        class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400 sticky top-0 z-30">
                        <tr>
                            <th scope="col"
                                class="px-6 py-3 sticky left-0 z-30 bg-gray-50 dark:bg-gray-700 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.1)]">
                                Nama</th>
                            <th scope="col" class="px-6 py-3 whitespace-nowrap">Email</th>
                            <th scope="col" class="px-6 py-3 whitespace-nowrap">Status</th>
                            <th scope="col"
                                class="px-6 py-3 sticky right-0 z-30 bg-gray-50 dark:bg-gray-700 text-center shadow-[-2px_0_5px_-2px_rgba(0,0,0,0.1)]">
                                Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (pendingUsers.length> 0) { %>
                            <% pendingUsers.forEach(user=> { %>
                                <tr
                                    class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600">
                                    <td
                                        class="px-6 py-2 font-medium text-gray-900 dark:text-white sticky left-0 z-20 bg-white dark:bg-gray-800 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.1)]">
                                        <div class="flex items-center space-x-3 whitespace-nowrap">
                                            <div
                                                class="w-8 h-8 rounded-full bg-yellow-100 flex items-center justify-center text-yellow-600 font-bold text-xs ring-2 ring-white">
                                                <%= user.nama.charAt(0).toUpperCase() %>
                                            </div>
                                            <div>
                                                <div class="font-semibold">
                                                    <%= user.nama %>
                                                </div>
                                                <div class="text-xs text-gray-500">Requesting Access</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-2 whitespace-nowrap">
                                        <%= user.email %>
                                    </td>
                                    <td class="px-6 py-2 whitespace-nowrap">
                                        <% if (!user.is_verified) { %>
                                            <span
                                                class="bg-yellow-100 text-yellow-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-yellow-900 dark:text-yellow-300">Unverified</span>
                                            <% } %>
                                                <% if (!user.is_active) { %>
                                                    <span
                                                        class="bg-red-100 text-red-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-red-900 dark:text-red-300 ml-1">Inactive</span>
                                                    <% } %>
                                    </td>
                                    <td
                                        class="px-6 py-2 sticky right-0 z-20 bg-white dark:bg-gray-800 shadow-[-2px_0_5px_-2px_rgba(0,0,0,0.1)] text-center">
                                        <button data-modal-target="approveModal-<%= user.id %>"
                                            data-modal-toggle="approveModal-<%= user.id %>"
                                            class="px-4 py-1.5 text-xs font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors shadow-sm">
                                            Approve
                                        </button>
                                    </td>
                                </tr>
                                <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="4" class="px-6 py-4 text-center">Tidak ada request baru</td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Resets Tab -->
        <div class="hidden p-2 rounded-lg bg-gray-50 dark:bg-gray-800" id="resets" role="tabpanel"
            aria-labelledby="resets-tab">
            <h2 class="text-base font-semibold mb-3 text-gray-900 dark:text-white">Daftar Permintaan Reset Password</h2>
            <div class="relative overflow-x-auto overflow-y-auto shadow-md sm:rounded-lg max-h-[530px]">
                <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
                    <thead
                        class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400 sticky top-0 z-30">
                        <tr>
                            <th scope="col"
                                class="px-6 py-3 sticky left-0 z-30 bg-gray-50 dark:bg-gray-700 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.1)]">
                                Nama</th>
                            <th scope="col" class="px-6 py-3 whitespace-nowrap">Email</th>
                            <th scope="col" class="px-6 py-3 whitespace-nowrap">Waktu Request</th>
                            <th scope="col"
                                class="px-6 py-3 sticky right-0 z-30 bg-gray-50 dark:bg-gray-700 text-center shadow-[-2px_0_5px_-2px_rgba(0,0,0,0.1)]">
                                Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (typeof resetRequests !=='undefined' && resetRequests.length> 0) { %>
                            <% resetRequests.forEach(reqObj=> { %>
                                <tr
                                    class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600">
                                    <td
                                        class="px-6 py-2 font-medium text-gray-900 dark:text-white sticky left-0 z-20 bg-white dark:bg-gray-800 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.1)]">
                                        <%= reqObj.user.nama %>
                                    </td>
                                    <td class="px-6 py-2 whitespace-nowrap">
                                        <%= reqObj.user.email %>
                                    </td>
                                    <td class="px-6 py-2 whitespace-nowrap text-xs">
                                        <% const d=new Date(reqObj.createdAt); const
                                            dateStr=d.toLocaleDateString('id-ID', { day: '2-digit' , month: 'short' ,
                                            year: 'numeric' }); const timeStr=d.toLocaleTimeString('id-ID', {
                                            hour: '2-digit' , minute: '2-digit' }); %>
                                            <%= dateStr %>
                                                <%= timeStr %>
                                    </td>
                                    <td
                                        class="px-6 py-2 sticky right-0 z-20 bg-white dark:bg-gray-800 shadow-[-2px_0_5px_-2px_rgba(0,0,0,0.1)] text-center">
                                        <button data-modal-target="approveResetModal-<%= reqObj.id %>"
                                            data-modal-toggle="approveResetModal-<%= reqObj.id %>"
                                            class="px-4 py-1.5 text-xs font-medium text-white bg-red-600 hover:bg-red-700 rounded-lg transition-colors shadow-sm">
                                            Reset
                                        </button>
                                    </td>
                                </tr>

                                <!-- Approve Reset Confirmation Modal -->
                                <div id="approveResetModal-<%= reqObj.id %>" tabindex="-1" aria-hidden="true"
                                    class="fixed top-0 left-0 right-0 z-50 hidden w-full p-4 overflow-x-hidden overflow-y-auto md:inset-0 h-[calc(100%-1rem)] max-h-full">
                                    <div class="relative w-full max-w-md max-h-full">
                                        <div class="relative bg-white rounded-lg shadow dark:bg-gray-700">
                                            <button type="button"
                                                class="absolute top-3 right-2.5 text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ml-auto inline-flex justify-center items-center dark:hover:bg-gray-600 dark:hover:text-white"
                                                data-modal-hide="approveResetModal-<%= reqObj.id %>">
                                                <svg class="w-3 h-3" aria-hidden="true"
                                                    xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
                                                    <path stroke="currentColor" stroke-linecap="round"
                                                        stroke-linejoin="round" stroke-width="2"
                                                        d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6" />
                                                </svg>
                                                <span class="sr-only">Close modal</span>
                                            </button>
                                            <div class="p-6 text-center">
                                                <svg class="mx-auto mb-4 text-red-600 w-12 h-12 dark:text-red-500"
                                                    aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none"
                                                    viewBox="0 0 20 20">
                                                    <path stroke="currentColor" stroke-linecap="round"
                                                        stroke-linejoin="round" stroke-width="2"
                                                        d="M10 11V6m0 8h.01M19 10a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                                                </svg>
                                                <h3 class="mb-5 text-lg font-normal text-gray-500 dark:text-gray-400">
                                                    Apakah Anda yakin ingin me-reset password untuk
                                                    <strong>
                                                        <%= reqObj.user.nama %>
                                                    </strong>?
                                                </h3>
                                                <div
                                                    class="p-4 mb-4 text-sm text-yellow-800 rounded-lg bg-yellow-50 dark:bg-gray-800 dark:text-yellow-300 border border-yellow-100 dark:border-yellow-900/30">
                                                    Password akan direset menjadi <span class="font-bold">karakter
                                                        acak</span> dan dikirimkan ke email user.
                                                </div>
                                                <form action="/admin/users/approve-reset/<%= reqObj.id %>" method="POST"
                                                    class="inline">
                                                    <button type="submit"
                                                        class="text-white bg-red-600 hover:bg-red-800 focus:ring-4 focus:outline-none focus:ring-red-300 dark:focus:ring-red-800 font-medium rounded-lg text-sm inline-flex items-center px-5 py-2.5 text-center mr-2">
                                                        Ya, Reset Password
                                                    </button>
                                                </form>
                                                <button data-modal-hide="approveResetModal-<%= reqObj.id %>"
                                                    type="button"
                                                    class="text-gray-500 bg-white hover:bg-gray-100 focus:ring-4 focus:outline-none focus:ring-gray-200 rounded-lg border border-gray-200 text-sm font-medium px-5 py-2.5 hover:text-gray-900 focus:z-10 dark:bg-gray-700 dark:text-gray-300 dark:border-gray-500 dark:hover:text-white dark:hover:bg-gray-600 dark:focus:ring-gray-600">
                                                    Batal
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="4" class="px-6 py-4 text-center">Tidak ada request reset
                                                password
                                            </td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Accounts Tab -->
        <div class="hidden p-2 rounded-lg bg-gray-50 dark:bg-gray-800" id="accounts" role="tabpanel"
            aria-labelledby="accounts-tab">
            <div class="flex justify-between items-center mb-3">
                <h2 class="text-base font-semibold text-gray-900 dark:text-white">Daftar Akun User</h2>
                <button data-modal-target="createUserModal" data-modal-toggle="createUserModal"
                    class="text-white bg-green-700 hover:bg-green-800 focus:ring-4 focus:ring-green-300 font-medium rounded-lg text-xs px-4 py-2 dark:bg-green-600 dark:hover:bg-green-700 focus:outline-none dark:focus:ring-green-800">
                    + Tambah User Baru
                </button>
            </div>

            <!-- Search and Filter -->
            <div
                class="mb-4 bg-white dark:bg-gray-800/50 p-3 rounded-xl border border-gray-100 dark:border-gray-700/50 shadow-sm">
                <form id="filterForm" action="/admin/users" method="GET"
                    class="flex flex-col md:flex-row gap-4 items-end">
                    <!-- Search Name/Email -->
                    <div class="flex-grow w-full md:w-auto">

                        <div class="relative">
                            <input type="text" name="q" id="searchInput" value="<%= filters.q || '' %>"
                                placeholder="Ketik nama atau email..."
                                class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 font-medium text-gray-900 dark:text-white transition-all placeholder-gray-400">
                            <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                                <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                </svg>
                            </div>
                        </div>
                    </div>

                    <!-- Action Button -->
                    <div class="w-full md:w-auto">
                        <button type="submit"
                            class="w-full md:w-auto px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl shadow-lg shadow-blue-500/20 transition-all active:scale-95 flex items-center justify-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                            </svg>
                            Cari
                        </button>
                    </div>

                    <!-- Role Filter -->
                    <div class="w-full md:w-48">

                        <select name="role" id="roleFilter"
                            class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 font-medium text-gray-900 dark:text-white transition-all">
                            <option value="">Semua Role</option>
                            <option value="admin" <%=filters.role==='admin' ? 'selected' : '' %>>Admin</option>
                            <option value="manager" <%=filters.role==='manager' ? 'selected' : '' %>>Manager</option>
                            <option value="karyawan" <%=filters.role==='karyawan' ? 'selected' : '' %>>Karyawan</option>
                            <option value="mitra" <%=filters.role==='mitra' ? 'selected' : '' %>>Mitra</option>
                        </select>
                    </div>

                    <!-- Sub Role Filter -->
                    <div class="w-full md:w-48">

                        <select name="sub_role" id="subRoleFilter"
                            class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 font-medium text-gray-900 dark:text-white transition-all">
                            <option value="">Semua Sub Role</option>
                            <option value="editor" <%=filters.sub_role==='editor' ? 'selected' : '' %>>Editor</option>
                            <option value="viewer" <%=filters.sub_role==='viewer' ? 'selected' : '' %>>Viewer</option>
                        </select>
                    </div>

                    <!-- Status Filter -->
                    <div class="w-full md:w-48">
                        <select name="status" id="statusFilter"
                            class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 font-medium text-gray-900 dark:text-white transition-all">
                            <option value="">Semua Status</option>
                            <option value="active" <%=filters.status==='active' ? 'selected' : '' %>>Aktif</option>
                            <option value="inactive" <%=filters.status==='inactive' ? 'selected' : '' %>>Nonaktif
                            </option>
                        </select>
                    </div>
                </form>
            </div>

            <div class="relative overflow-x-auto overflow-y-auto shadow-md sm:rounded-lg max-h-[530px]">
                <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
                    <thead
                        class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400 sticky top-0 z-30">
                        <tr>
                            <th scope="col"
                                class="px-6 py-3 sticky left-0 z-30 bg-gray-50 dark:bg-gray-700 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.1)]">
                                Nama</th>
                            <th scope="col" class="px-6 py-3 whitespace-nowrap">Email</th>
                            <th scope="col" class="px-6 py-3 whitespace-nowrap text-center">Status</th>
                            <th scope="col" class="px-6 py-3 whitespace-nowrap text-center">Role</th>
                            <th scope="col"
                                class="px-6 py-3 sticky right-0 z-30 bg-gray-50 dark:bg-gray-700 text-center shadow-[-2px_0_5px_-2px_rgba(0,0,0,0.1)] w-[1%] whitespace-nowrap">
                                Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% const getRoleClass=(role)=> {
                            switch(role) {
                            case 'admin': return `bg-violet-100 text-violet-800 dark:bg-violet-900/40
                            dark:text-violet-300 border border-violet-200 dark:border-violet-800`;
                            case 'karyawan': return `bg-yellow-100 text-yellow-800 dark:bg-yellow-900/40
                            dark:text-yellow-300 border border-yellow-200 dark:border-yellow-800`;
                            case 'manager': return `bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300
                            border border-blue-200 dark:border-blue-800`;
                            case 'mitra': return `bg-orange-100 text-orange-800 dark:bg-orange-900/40
                            dark:text-orange-300 border border-orange-200 dark:border-orange-800`;
                            default: return `bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300 border
                            border-gray-200 dark:border-gray-600`;
                            }
                            };
                            const getSubRoleClass = (sub) => {
                            switch(sub) {
                            case 'editor': return `bg-purple-100 text-purple-800 dark:bg-purple-900/40
                            dark:text-purple-300 border border-purple-200 dark:border-purple-800`;
                            case 'viewer': return `bg-sky-100 text-sky-800 dark:bg-sky-900/40 dark:text-sky-300 border
                            border-sky-200 dark:border-sky-800`;
                            default: return `bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300 border
                            border-gray-200 dark:border-gray-600`;
                            }
                            };
                            %>
                            <% activeUsers.forEach(user=> { %>
                                <tr
                                    class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600">
                                    <td
                                        class="px-6 py-4 font-medium text-gray-900 dark:text-white sticky left-0 z-20 bg-white dark:bg-gray-800 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.1)]">
                                        <div class="flex items-center space-x-3 whitespace-nowrap">
                                            <% if (user.foto) { %>
                                                <img class="w-[34px] h-[34px] rounded-full object-cover border border-gray-200 dark:border-gray-700 shadow-sm"
                                                    src="/uploads/profiles/<%= user.foto %>" alt="<%= user.nama %>">
                                                <% } else { %>
                                                    <div
                                                        class="w-[34px] h-[34px] rounded-full bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center text-blue-600 dark:text-blue-400 font-bold text-sm border border-blue-200 dark:border-blue-800 shadow-sm">
                                                        <%= user.nama.charAt(0).toUpperCase() %>
                                                    </div>
                                                    <% } %>
                                                        <div>
                                                            <div class="font-semibold">
                                                                <%= user.nama %>
                                                            </div>
                                                        </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-2 whitespace-nowrap">
                                        <%= user.email %>
                                    </td>
                                    <td class="px-6 py-2 whitespace-nowrap text-center">
                                        <% if (user.is_active) { %>
                                            <span
                                                class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800 shadow-sm">
                                                Aktif
                                            </span>
                                            <% } else { %>
                                                <span
                                                    class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-rose-100 text-rose-800 dark:bg-rose-900/30 dark:text-rose-400 border border-rose-200 dark:border-rose-800 shadow-sm">
                                                    Nonaktif
                                                </span>
                                                <% } %>
                                    </td>
                                    <!-- Role -->
                                    <td class="px-6 py-2 whitespace-nowrap text-center">
                                        <div class="flex flex-col gap-1 items-center">
                                            <span
                                                class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-tight <%= getRoleClass(user.role) %>">
                                                <%= user.role %>
                                            </span>
                                            <% if (user.role !=='mitra' && user.role !=='admin' ) { %>
                                                <span
                                                    class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-tight <%= getSubRoleClass(user.sub_user) %>">
                                                    <%= user.sub_user %>
                                                </span>
                                                <% } else { %>
                                                    <span class="text-[10px] text-gray-400 font-bold">-</span>
                                                    <% } %>
                                        </div>
                                    </td>
                                    <td
                                        class="px-6 py-2 sticky right-0 z-20 bg-white dark:bg-gray-800 shadow-[-2px_0_5px_-2px_rgba(0,0,0,0.1)] w-[1%] whitespace-nowrap">
                                        <div class="flex items-center justify-center space-x-2 whitespace-nowrap">
                                            <button data-modal-target="editModal-<%= user.id %>"
                                                data-modal-toggle="editModal-<%= user.id %>"
