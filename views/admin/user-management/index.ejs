            <script>
                // Simple Tab Switcher logic if Flowbite JS is not handling it automatically 
                // (Assuming Flowbite or similar library is used given the classes, but adding manual script to be safe)
                document.addEventListener('DOMContentLoaded', () => {
                    const tabs = [
                        { id: 'requests-tab', target: 'requests' },
                        { id: 'accounts-tab', target: 'accounts' },
                        { id: 'resets-tab', target: 'resets' }
                    ];

                    tabs.forEach(tab => {
                        const el = document.getElementById(tab.id);
                        const targetEl = document.getElementById(tab.target);
                        if (el && targetEl) {
                            el.addEventListener('click', () => {
                                // Hide all
                                tabs.forEach(t => {
                                    const tTarget = document.getElementById(t.target);
                                    const tEl = document.getElementById(t.id);
                                    if (tTarget) tTarget.classList.add('hidden');
                                    if (tEl) tEl.classList.remove('border-blue-600', 'text-blue-600');
                                    if (tEl) tEl.setAttribute('aria-selected', 'false');
                                });
                                // Show current
                                targetEl.classList.remove('hidden');
                                el.classList.add('border-blue-600', 'text-blue-600');
                                el.setAttribute('aria-selected', 'true');
                            });
                        }
                    });

                    // Check URL for tab parameter
                    const urlParams = new URLSearchParams(window.location.search);
                    const activeTab = urlParams.get('tab');

                    if (activeTab === 'accounts') {
                        const accountsTab = document.getElementById('accounts-tab');
                        if (accountsTab) accountsTab.click();
                    } else if (activeTab === 'requests') {
                        const requestsTab = document.getElementById('requests-tab');
                        if (requestsTab) requestsTab.click();
                    } else if (activeTab === 'resets') {
                        const resetsTab = document.getElementById('resets-tab');
                        if (resetsTab) resetsTab.click();
                    } else {
                        // Default to first tab
                        if (tabs[0]) {
                            const firstTab = document.getElementById(tabs[0].id);
                            if (firstTab) firstTab.click();
                        }
                    }

                    // Live Search & Filter Logic
                    const searchInput = document.getElementById('searchInput');
                    const roleFilter = document.getElementById('roleFilter');
                    const subRoleFilter = document.getElementById('subRoleFilter');
                    const statusFilter = document.getElementById('statusFilter');
                    const userTable = document.querySelector('#accounts table tbody');
                    const userRows = userTable.querySelectorAll('tr');

                    function filterUsers() {
                        const searchTerm = searchInput.value.toLowerCase();
                        const selectedRole = roleFilter.value.toLowerCase();
                        const selectedSubRole = subRoleFilter.value.toLowerCase();
                        let selectedStatus = statusFilter.value.toLowerCase();

                        if (selectedStatus === 'active') selectedStatus = 'aktif';
                        if (selectedStatus === 'inactive') selectedStatus = 'nonaktif';

                        userRows.forEach(row => {
                            const nameText = row.querySelector('.font-semibold').textContent.toLowerCase();
                            const emailText = row.children[1].textContent.toLowerCase();

                            // badges[0] is Status (Aktif/Nonaktif)
                            const badges = row.querySelectorAll('.inline-flex');
                            const statusBadge = badges[0] ? badges[0].textContent.trim().toLowerCase() : '';

                            // Collect role and sub-role texts from the Role column
                            // Each app column has a div with 2 spans.
                            const appBadges = Array.from(badges).slice(1);
                            const appTexts = appBadges.map(b => b.textContent.trim().toLowerCase());

                            const matchesSearch = nameText.includes(searchTerm) || emailText.includes(searchTerm);
                            const matchesStatus = selectedStatus === '' || statusBadge === selectedStatus;

                            // Check if any app badge matches the selected role/subrole
                            // role matches if selectedRole is in appTexts
                            // subrole matches if selectedSubRole is in appTexts
                            // This handles filtering across all systems.
                            const matchesRole = selectedRole === '' || appTexts.includes(selectedRole);
                            const matchesSubRole = selectedSubRole === '' || appTexts.includes(selectedSubRole);

                            if (matchesSearch && matchesRole && matchesSubRole && matchesStatus) {
                                row.style.display = '';
                            } else {
                                row.style.display = 'none';
                            }
                        });

                        // Check for "No data found" case
                        const visibleRows = Array.from(userRows).filter(r => r.style.display !== 'none');
                        let noResultRow = document.getElementById('noResultsRow');

                        if (visibleRows.length === 0) {
                            if (!noResultRow) {
                                noResultRow = document.createElement('tr');
                                noResultRow.id = 'noResultsRow';
                                noResultRow.innerHTML = `<td colspan="5" class="px-6 py-8 text-center text-gray-500 dark:text-gray-400">Tidak ada user yang cocok dengan pencarian Anda</td>`;
                                userTable.appendChild(noResultRow);
                            }
                        } else if (noResultRow) {
                            noResultRow.remove();
                        }
                    }

                    if (searchInput) {
                        searchInput.addEventListener('input', filterUsers);
                        roleFilter.addEventListener('change', filterUsers);
                        subRoleFilter.addEventListener('change', filterUsers);
                        statusFilter.addEventListener('change', filterUsers);
                    }

                    // --- Role-based Sub-Role Locking (Mitra) ---
                    const setupRoleLogic = (form) => {
                        const roleSelect = form.querySelector('select[name="role"]');
                        const subRoleSelect = form.querySelector('select[name="sub_user"]');
                        if (!roleSelect || !subRoleSelect) return;

                        const subRoleContainer = subRoleSelect.closest('div');
                        const wrapper = subRoleContainer.parentElement;

                        const updateSubRoleStatus = () => {
                            const isNoSubRole = roleSelect.value === 'mitra' || roleSelect.value === 'admin';
                            const menuBox = form.querySelector('.mitra-menu-box');
                            if (menuBox) menuBox.classList.toggle('hidden', roleSelect.value !== 'mitra');

                            if (isNoSubRole) {
                                subRoleSelect.value = roleSelect.value === 'mitra' ? 'viewer' : 'editor';
                                if (subRoleContainer) subRoleContainer.classList.add('hidden');

                                // Handle grid-cols-2 in Edit Modal
                                if (wrapper && wrapper.classList.contains('grid')) {
                                    wrapper.classList.remove('md:grid-cols-2', 'grid-cols-2');
                                    wrapper.classList.add('grid-cols-1');
                                }
                            } else {
                                if (subRoleContainer) subRoleContainer.classList.remove('hidden');

                                // Restore grid-cols-2
                                if (wrapper && wrapper.classList.contains('grid')) {
                                    wrapper.classList.remove('grid-cols-1');
                                    wrapper.classList.add('grid-cols-2');
                                }
                            }
                        };

                        roleSelect.addEventListener('change', updateSubRoleStatus);
                        updateSubRoleStatus(); // Initial run
                    };

                    // Apply to all forms/modals
                    document.querySelectorAll('form').forEach(form => setupRoleLogic(form));

                    // Special case for dynamic modals if they are reapplied
                    const observer = new MutationObserver((mutations) => {
                        mutations.forEach((mutation) => {
                            if (mutation.addedNodes.length) {
                                mutation.addedNodes.forEach(node => {
                                    if (node.nodeType === 1) { // Element
                                        if (node.tagName === 'FORM') setupRoleLogic(node);
                                        node.querySelectorAll('form').forEach(form => setupRoleLogic(form));
                                    }
                                });
                            }
                        });
                    });
                    observer.observe(document.body, { childList: true, subtree: true });
                });
            </script>