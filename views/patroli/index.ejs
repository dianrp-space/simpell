<!-- Patroli Index -->
<div class="space-y-6">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Patroli</h1>
            <p class="text-gray-500 dark:text-gray-400">Arsip Jadwal & Catatan Patroli</p>
        </div>
        <div class="flex items-center gap-3">
            <% if (isEditor) { %>
                <a href="/patroli/create"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white font-medium rounded-lg shadow-lg shadow-blue-500/25 transition-all transform hover:scale-[1.02]">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                    Tambah Patroli
                </a>
                <% } %>
                    <a href="/patroli/export?search=<%= search %>"
                        class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-green-600 hover:bg-green-700 text-white font-medium rounded-lg shadow-lg shadow-green-500/25 transition-all transform hover:scale-[1.02]">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z">
                            </path>
                        </svg>
                        Download Excel
                    </a>
        </div>
    </div>

    <!-- Search -->
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm">
        <form id="searchForm" action="/patroli" method="GET" class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1">
                <input type="text" id="searchInput" name="search" value="<%= search %>"
                    placeholder="Cari lokasi, rincian, PJ, atau keterangan..."
                    class="w-full px-4 py-2.5 pl-10 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                <div class="absolute left-3 top-1/2 -translate-y-1/2">
                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </div>
            </div>
            <% if (search) { %>
                <a href="/patroli"
                    class="px-4 py-2.5 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors text-center">
                    Reset
                </a>
                <% } %>
        </form>
    </div>

    <script>
        const searchInput = document.getElementById('searchInput');
        const searchForm = document.getElementById('searchForm');
        let timeout = null;

        searchInput.addEventListener('input', function (e) {
            clearTimeout(timeout);
            timeout = setTimeout(function () {
                if (searchInput.value.length >= 1 || searchInput.value.length === 0) {
                    searchForm.submit();
                }
            }, 500);
        });

        if (searchInput.value) {
            searchInput.focus();
            const val = searchInput.value;
            searchInput.value = '';
            searchInput.value = val;
        }
    </script>
</div>

<!-- Table -->
<div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl shadow-sm overflow-hidden">
    <div class="overflow-auto max-h-[80vh] relative">
        <table class="w-full">
            <thead
                class="sticky top-0 z-50 bg-gray-50 dark:bg-gray-900 border-b border-gray-200 dark:border-gray-700 shadow-sm">
                <tr>
                    <th
                        class="px-6 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                        Tanggal
                    </th>
                    <th
                        class="px-6 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                        Waktu Patroli
                    </th>
                    <th
                        class="px-6 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                        Lokasi Patroli
                    </th>
                    <th
                        class="px-6 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                        Rincian
                    </th>
                    <th
                        class="px-6 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                        P.J
                    </th>
                    <th
                        class="px-6 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap">
                        Keterangan
                    </th>
                    <% if (isEditor) { %>
                        <th
                            class="px-3 py-3 text-center text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider whitespace-nowrap sticky right-0 top-0 bg-gray-50 dark:bg-gray-900 z-30 shadow-[-4px_0_8px_-4px_rgba(0,0,0,0.1)] w-1">
                            Aksi
                        </th>
                        <% } %>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                <% if (data.length===0) { %>
                    <tr>
                        <td colspan="7" class="px-6 py-12 text-center">
                            <div class="flex flex-col items-center">
                                <svg class="w-12 h-12 text-gray-300 dark:text-gray-600 mb-4" fill="none"
                                    stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z">
                                    </path>
                                </svg>
                                <p class="text-gray-500 dark:text-gray-400 mb-2">Tidak ada data patroli</p>
                                <% if (isEditor) { %>
                                    <a href="/patroli/create"
                                        class="text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 font-medium">Tambah
                                        data baru</a>
                                    <% } %>
                            </div>
                        </td>
                    </tr>
                    <% } else { %>
                        <% data.forEach(item=> { %>
                            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors text-sm">
                                <td
                                    class="px-6 py-4 text-gray-700 dark:text-gray-300 text-sm whitespace-nowrap align-top">
                                    <%= item.tanggal ? moment(item.tanggal).format('DD/MM/YY') : '-' %>
                                </td>
                                <td
                                    class="px-6 py-4 text-gray-700 dark:text-gray-300 text-sm whitespace-nowrap align-top">
                                    <div class="flex flex-col gap-1.5">
                                        <% if (item.waktu_mulai) { %>
                                            <span
                                                class="px-2 py-0.5 inline-flex text-[12px] leading-4 font-semibold rounded-full bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400 w-fit">
                                                Start: <%= item.waktu_mulai.slice(0, 5) %>
                                            </span>
                                            <% } else { %>
                                                <span class="text-xs text-gray-400">-</span>
                                                <% } %>

                                                    <% if (item.waktu_selesai) { %>
                                                        <span
                                                            class="px-2 py-0.5 inline-flex text-[12px] leading-4 font-semibold rounded-full bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400 w-fit">
                                                            Finish: <%= item.waktu_selesai.slice(0, 5) %>
                                                        </span>
                                                        <% } else { %>
                                                            <span class="text-xs text-gray-400">-</span>
                                                            <% } %>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap align-top">
                                    <span class="text-gray-900 dark:text-white font-medium">
                                        <%= item.lokasi || '-' %>
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-gray-700 dark:text-gray-300 text-sm align-top min-w-[300px]">
                                    <%- formatText(item.rincian) %>
                                </td>
                                <td
                                    class="px-6 py-4 text-gray-700 dark:text-gray-300 text-sm whitespace-nowrap align-top">
                                    <%= item.pj || '-' %>
                                </td>
                                <td
                                    class="px-6 py-4 text-gray-700 dark:text-gray-300 text-sm whitespace-nowrap align-top min-w-[200px]">
                                    <%- formatText(item.keterangan) %>
                                </td>
                                <% if (isEditor) { %>
                                    <td
                                        class="px-3 py-4 whitespace-nowrap align-top sticky right-0 bg-white dark:bg-gray-800 z-20 shadow-[-4px_0_8px_-4px_rgba(0,0,0,0.1)] w-1">
                                        <div class="flex items-center justify-center gap-2">
                                            <a href="/patroli/<%= item.id %>/edit"
                                                class="p-2 text-amber-600 hover:bg-amber-50 dark:hover:bg-amber-900/20 rounded-lg transition-colors"
                                                title="Edit">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor"
                                                    viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z">
                                                    </path>
                                                </svg>
                                            </a>
                                            <form action="/patroli/<%= item.id %>?_method=DELETE" method="POST"
                                                class="inline" onsubmit="return confirmSubmit(this, 'Hapus data ini?')">
                                                <button type="submit"
                                                    class="p-2 text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-lg transition-colors"
                                                    title="Hapus">
                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor"
                                                        viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            stroke-width="2"
                                                            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                                                        </path>
                                                    </svg>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                    <% } %>
                            </tr>
                            <% }); %>
                                <% } %>
            </tbody>
        </table>
        <%- include('../partials/pagination') %>
    </div>
</div>