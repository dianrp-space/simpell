<!-- Patroli Form -->
<div class="max-w-3xl mx-auto space-y-6">
    <!-- Page Header -->
    <div class="flex items-center gap-4">
        <a href="/patroli"
            class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:text-white dark:hover:bg-gray-700 rounded-lg transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18">
                </path>
            </svg>
        </a>
        <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
                <%= data ? 'Edit' : 'Tambah' %> Patroli
            </h1>
            <p class="text-gray-500 dark:text-gray-400">Manajemen jadwal dan kegiatan patroli</p>
        </div>
    </div>

    <!-- Form Card -->
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6 shadow-sm">
        <form
            action="<%= data ? '/patroli/' + data.id + '?_method=PUT' + (typeof returnUrl !== 'undefined' && returnUrl ? '&return_url=' + encodeURIComponent(returnUrl) : '') : '/patroli' %>"
            method="POST" class="space-y-6">

            <!-- Tanggal -->
            <div>
                <label for="tanggal" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Tanggal
                    <span class="text-red-500">*</span></label>
                <input type="date" id="tanggal" name="tanggal" required
                    value="<%= data && data.tanggal ? moment(data.tanggal).format('YYYY-MM-DD') : moment().format('YYYY-MM-DD') %>"
                    class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all">
            </div>

            <!-- Waktu -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label for="waktu_mulai"
                        class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Waktu Mulai</label>
                    <input type="time" id="waktu_mulai" name="waktu_mulai" value="<%= data ? data.waktu_mulai : '' %>"
                        class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all">
                </div>
                <div>
                    <label for="waktu_selesai"
                        class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Waktu Selesai</label>
                    <input type="time" id="waktu_selesai" name="waktu_selesai"
                        value="<%= data ? data.waktu_selesai : '' %>"
                        class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all">
                </div>
            </div>

            <!-- Lokasi -->
            <div>
                <label for="lokasi" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Lokasi
                    Patroli</label>
                <input type="text" id="lokasi" name="lokasi" value="<%= data ? data.lokasi || '' : '' %>"
                    class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                    placeholder="Lokasi patroli...">
            </div>

            <!-- Rincian (formerly Keterangan) -->
            <div>
                <label for="rincian"
                    class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Rincian</label>
                <textarea id="rincian" name="rincian" rows="4"
                    class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                    placeholder="Rincian kegiatan patroli..."><%= data ? data.rincian || '' : '' %></textarea>
            </div>

            <!-- PJ & Keterangan (formerly Tim Patroli) -->
            <!-- PJ -->
            <div>
                <label for="pj" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">P.J</label>
                <input type="text" id="pj" name="pj" value="<%= data ? data.pj || '' : '' %>"
                    class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                    placeholder="Penanggung jawab">
            </div>

            <!-- Keterangan -->
            <div>
                <label for="keterangan"
                    class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Keterangan</label>
                <textarea id="keterangan" name="keterangan" rows="3"
                    class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                    placeholder="Keterangan tambahan..."><%= data ? data.keterangan || '' : '' %></textarea>
            </div>

            <div class="flex gap-3 pt-4 border-t border-gray-200 dark:border-gray-700">
                <button type="submit"
                    class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white font-medium rounded-lg shadow-lg shadow-blue-500/25 transition-all transform hover:scale-[1.02]">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7">
                        </path>
                    </svg>
                    <%= data ? 'Simpan Perubahan' : 'Simpan' %>
                </button>
                <a href="<%= (typeof returnUrl !== 'undefined' && returnUrl) ? returnUrl : '/patroli' %>"
                    class="inline-flex items-center px-5 py-2.5 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                    Batal
                </a>
            </div>
        </form>
    </div>
</div>