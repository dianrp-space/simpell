<%
var pickedMenus = [];
if (Array.isArray(selectedMenus)) {
    pickedMenus = selectedMenus;
} else if (typeof selectedMenus === 'string' && selectedMenus) {
    try { pickedMenus = JSON.parse(selectedMenus); } catch (e) { pickedMenus = []; }
}
if (!Array.isArray(pickedMenus)) pickedMenus = [];
var menuOpen = (typeof menuRole !== 'undefined' && menuRole === 'mitra');
var boxId = (typeof menuBoxId !== 'undefined' && menuBoxId) ? menuBoxId : 'default';
var partnerMenus = ['record-ggn', 'ms-fo', 'pending-ms-fo', 'pm-ms-fo'];
var catalog = menuCatalog || [];
var primaryMenus = partnerMenus.map(function (key) {
    return catalog.find(function (menu) { return menu.key === key; });
}).filter(Boolean);
var otherMenus = catalog.filter(function (menu) { return partnerMenus.indexOf(menu.key) === -1; });
function menuCheck(menu) {
    return pickedMenus.indexOf(menu.key) !== -1 ? 'checked' : '';
}
%>
<div class="mitra-menu-box <%= menuOpen ? '' : 'hidden' %> space-y-3">
    <div>
        <label for="nama-mitra-<%= boxId %>" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Nama mitra</label>
        <input type="text" name="nama_mitra" id="nama-mitra-<%= boxId %>" list="mitra-names-<%= boxId %>"
            value="<%= typeof namaMitra !== 'undefined' && namaMitra ? namaMitra : '' %>"
            placeholder="JOINTER atau TA"
            class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:placeholder-gray-400 dark:text-white">
        <datalist id="mitra-names-<%= boxId %>">
            <option value="JOINTER"></option>
            <option value="TA"></option>
        </datalist>
        <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Sama dengan PJ MS FO. Data yang tampil hanya baris dengan PJ ini.</p>
    </div>
    <div>
        <p class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Menu yang boleh dilihat</p>
        <p class="mb-2 text-xs text-gray-500 dark:text-gray-400">Centang saat membuat role. Record GGN &amp; PM dan grup Manage Service FO Kepri biasanya dibuka untuk mitra. Menu yang tidak dicentang tidak muncul dan tidak bisa dibuka lewat URL.</p>
        <div class="max-h-64 overflow-y-auto rounded-lg border border-gray-200 dark:border-gray-600 p-3 space-y-3">
            <div class="space-y-1">
                <p class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Untuk mitra</p>
                <% primaryMenus.forEach(function (menu) { %>
                    <label class="flex items-center gap-2 text-sm text-gray-800 dark:text-gray-100">
                        <input type="checkbox" name="allowed_menus" value="<%= menu.key %>" <%= menuCheck(menu) %>
                            class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                        <span><%= menu.label %></span>
                        <span class="text-xs text-gray-400"><%= menu.group %></span>
                    </label>
                <% }); %>
            </div>
            <div class="space-y-1">
                <p class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Menu lain</p>
                <% otherMenus.forEach(function (menu) { %>
                    <label class="flex items-center gap-2 text-sm text-gray-800 dark:text-gray-100">
                        <input type="checkbox" name="allowed_menus" value="<%= menu.key %>" <%= menuCheck(menu) %>
                            class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                        <span><%= menu.label %></span>
                        <span class="text-xs text-gray-400"><%= menu.group %></span>
                    </label>
                <% }); %>
            </div>
        </div>
    </div>
</div>
