<%
var pickedMenus = [];
if (Array.isArray(selectedMenus)) {
    pickedMenus = selectedMenus;
} else if (typeof selectedMenus === 'string' && selectedMenus) {
    try { pickedMenus = JSON.parse(selectedMenus); } catch (e) { pickedMenus = []; }
}
if (!Array.isArray(pickedMenus)) pickedMenus = [];
var menuOpen = (typeof menuRole !== 'undefined' && menuRole === 'mitra');
%>
<div class="mitra-menu-box <%= menuOpen ? '' : 'hidden' %>">
    <p class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Menu yang boleh dilihat</p>
    <p class="mb-2 text-xs text-gray-500 dark:text-gray-400">Centang menu yang diminta mitra. Menu lain tidak muncul dan tidak bisa dibuka lewat URL.</p>
    <div class="max-h-52 overflow-y-auto rounded-lg border border-gray-200 dark:border-gray-600 p-3 space-y-1">
        <% (menuCatalog || []).forEach(function (menu) { %>
            <label class="flex items-center gap-2 text-sm text-gray-800 dark:text-gray-100">
                <input type="checkbox" name="allowed_menus" value="<%= menu.key %>"
                    <%= pickedMenus.indexOf(menu.key) !== -1 ? 'checked' : '' %>
                    class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                <span><%= menu.label %></span>
                <span class="text-xs text-gray-400"><%= menu.group %></span>
            </label>
        <% }); %>
    </div>
</div>
