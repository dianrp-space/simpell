<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white"><%= heading %></h1>
            <p class="text-sm text-gray-500 dark:text-gray-400"><%= subtitle %></p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            <% if (isEditor) { %>
                <a href="<%= base %>/create"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg shadow-sm">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                    Tambah Data
                </a>
            <% } %>
            <a href="<%= exportHref %>"
                class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-lg shadow-sm">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                Download Excel
            </a>
        </div>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <% const tones = {
            blue: 'bg-blue-50 dark:bg-blue-900/10 border-blue-100 dark:border-blue-900/20 text-blue-600 dark:text-blue-400',
            green: 'bg-green-50 dark:bg-green-900/10 border-green-100 dark:border-green-900/20 text-green-600 dark:text-green-400',
            gray: 'bg-gray-50 dark:bg-gray-800 border-gray-200 dark:border-gray-700 text-gray-500 dark:text-gray-400',
            red: 'bg-red-50 dark:bg-red-900/10 border-red-100 dark:border-red-900/20 text-red-600 dark:text-red-400',
            yellow: 'bg-yellow-50 dark:bg-yellow-900/10 border-yellow-100 dark:border-yellow-900/20 text-yellow-700 dark:text-yellow-400'
        }; %>
        <% stats.forEach(function (card) { %>
            <div class="border rounded-xl p-3 <%= tones[card.tone] || tones.blue %>">
                <p class="text-[10px] font-bold uppercase tracking-wider"><%= card.label %></p>
                <p class="mt-1 text-xl font-bold text-gray-900 dark:text-white leading-none"><%= card.value %></p>
            </div>
        <% }); %>
    </div>

    <% if (typeof fiberLegend !== 'undefined' && fiberLegend && fiberLegend.length) { %>
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Warna inti optik</p>
            <div class="mt-3 flex flex-wrap gap-2">
                <% fiberLegend.forEach(function (color, index) { %>
                    <span class="inline-flex items-center gap-2 rounded-full border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-900 px-2.5 py-1 text-xs font-medium text-gray-700 dark:text-gray-200">
                        <span class="inline-flex h-5 min-w-[1.25rem] items-center justify-center rounded-full border border-black/10 px-1 text-[10px] font-bold" style="background:<%= color.hex %>;color:<%= color.ink %>"><%= index + 1 %></span>
                        <%= color.label %>
                    </span>
                <% }); %>
            </div>
        </div>
    <% } %>

    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm">
        <form id="searchForm" action="<%= base %>" method="GET" class="flex flex-col md:flex-row gap-3">
            <div class="relative flex-1">
                <input type="text" id="searchInput" name="search" value="<%= search %>" placeholder="<%= searchPlaceholder %>"
                    class="w-full px-4 py-2.5 pl-10 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg text-sm text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                <div class="absolute left-3 top-1/2 -translate-y-1/2">
                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </div>
            </div>
            <% if (statuses && statuses.length) { %>
                <select name="status" id="statusFilter"
                    class="w-full md:w-48 px-4 py-2.5 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg text-sm text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500">
                    <option value=""><%= typeof filterLabel !== 'undefined' && filterLabel ? filterLabel : 'Semua Status' %></option>
                    <% statuses.forEach(function (item) { %>
                        <option value="<%= item %>" <%= status === item ? 'selected' : '' %>><%= item %></option>
                    <% }); %>
                </select>
            <% } %>
            <% Object.entries(filters).forEach(function (entry) { if (entry[1]) { %>
                <input type="hidden" name="f_<%= entry[0] %>" value="<%= entry[1] %>">
            <% } }); %>
            <% if (sort) { %>
                <input type="hidden" name="sort" value="<%= sort %>">
                <input type="hidden" name="dir" value="<%= dir %>">
            <% } %>
            <% if (search || status || sort || Object.values(filters).some(Boolean)) { %>
                <a href="<%= base %>" class="px-4 py-2.5 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 text-sm font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 text-center">Reset</a>
            <% } %>
        </form>
    </div>

    <form id="columnFilters" action="<%= base %>" method="GET">
        <% if (search) { %><input type="hidden" name="search" value="<%= search %>"><% } %>
        <% if (status && !columns.some(function (column) { return column.key === 'status'; })) { %>
            <input type="hidden" name="status" value="<%= status %>">
        <% } %>
        <% if (sort) { %>
            <input type="hidden" name="sort" value="<%= sort %>">
            <input type="hidden" name="dir" value="<%= dir %>">
        <% } %>
    </form>

    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl shadow-sm overflow-hidden">
        <div class="overflow-auto max-h-[80vh] relative">
            <table class="w-full">
                <thead class="sticky top-0 z-50 bg-gray-50 dark:bg-gray-900 border-b border-gray-200 dark:border-gray-700 shadow-sm">
                    <tr>
                        <% columns.forEach(function (column) { %>
                            <th class="px-3 py-3 text-left align-top"<% if (column.active) { %> aria-sort="<%= column.direction === 'asc' ? 'ascending' : 'descending' %>"<% } %>>
                                <div class="col-head">
                                    <a href="<%= column.href %>" data-col-label
                                        class="inline-flex items-center gap-1 text-sm font-semibold <%= column.active ? 'text-blue-600 dark:text-blue-400' : 'text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white' %>">
                                        <%= column.label %>
                                        <% if (column.direction === 'asc') { %>
                                            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path></svg>
                                        <% } else if (column.direction === 'desc') { %>
                                            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                        <% } else { %>
                                            <svg class="w-3.5 h-3.5 shrink-0 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l4-4 4 4M8 15l4 4 4-4"></path></svg>
                                        <% } %>
                                    </a>
                                    <% if (column.key === 'status') { %>
                                        <select form="columnFilters" name="status" id="columnStatus"
                                            class="h-8 w-full px-2 bg-white dark:bg-gray-950 border <%= status ? 'border-blue-500' : 'border-gray-200 dark:border-gray-700' %> rounded-lg text-xs text-gray-700 dark:text-gray-200 focus:ring-2 focus:ring-blue-500">
                                            <option value="">Semua</option>
                                            <% statuses.forEach(function (item) { %>
                                                <option value="<%= item %>" <%= status === item ? 'selected' : '' %>><%= item %></option>
                                            <% }); %>
                                        </select>
                                    <% } else { %>
                                        <input form="columnFilters" type="search" name="f_<%= column.key %>" data-col-filter
                                            value="<%= filters[column.key] || '' %>" placeholder="Cari"
                                            class="h-8 w-full px-2.5 bg-white dark:bg-gray-950 border <%= filters[column.key] ? 'border-blue-500' : 'border-gray-200 dark:border-gray-700' %> rounded-lg text-xs text-gray-800 dark:text-gray-100 placeholder-gray-400 focus:ring-2 focus:ring-blue-500">
                                    <% } %>
                                </div>
                            </th>
                        <% }); %>
                        <th class="px-3 py-3 text-center text-sm font-semibold text-gray-600 dark:text-gray-400 sticky right-0 top-0 bg-gray-50 dark:bg-gray-900 z-30 shadow-[-4px_0_8px_-4px_rgba(0,0,0,0.1)]">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                    <% if (!data.length) { %>
                        <tr>
                            <td colspan="<%= columns.length + 1 %>" class="px-6 py-12 text-center text-sm text-gray-500 dark:text-gray-400">Tidak ada data</td>
                        </tr>
                    <% } else { %>
                        <% data.forEach(function (item) { %>
                            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 text-sm">
                                <% columns.forEach(function (column) { %>
                                    <td class="px-3 py-3 align-top text-gray-800 dark:text-gray-100">
                                        <% if (column.key === 'status') { %>
                                            <% const key = String(item.status || '').toLowerCase();
                                               const badge = (key === 'active' || key === 'done')
                                                   ? 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400'
                                                   : (key === 'progress' ? 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400'
                                                   : (key === 'inactive' ? 'bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-300'
                                                   : (key === 'suspended' ? 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400'
                                                   : 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400'))); %>
                                            <span class="inline-flex px-2.5 py-0.5 rounded-full text-xs font-medium <%= badge %>"><%= item.status || '-' %></span>
                                        <% } else if (column.key === 'tanggal') { %>
                                            <%= item.tanggal ? moment(item.tanggal).format('DD/MM/YYYY') : '-' %>
                                        <% } else if (column.key === 'warna' && typeof fiberMap !== 'undefined' && fiberMap) { %>
                                            <% const fiber = fiberMap[item.warna]; %>
                                            <% if (fiber) { %>
                                                <span class="inline-flex items-center gap-2">
                                                    <span class="inline-block h-4 w-4 rounded-full border border-black/10" style="background:<%= fiber.hex %>"></span>
                                                    <span><%= fiber.label %></span>
                                                </span>
                                            <% } else { %>-<% } %>
                                        <% } else if (column.key === 'port' && typeof fiberMap !== 'undefined' && fiberMap && item.warna && fiberMap[item.warna]) { %>
                                            <span class="inline-flex h-7 min-w-[1.75rem] items-center justify-center rounded-md border border-black/10 px-2 text-xs font-bold" style="background:<%= fiberMap[item.warna].hex %>;color:<%= fiberMap[item.warna].ink %>"><%= item.port %></span>
                                        <% } else if (column.key === 'lat_long' || column.key === 'koordinat') { %>
                                            <% const coordinateHref = mapsHref(item[column.key]); %>
                                            <% if (coordinateHref) { %>
                                                <a href="<%= coordinateHref %>" target="_blank" rel="noopener noreferrer" title="Buka di Google Maps"
                                                    class="text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 hover:underline"><%= String(item[column.key]).replace(/\s+/g, ' ') %></a>
                                            <% } else { %>
                                                <%= item[column.key] == null || item[column.key] === '' ? '-' : String(item[column.key]).replace(/\s+/g, ' ') %>
                                            <% } %>
                                        <% } else { %>
                                            <%= item[column.key] == null || item[column.key] === '' ? '-' : String(item[column.key]).replace(/\s+/g, ' ') %>
                                        <% } %>
                                    </td>
                                <% }); %>
                                <td class="px-3 py-3 align-top sticky right-0 bg-white dark:bg-gray-800 z-20 shadow-[-4px_0_8px_-4px_rgba(0,0,0,0.1)]">
                                    <div class="flex items-center justify-center gap-1">
                                        <a href="<%= base %>/<%= item.id %>" class="p-2 text-blue-600 hover:bg-blue-50 dark:hover:bg-blue-900/20 rounded-lg" title="Detail">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                        </a>
                                        <% if (isEditor) { %>
                                            <a href="<%= base %>/<%= item.id %>/edit" class="p-2 text-amber-600 hover:bg-amber-50 dark:hover:bg-amber-900/20 rounded-lg" title="Edit">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                            </a>
                                            <form action="<%= base %>/<%= item.id %>?_method=DELETE" method="POST" class="inline" onsubmit="return confirmSubmit(this, 'Hapus data ini?')">
                                                <button type="submit" class="p-2 text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-lg" title="Hapus">
                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                                </button>
                                            </form>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    <% } %>
                </tbody>
            </table>
            <%- include('../partials/pagination') %>
        </div>
    </div>
</div>
<script>
    (function () {
        const searchForm = document.getElementById('searchForm');
        const searchInput = document.getElementById('searchInput');
        const statusFilter = document.getElementById('statusFilter');
        let timer = null;
        if (searchInput && searchForm) {
            searchInput.addEventListener('input', function () {
                clearTimeout(timer);
                timer = setTimeout(function () { searchForm.submit(); }, 500);
            });
        }
        if (statusFilter && searchForm) statusFilter.addEventListener('change', function () { searchForm.submit(); });

        const form = document.getElementById('columnFilters');
        if (!form) return;
        const submit = function () {
            if (typeof form.requestSubmit === 'function') form.requestSubmit();
            else form.submit();
        };
        document.querySelectorAll('[data-col-filter]').forEach(function (input) {
            input.addEventListener('input', function () {
                clearTimeout(timer);
                timer = setTimeout(submit, 400);
            });
        });
        const statusCol = document.getElementById('columnStatus');
        if (statusCol) statusCol.addEventListener('change', submit);
        form.addEventListener('submit', function () {
            Array.from(form.elements).forEach(function (el) {
                if ((el.tagName === 'INPUT' || el.tagName === 'SELECT') && !String(el.value || '').trim()) el.disabled = true;
            });
        });
    })();
</script>
