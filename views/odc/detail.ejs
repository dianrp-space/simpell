<!-- ODC Detail -->
<div class="space-y-6">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-4">
            <a href="/odc"
                class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:text-white dark:hover:bg-gray-700 rounded-lg transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
            </a>
            <h1 class="text-xl md:text-2xl font-bold text-gray-900 dark:text-white">
                <%= data.nama_odc %>
            </h1>
        </div>
        <% if (isEditor) { %>
            <a href="/odc/<%= data.id %>/edit?return_to=/odc/<%= data.id %>"
                class="inline-flex items-center gap-2 px-4 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z">
                    </path>
                </svg>
                Edit
            </a>
            <% } %>
    </div>

    <% const totalCapacity = Number(data.capacity) || 0;
        const statusCards = [
            { name: 'Active', tone: 'green' },
            { name: 'Cut', tone: 'red' },
            { name: 'Alokasi', tone: 'blue' },
            { name: 'Idle', tone: 'amber' },
            { name: 'None', tone: 'gray' },
            { name: 'Bad', tone: 'rose' }
        ];
        const countedCores = data.cores ? data.cores.filter(c => c.tray !== 0 && c.tube !== 0 && c.core_number !== 0) : [];
        const statusTotals = {};
        statusCards.forEach(function (card) { statusTotals[card.name] = 0; });
        countedCores.forEach(function (core) {
            if (Object.prototype.hasOwnProperty.call(statusTotals, core.status)) statusTotals[core.status] += 1;
        });
        const cardTone = {
            green: 'bg-green-50 dark:bg-green-900/10 border-green-100 dark:border-green-900/20 text-green-600 dark:text-green-400',
            red: 'bg-red-50 dark:bg-red-900/10 border-red-100 dark:border-red-900/20 text-red-600 dark:text-red-400',
            blue: 'bg-blue-50 dark:bg-blue-900/10 border-blue-100 dark:border-blue-900/20 text-blue-600 dark:text-blue-400',
            amber: 'bg-amber-50 dark:bg-amber-900/10 border-amber-100 dark:border-amber-900/20 text-amber-700 dark:text-amber-400',
            gray: 'bg-gray-50 dark:bg-gray-800 border-gray-200 dark:border-gray-700 text-gray-500 dark:text-gray-400',
            rose: 'bg-rose-50 dark:bg-rose-900/10 border-rose-100 dark:border-rose-900/20 text-rose-600 dark:text-rose-400'
        };
        %>

        <div class="grid grid-cols-2 sm:grid-cols-4 xl:grid-cols-7 gap-3">
            <div class="bg-sky-50 dark:bg-sky-900/10 border border-sky-100 dark:border-sky-900/20 rounded-xl p-3">
                <p class="text-[10px] font-bold text-sky-600 dark:text-sky-400 uppercase tracking-wider">Capacity</p>
                <p class="mt-1 text-xl font-bold text-gray-900 dark:text-white leading-none"><%= totalCapacity %></p>
            </div>
            <% statusCards.forEach(function (card) { %>
                <div class="border rounded-xl p-3 <%= cardTone[card.tone] %>">
                    <p class="text-[10px] font-bold uppercase tracking-wider"><%= card.name %></p>
                    <p class="mt-1 text-xl font-bold text-gray-900 dark:text-white leading-none"><%= statusTotals[card.name] %></p>
                </div>
            <% }); %>
        </div>
        <% if (isEditor) { %>
            <a href="/odc/<%= data.id %>/edit?return_to=/odc/<%= data.id %>"
                class="inline-flex items-center gap-2 px-4 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z">
                    </path>
                </svg>
                Edit
            </a>
            <% } %>
</div>

<!-- Hierarchical Structure Builder -->
<% if (isEditor) { %>
    <div
        class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 md:p-6 shadow-sm mb-6">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Struktur ODC Builder</h3>
            <button type="button" onclick="toggleBuilderPanel(this)"
                class="flex items-center gap-2 px-3 py-1.5 text-sm bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-600 transition-all">
                <span id="toggleText">Sembunyikan Builder</span>
                <svg id="toggleIcon" class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor"
                    viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
            </button>
        </div>

        <div id="builderPanel" class="space-y-6">
            <!-- STEP 1: ADD SECTOR -->
            <div
                class="p-4 bg-gradient-to-r from-blue-50 to-blue-100 dark:from-gray-700 dark:to-gray-800 rounded-lg border border-blue-200 dark:border-gray-600">
                <div class="flex items-center gap-2 mb-3">
                    <span
                        class="w-6 h-6 flex items-center justify-center bg-blue-600 text-white text-xs font-bold rounded-full">1</span>
                    <h4 class="font-semibold text-gray-900 dark:text-white">Tambah Sector Baru</h4>
                </div>
                <p class="text-xs text-gray-600 dark:text-gray-400 mb-3">Sector adalah grup utama. Contoh: "POP",
                    "AREA-A", "ZONE-1"</p>
                <% if (isEditor) { %>
                    <form action="/odc/<%= data.id %>/sectors" method="POST" class="flex gap-2">
                        <input type="text" name="sector" placeholder="Nama Sector baru..." required
                            class="flex-1 px-3 py-2 bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-600 rounded-lg text-sm focus:ring-2 focus:ring-blue-500">
                        <button type="submit"
                            class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors">
                            + Tambah Sector
                        </button>
                    </form>
                    <% } %>
                        <% if (sectors && sectors.length> 0) { %>
                            <div class="mt-3 flex flex-wrap gap-2">
                                <span class="text-xs text-gray-500 dark:text-gray-400">Sector yang ada:</span>
                                <% sectors.forEach(function(sec) { %>
                                    <span
                                        class="px-2 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-300 text-xs font-medium rounded">
                                        <%= sec %>
                                    </span>
                                    <% }); %>
                            </div>
                            <% } %>
            </div>

            <!-- STEP 2: ADD TRAY -->
            <div
                class="p-4 bg-gradient-to-r from-green-50 to-green-100 dark:from-gray-700 dark:to-gray-800 rounded-lg border border-green-200 dark:border-gray-600 <%= sectors && sectors.length > 0 ? '' : 'opacity-50 pointer-events-none' %>">
                <div class="flex items-center gap-2 mb-3">
                    <span
                        class="w-6 h-6 flex items-center justify-center bg-green-600 text-white text-xs font-bold rounded-full">2</span>
                    <h4 class="font-semibold text-gray-900 dark:text-white">Tambah Tray ke Sector</h4>
                </div>
                <p class="text-xs text-gray-600 dark:text-gray-400 mb-3">Pilih Sector, lalu masukkan nomor Tray (harus
                    unik, tidak boleh sama dengan yang sudah ada)</p>
                <% if (isEditor) { %>
                    <form action="/odc/<%= data.id %>/trays" method="POST"
                        class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                        <select name="sector" required
                            class="px-3 py-2 bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-600 rounded-lg text-sm focus:ring-2 focus:ring-green-500">
                            <option value="">-- Pilih Sector --</option>
                            <% if (sectors) { sectors.forEach(function(sec) { %>
                                <option value="<%= sec %>">
                                    <%= sec %>
                                </option>
                                <% }); } %>
                        </select>
                        <input type="number" name="tray" placeholder="Nomor Tray" min="1" required
                            class="px-3 py-2 bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-600 rounded-lg text-sm focus:ring-2 focus:ring-green-500">
                        <button type="submit"
                            class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-lg transition-colors">
                            + Tambah Tray
                        </button>
                    </form>
                    <% } %>
                        <% var allTrays=[]; if (sectorMap) { Object.keys(sectorMap).forEach(function(sec) {
                            Object.keys(sectorMap[sec].trays).forEach(function(tray) { allTrays.push({ sector: sec,
                            tray: tray }); }); }); } if (allTrays.length> 0) { %>
                            <div class="mt-3 flex flex-wrap gap-2">
                                <span class="text-xs text-gray-500 dark:text-gray-400">Tray yang ada:</span>
                                <% allTrays.forEach(function(t) { %>
                                    <span
                                        class="px-2 py-1 bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-300 text-xs font-medium rounded">
                                        <%= t.sector %>: Tray <%= t.tray %>
                                    </span>
                                    <% }); %>
                            </div>
                            <% } %>
            </div>

            <!-- STEP 3: ADD TUBE (Auto-creates 12 cores) -->
            <div
                class="p-4 bg-gradient-to-r from-purple-50 to-purple-100 dark:from-gray-700 dark:to-gray-800 rounded-lg border border-purple-200 dark:border-gray-600 <%= (typeof allTrays !== 'undefined' && allTrays.length > 0) ? '' : 'opacity-50 pointer-events-none' %>">
                <div class="flex items-center gap-2 mb-3">
                    <span
                        class="w-6 h-6 flex items-center justify-center bg-purple-600 text-white text-xs font-bold rounded-full">3</span>
                    <h4 class="font-semibold text-gray-900 dark:text-white">Tambah Tube (Otomatis Buat 12 Core)</h4>
                </div>
                <p class="text-xs text-gray-600 dark:text-gray-400 mb-3">Pilih Sector dan Tray, lalu pilih nomor Tube.
                    <strong>12 Core akan otomatis terbuat</strong> dengan status "Active".
                </p>
                <% if (isEditor) { %>
                    <form action="/odc/<%= data.id %>/tubes" method="POST">
                        <div class="grid grid-cols-1 sm:grid-cols-4 gap-2">
                            <select id="tubeSectorSelect" name="sector" required onchange="populateTubeTrays()"
                                class="px-3 py-2 bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-600 rounded-lg text-sm focus:ring-2 focus:ring-purple-500">
                                <option value="">-- Pilih Sector --</option>
                                <% if (sectors) { sectors.forEach(function(sec) { %>
                                    <option value="<%= sec %>">
                                        <%= sec %>
                                    </option>
                                    <% }); } %>
                            </select>
                            <select id="tubeTraySelect" name="tray" required
                                class="px-3 py-2 bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-600 rounded-lg text-sm focus:ring-2 focus:ring-purple-500">
                                <option value="">-- Pilih Tray --</option>
                            </select>
                            <select name="tube" required
                                class="px-3 py-2 bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-600 rounded-lg text-sm focus:ring-2 focus:ring-purple-500">
                                <% for(var i=1; i<=12; i++) { %>
                                    <option value="<%= i %>">Tube <%= i %> - <%= coreColors[(i-1)%12] %>
                                    </option>
                                    <% } %>
                            </select>
                            <button type="submit"
                                class="px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white text-sm font-medium rounded-lg transition-colors">
                                + Tambah Tube (12 Core)
                            </button>
                        </div>
                    </form>
                    <% } %>
            </div>

            <!-- INFO BOX -->

        </div>
    </div>
    <% } %>

        <!-- Cores Table - Professional Excel Style (Desktop) -->
        <div
            class="hidden md:block bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700">
            <div
                class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900/50 flex justify-between items-center">
                <h3 class="font-semibold text-gray-900 dark:text-white">Data Core Matrix</h3>
                <span class="px-3 py-1 bg-blue-100 text-blue-800 text-xs font-medium rounded-full">
                    <%= data.cores ? data.cores.length : 0 %> Core Terdaftar
                </span>
            </div>

            <div class="overflow-auto max-h-[80vh] relative">
                <table class="w-full text-sm border-collapse">
                    <thead class="sticky top-0 z-50 bg-white dark:bg-gray-800 shadow-md">
                        <tr
                            class="bg-gradient-to-r from-blue-600 to-blue-700 text-white uppercase text-xs font-semibold tracking-wider">
                            <th class="px-3 py-3 text-left border-r border-blue-500 w-16">Sector</th>
                            <th class="px-3 py-3 text-left border-r border-blue-500 w-24">Tray</th>
                            <th class="px-3 py-3 text-left border-r border-blue-500 w-24">Tube</th>
                            <th class="px-3 py-3 text-center border-r border-blue-500 w-16">Core</th>
                            <th class="px-3 py-3 text-center border-r border-blue-500 w-28">Status</th>
                            <th class="px-3 py-3 text-left border-r border-blue-500">Description Core</th>
                            <th class="px-3 py-3 text-left border-r border-blue-500">Destination</th>
                            <th class="px-3 py-3 text-left border-r border-blue-500">Customer</th>
                            <th class="px-3 py-3 text-left border-r border-blue-500">Description</th>
                        </tr>
                    </thead>
                    <%- include('_table_body') %>
                </table>
            </div>
        </div>

        <!-- Cores Card View (Mobile) -->
        <div class="md:hidden space-y-6">
            <div
                class="px-2 py-2 border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900/50 rounded-t-xl">
                <h3 class="font-semibold text-gray-900 dark:text-white">Data Core (<%= data.cores ? data.cores.length :
                        0 %>
                        )</h3>
            </div>
            <% if (!sectors || sectors.length===0) { %>
                <div class="bg-white dark:bg-gray-800 rounded-xl p-6 text-center shadow-sm">
                    <svg class="w-12 h-12 text-gray-300 dark:text-gray-600 mx-auto mb-4" fill="none"
                        stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4">
                        </path>
                    </svg>
                    <p class="text-gray-500 dark:text-gray-400">Belum ada data core</p>
                </div>
                <% } else { %>
                    <% sectors.forEach(function(sectorName) { var sectorData=sectorMap[sectorName]; var
                        trayNumbers=Object.keys(sectorData.trays).sort(function(a, b) { return parseInt(a) -
                        parseInt(b); }); %>
                        <div
                            class="bg-white dark:bg-gray-800 rounded-xl shadow-sm overflow-hidden border border-gray-200 dark:border-gray-700">
                            <div
                                class="px-4 py-3 bg-gradient-to-r from-blue-600 to-blue-700 border-b border-blue-500 flex justify-between items-center text-white">
                                <h3 class="font-bold uppercase text-lg">Sector <%= sectorName %>
                                </h3>
                            </div>

                            <div class="divide-y divide-gray-200 dark:divide-gray-700">
                                <% trayNumbers.forEach(function(trayNum) { var trayData=sectorData.trays[trayNum]; var
                                    tubeNumbers=Object.keys(trayData.tubes).sort(function(a, b) { return parseInt(a) -
                                    parseInt(b); }); %>
                                    <div class="p-4">
                                        <h4
                                            class="font-semibold text-gray-600 dark:text-gray-400 mb-3 uppercase text-lg">
                                            Tray <%= trayNum %>
                                        </h4>

                                        <% tubeNumbers.forEach(function(tubeNum) { var tubeData=trayData.tubes[tubeNum];
                                            var tubeColorName=coreColors[(tubeNum-1) % 12]; var
                                            tubeHex=colorCSS[tubeColorName]; var tubeText=(tubeColorName==='White' ||
                                            tubeColorName==='Yellow' || tubeColorName==='Aqua' || tubeColorName==='Pink'
                                            ) ? '#000000' : '#FFFFFF' ; %>
                                            <div class="mb-4 last:mb-0">
                                                <div class="flex items-center gap-2 mb-2">
                                                    <span
                                                        class="inline-flex items-center justify-center w-5 h-5 rounded-full font-bold text-[10px] border border-black/10"
                                                        style="background-color: <%= tubeHex %>; color: <%= tubeText %>;">
                                                        <%= tubeNum %>
                                                    </span>
                                                    <span class="font-semibold text-gray-500 uppercase text-lg">Tube <%=
                                                            tubeNum %>
                                                    </span>
                                                </div>

                                                <div class="grid grid-cols-2 xs:grid-cols-3 gap-2">
                                                    <% for (var c=1; c <=12; c++) { var core=tubeData[c]; var
                                                        coreColorName=coreColors[(c-1) % 12]; var
                                                        bgColor=colorCSS[coreColorName]; var
                                                        textColor=(coreColorName==='White' || coreColorName==='Yellow'
                                                        || coreColorName==='Aqua' || coreColorName==='Pink' )
                                                        ? '#000000' : '#FFFFFF' ; %>
                                                        <div
                                                            class="border border-gray-200 dark:border-gray-700 rounded-lg p-2 text-xs relative <%= core ? 'bg-gray-50 dark:bg-gray-900 shadow-sm' : 'opacity-40' %>">
                                                            <div class="flex items-center gap-2 mb-1">
                                                                <span
                                                                    class="inline-flex items-center justify-center w-5 h-5 rounded-full font-bold text-[10px]"
                                                                    style="background-color: <%= bgColor %>; color: <%= textColor %>;">
                                                                    <%= c %>
                                                                </span>
                                                                <% if (core) { %>
                                                                    <% if (isEditor) { %>
                                                                        <a href="/odc/<%= data.id %>/cores/<%= core.id %>/edit?focus=status"
                                                                            class="inline-block">
                                                                            <span
                                                                                class="font-bold <%= core.status === 'Active' ? 'text-green-600' : ((core.status === 'Cut' || core.status === 'Bad') ? 'text-red-600' : (core.status === 'Alokasi' ? 'text-blue-600' : (core.status === 'Idle' ? 'text-amber-600' : 'text-gray-400'))) %>">
                                                                                <%= core.status ?
                                                                                    core.status.toUpperCase() : 'NONE'
                                                                                    %>
                                                                            </span>
                                                                        </a>
                                                                        <% } else { %>
                                                                            <span
                                                                                class="font-bold <%= core.status === 'Active' ? 'text-green-600' : ((core.status === 'Cut' || core.status === 'Bad') ? 'text-red-600' : (core.status === 'Alokasi' ? 'text-blue-600' : (core.status === 'Idle' ? 'text-amber-600' : 'text-gray-400'))) %>">
                                                                                <%= core.status ?
                                                                                    core.status.toUpperCase() : 'NONE'
                                                                                    %>
                                                                            </span>
                                                                            <% } %>
                                                                                <% } %>
                                                            </div>

                                                            <% if (core) { %>
                                                                <div class="space-y-0.5 mt-2">
                                                                    <div class="truncate font-medium text-gray-900 dark:text-white"
                                                                        title="<%= core.customer %>">
                                                                        <% if (isEditor) { %>
                                                                            <a href="/odc/<%= data.id %>/cores/<%= core.id %>/edit?focus=customer"
                                                                                class="hover:text-blue-600 dark:hover:text-blue-400 hover:underline">
                                                                                <%= core.customer || 'Add Customer' %>
                                                                            </a>
                                                                            <% } else { %>
                                                                                <%= core.customer || '-' %>
                                                                                    <% } %>
                                                                    </div>
                                                                    <div class="truncate text-gray-500"
                                                                        title="<%= core.destination %>">
                                                                        <% if (isEditor) { %>
                                                                            <a href="/odc/<%= data.id %>/cores/<%= core.id %>/edit?focus=destination"
                                                                                class="hover:text-blue-600 dark:hover:text-blue-400 hover:underline">
                                                                                <%= core.destination || 'Add Dest' %>
                                                                            </a>
                                                                            <% } else { %>
                                                                                <%= core.destination || '-' %>
                                                                                    <% } %>
                                                                    </div>
                                                                </div>

                                                                <% if (isEditor) { %>
                                                                    <div
                                                                        class="absolute top-2 right-2 flex items-center gap-2">
                                                                        <a href="/odc/<%= data.id %>/cores/<%= core.id %>/edit"
                                                                            class="text-gray-400 hover:text-blue-500"
                                                                            title="Edit">
                                                                            <svg class="w-3 h-3" fill="none"
                                                                                stroke="currentColor"
                                                                                viewBox="0 0 24 24">
                                                                                <path stroke-linecap="round"
                                                                                    stroke-linejoin="round"
                                                                                    stroke-width="2"
                                                                                    d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z">
                                                                                </path>
                                                                            </svg>
                                                                        </a>
                                                                        <form
                                                                            action="/odc/<%= data.id %>/cores/<%= core.id %>?_method=DELETE"
                                                                            method="POST"
                                                                            onsubmit="return confirmSubmit(this, 'Hapus?')">
                                                                            <button type="submit"
                                                                                class="text-gray-400 hover:text-red-500">
                                                                                <svg class="w-3 h-3" fill="none"
                                                                                    stroke="currentColor"
                                                                                    viewBox="0 0 24 24">
                                                                                    <path stroke-linecap="round"
                                                                                        stroke-linejoin="round"
                                                                                        stroke-width="2"
                                                                                        d="M6 18L18 6M6 6l12 12"></path>
                                                                                </svg>
                                                                            </button>
                                                                        </form>
                                                                    </div>
                                                                    <% } %>
                                                                        <% } %>
                                                        </div>
                                                        <% } %>
                                                </div>
                                            </div>
                                            <% }); %>
                                    </div>
                                    <% }); %>
                            </div>
                        </div>
                        <% }); %>
                            <% } %>
        </div>
        <!-- Hidden Data Container to avoid EJS syntax issues -->
        <div id="odc-server-data" data-sectormap="<%= JSON.stringify(sectorMap || {}) %>" class="hidden"></div>
        </div>


        <!-- ODC Edit Modal -->
        <div id="odcEditModal" class="fixed inset-0 z-[100] hidden overflow-y-auto" aria-labelledby="modal-title"
            role="dialog" aria-modal="true">
            <div class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
                <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true"
                    onclick="closeOdcEditModal()"></div>
                <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
                <div
                    class="inline-block align-bottom bg-white dark:bg-gray-800 rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg w-full">
                    <form id="odcEditForm" method="POST" action="">
                        <div class="bg-white dark:bg-gray-800 px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                            <div class="sm:flex sm:items-start">
                                <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left w-full">
                                    <h3 class="text-lg leading-6 font-medium text-gray-900 dark:text-white"
                                        id="modalTitle">Edit
                                        Data</h3>
                                    <div class="mt-4" id="inputContainer">
                                        <!-- Dynamic Input Injected Here -->
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="bg-gray-50 dark:bg-gray-700 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
                            <button type="submit"
                                class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-blue-600 text-base font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 sm:ml-3 sm:w-auto sm:text-sm">
                                Simpan
                            </button>
                            <button type="button" onclick="closeOdcEditModal()"
                                class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 dark:border-gray-500 shadow-sm px-4 py-2 bg-white dark:bg-gray-800 text-base font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">
                                Batal
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <script>
            // Structure Data from Server
            const dataContainer = document.getElementById('odc-server-data');
            const sectorMap = JSON.parse(dataContainer.dataset.sectormap || '{}');

            console.log('ODC Detail Loaded, sectorMap:', sectorMap);
            const existingTrays = [];

            // Build existing trays list
            Object.keys(sectorMap).forEach(sec => {
                Object.keys(sectorMap[sec].trays).forEach(tray => {
                    existingTrays.push(parseInt(tray));
                });
            });

            // --- STEP 3: POPULATE TRAY DROPDOWN BASED ON SECTOR ---
            function populateTubeTrays() {
                const sectorSelect = document.getElementById('tubeSectorSelect');
                const traySelect = document.getElementById('tubeTraySelect');
                const selectedSector = sectorSelect.value;
                const previousTray = traySelect.value; // Store previous selection if any

                traySelect.innerHTML = '<option value="">-- Pilih Tray --</option>';

                if (selectedSector && sectorMap[selectedSector]) {
                    const trays = Object.keys(sectorMap[selectedSector].trays).sort((a, b) => parseInt(a) - parseInt(b));
                    trays.forEach(tray => {
                        const opt = document.createElement('option');
                        opt.value = tray;
                        opt.textContent = 'Tray ' + tray;

                        // Keep selected if possible
                        if (tray === previousTray) {
                            opt.selected = true;
                        }

                        traySelect.appendChild(opt);
                    });
                }
            }

            // --- TOGGLE BUILDER PANEL ---
            function toggleBuilderPanel(btn) {
                const panel = document.getElementById('builderPanel');
                const text = document.getElementById('toggleText');
                const icon = document.getElementById('toggleIcon');

                if (panel.classList.contains('hidden')) {
                    panel.classList.remove('hidden');
                    text.textContent = 'Sembunyikan Builder';
                    icon.style.transform = 'rotate(0deg)';
                } else {
                    panel.classList.add('hidden');
                    text.textContent = 'Tampilkan Builder';
                    icon.style.transform = 'rotate(180deg)';
                }
            }

            // --- INLINE EDITING (TOGGLE) ---
            // (Deprecated: Replaced with Link to Edit Page)

            // Direct Status Update (Select)
            // Direct Status Update (Select)
            function updateCoreStatus(select, coreId) {
                const value = select.value;
                const odcId = '<%= data.id %>';

                // Optimistic UI Update
                setStatusStyle(select, value);

                fetch(`/odc/${odcId}/cores/${coreId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ status: value })
                }).then(res => {
                    if (!res.ok) {
                        alert('Gagal memperbarui status');
                        // Revert style if needed (complex, maybe just reload or ignore for now)
                    }
                });
            }

            function setStatusStyle(select, value) {
                // Reset base class
                select.className = 'text-xs font-medium rounded-md border-gray-300 focus:border-blue-500 focus:ring-blue-500 cursor-pointer py-1 px-2 transition-colors';

                // Apply color based on SELECTION only
                if (value === 'Active') {
                    select.classList.add('bg-green-100', 'text-green-800', 'dark:bg-green-900/50', 'dark:text-green-300');
                } else if (value === 'Cut' || value === 'Bad') {
                    select.classList.add('bg-red-100', 'text-red-800', 'dark:bg-red-900/50', 'dark:text-red-300');
                } else if (value === 'Alokasi') {
                    select.classList.add('bg-blue-100', 'text-blue-800', 'dark:bg-blue-900/50', 'dark:text-blue-300');
                } else if (value === 'Idle') {
                    select.classList.add('bg-amber-100', 'text-amber-800', 'dark:bg-amber-900/50', 'dark:text-amber-300');
                } else {
                    // None or others - default gray/white
                    select.classList.add('bg-white', 'text-gray-800', 'dark:bg-gray-800', 'dark:text-gray-300');
                }
            }

            // Modal Functions
            function openOdcEditModal(coreId, field, currentValue, coreNumber) {
                const modal = document.getElementById('odcEditModal');
                const form = document.getElementById('odcEditForm');
                const title = document.getElementById('modalTitle');
                const inputContainer = document.getElementById('inputContainer');
                const odcId = '<%= data.id %>';

                // Set Form Action
                form.action = `/odc/${odcId}/cores/${coreId}?_method=PUT`;

                // Determine Field Config
                let label = '';
                let inputHtml = '';

                switch (field) {
                    case 'description_core':
                        label = 'Description Core';
                        inputHtml = `<textarea name="description_core" rows="3" class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white sm:text-sm p-2" placeholder="Masukkan Description Core...">${currentValue}</textarea>`;
                        break;
                    case 'destination':
                        label = 'Destination';
                        inputHtml = `<input type="text" name="destination" value="${currentValue}" class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white sm:text-sm p-2" placeholder="Masukkan Destination...">`;
                        break;
                    case 'customer':
                        label = 'Customer';
                        inputHtml = `<input type="text" name="customer" value="${currentValue}" class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white sm:text-sm p-2" placeholder="Masukkan Customer...">`;
                        break;
                    case 'description':
                        label = 'Description (Keterangan)';
                        inputHtml = `<textarea name="description" rows="3" class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white sm:text-sm p-2" placeholder="Masukkan Keterangan...">${currentValue}</textarea>`;
                        break;
                }

                // Update UI
                title.textContent = `Edit ${label} (Core ${coreNumber})`;
                inputContainer.innerHTML = `
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">${label}</label>
            ${inputHtml}
        `;

                // Show Modal
                modal.classList.remove('hidden');

                // Focus input
                setTimeout(() => {
                    const input = inputContainer.querySelector('input, textarea');
                    if (input) input.focus();
                }, 100);
            }

            function closeOdcEditModal() {
                document.getElementById('odcEditModal').classList.add('hidden');
            }

            // Close on Escape
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') closeOdcEditModal();
            });

            // --- STRUCTURE CONTROLS (Removed: Handled by Edit Pages) ---

            // Initialize
            document.addEventListener('DOMContentLoaded', function () {
                const tubeSectorSelect = document.getElementById('tubeSectorSelect');
                if (tubeSectorSelect && tubeSectorSelect.value) {
                    populateTubeTrays();
                }
            });
        </script>