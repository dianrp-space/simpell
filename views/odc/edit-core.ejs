<div class="space-y-6">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-4">
            <a href="/odc/<%= odc.id %>"
                class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:text-white dark:hover:bg-gray-700 rounded-lg transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
            </a>
            <div>
                <h1 class="text-xl md:text-2xl font-bold text-gray-900 dark:text-white">
                    Edit Core
                </h1>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                    <%= odc.nama_odc %> - Sector <%= core.sector %> Tray <%= core.tray %> Tube <%= core.tube %> Core <%=
                                        core.core_number %>
                </p>
            </div>
        </div>
    </div>

    <!-- Edit Form -->
    <div
        class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6 shadow-sm max-w-2xl mx-auto">
        <form action="/odc/<%= odc.id %>/cores/<%= core.id %>?_method=PUT" method="POST" class="space-y-6">

            <!-- Location Info (Readonly) -->
            <div
                class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-4 bg-gray-50 dark:bg-gray-900/50 rounded-lg border border-gray-100 dark:border-gray-700">
                <div>
                    <span class="block text-xs font-medium text-gray-500 uppercase">Sector</span>
                    <span class="font-bold text-gray-900 dark:text-white">
                        <%= core.sector %>
                    </span>
                </div>
                <div>
                    <span class="block text-xs font-medium text-gray-500 uppercase">Tray</span>
                    <span class="font-bold text-gray-900 dark:text-white">
                        <%= core.tray %>
                    </span>
                </div>
                <div>
                    <span class="block text-xs font-medium text-gray-500 uppercase">Tube</span>
                    <span class="font-bold text-gray-900 dark:text-white"
                        style="color: <%= core.tube_color === 'White' || core.tube_color === 'Yellow' ? '#D97706' : core.tube_color %>">
                        <%= core.tube %> (<%= core.tube_color %>)
                    </span>
                </div>
                <div>
                    <span class="block text-xs font-medium text-gray-500 uppercase">Core</span>
                    <span class="font-bold text-gray-900 dark:text-white"
                        style="color: <%= core.core_color === 'White' || core.core_color === 'Yellow' ? '#D97706' : core.core_color %>">
                        <%= core.core_number %> (<%= core.core_color %>)
                    </span>
                </div>
            </div>

            <div class="grid gap-6">
                <!-- Status -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Status</label>
                    <select name="status" required
                        class="w-full px-4 py-2 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500">
                        <% statuses.forEach(function(s) { %>
                            <option value="<%= s %>" <%=core.status===s ? 'selected' : '' %>>
                                <%= s %>
                            </option>
                            <% }); %>
                    </select>
                </div>

                <!-- Description Core -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Description
                        Core</label>
                    <textarea name="description_core" rows="3"
                        class="w-full px-4 py-2 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500"><%= core.description_core || '' %></textarea>
                </div>

                <!-- Destination -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Destination</label>
                    <input type="text" name="destination" value="<%= core.destination || '' %>"
                        class="w-full px-4 py-2 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500">
                </div>

                <!-- Customer -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Customer</label>
                    <input type="text" name="customer" value="<%= core.customer || '' %>"
                        class="w-full px-4 py-2 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500">
                </div>

                <!-- Description -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Keterangan</label>
                    <textarea name="description" rows="3"
                        class="w-full px-4 py-2 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500"><%= core.description || '' %></textarea>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-200 dark:border-gray-700">
                <a href="/odc/<%= odc.id %>"
                    class="px-4 py-2 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                    Batal
                </a>
                <button type="submit"
                    class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors">
                    Simpan Perubahan
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const urlParams = new URLSearchParams(window.location.search);
        const focusField = urlParams.get('focus');

        if (focusField) {
            const element = document.getElementsByName(focusField)[0];
            if (element) {
                element.focus();
                // If it's a select or input, maybe open it or highlight it?
                // Textarea cursor at end
                if (element.tagName === 'INPUT' || element.tagName === 'TEXTAREA') {
                    const len = element.value.length;
                    element.setSelectionRange(len, len);
                }
            }
        }
    });
</script>
</div>