<!-- PKS CSO Index -->
<div class="space-y-6">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white">PKS CSO</h1>
            <p class="text-gray-500 dark:text-gray-400">Manajemen Perjanjian Kerja Sama & Cost Structure Optimization
            </p>
        </div>
        <% if (isEditor) { %>
            <a href="/pks-cso/create"
                class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white font-medium rounded-lg shadow-lg shadow-blue-500/25 transition-all transform hover:scale-[1.02]">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                Tambah Item
            </a>
            <% } %>
    </div>

    <!-- Filter & Search -->
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm">
        <form action="/pks-cso" method="GET" class="flex flex-col md:flex-row gap-3">
            <div class="relative flex-1">
                <input type="text" name="search" value="<%= search %>" placeholder="Cari no item/deskripsi..."
                    class="w-full px-4 py-2.5 pl-10 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                <div class="absolute left-3 top-1/2 -translate-y-1/2">
                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </div>
            </div>
            <div class="w-full md:w-48">
                <select name="jenis"
                    class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-lg text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    <option value="">Semua Jenis</option>
                    <% jenisOptions.forEach(j=> { %>
                        <option value="<%= j %>" <%=jenis===j ? 'selected' : '' %>>
                            <%= j %>
                        </option>
                        <% }); %>
                </select>
            </div>
            <button type="submit"
                class="px-4 py-2.5 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 font-medium rounded-lg hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors">
                Filter
            </button>
            <% if (search || jenis) { %>
                <a href="/pks-cso"
                    class="px-4 py-2.5 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors text-center">
                    Reset
                </a>
                <% } %>
        </form>
    </div>

    <!-- Table -->
    <div
        class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50 dark:bg-gray-900/50 border-b border-gray-200 dark:border-gray-700">
                    <tr>
                        <th
                            class="px-6 py-3 text-left text-sm font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider">
                            No Item</th>
                        <th
                            class="px-6 py-3 text-left text-sm font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider">
                            Deskripsi</th>
                        <th
                            class="px-6 py-3 text-left text-sm font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider">
                            Jenis</th>
                        <th
                            class="px-6 py-3 text-left text-sm font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider">
                            CSO Jasa</th>
                        <th
                            class="px-6 py-3 text-left text-sm font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider">
                            CSO Material</th>
                        <% if (isEditor) { %>
                            <th
                                class="px-3 py-3 text-center text-sm font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wider sticky right-0 top-0 bg-gray-50 dark:bg-gray-900 z-30 shadow-[-4px_0_8px_-4px_rgba(0,0,0,0.1)] w-1">
                                Aksi</th>
                            <% } %>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                    <% if (data.length===0) { %>
                        <tr>
                            <td colspan="6" class="px-6 py-12 text-center">
                                <div class="flex flex-col items-center">
                                    <svg class="w-12 h-12 text-gray-300 dark:text-gray-600 mb-4" fill="none"
                                        stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z">
                                        </path>
                                    </svg>
                                    <p class="text-gray-500 dark:text-gray-400 mb-2">Tidak ada data</p>
                                    <% if (isEditor) { %>
                                        <a href="/pks-cso/create"
                                            class="text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 font-medium">Tambah
                                            item baru</a>
                                        <% } %>
                                </div>
                            </td>
                        </tr>
                        <% } else { %>
                            <% data.forEach(item=> { %>
                                <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors text-sm">
                                    <td class="px-6 py-4">
                                        <span class="text-gray-900 dark:text-white">
                                            <%= item.no_item %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 text-gray-700 dark:text-gray-300 text-sm">
                                        <%= item.deskripsi_item %>
                                    </td>
                                    <td class="px-6 py-4">
                                        <% let jenisClass='' ; if (item.jenis==='Jasa' ) {
                                            jenisClass='bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400'
                                            ; } else if (item.jenis==='Material' ) {
                                            jenisClass='bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400'
                                            ; } else {
                                            jenisClass='bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-400'
                                            ; } %>
                                            <span
                                                class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= jenisClass %>">
                                                <%= item.jenis %>
                                            </span>
                                    </td>
                                    <td class="px-6 py-4 text-gray-700 dark:text-gray-300 text-sm">
                                        <%= item.cso_jasa ? 'Rp ' + Number(item.cso_jasa).toLocaleString('id-ID') : '-'
                                            %>
                                    </td>
                                    <td class="px-6 py-4 text-gray-700 dark:text-gray-300 text-sm">
                                        <%= item.cso_material ? 'Rp ' +
                                            Number(item.cso_material).toLocaleString('id-ID') : '-' %>
                                    </td>
                                    <% if (isEditor) { %>
                                        <td
                                            class="px-3 py-4 sticky right-0 bg-white dark:bg-gray-800 z-20 shadow-[-4px_0_8px_-4px_rgba(0,0,0,0.1)] w-1">
                                            <div class="flex items-center justify-center gap-2">
                                                <a href="/pks-cso/<%= item.id %>/edit"
                                                    class="p-2 text-gray-400 hover:text-amber-600 hover:bg-amber-50 dark:hover:bg-amber-900/30 rounded-lg transition-colors"
                                                    title="Edit">
                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor"
                                                        viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            stroke-width="2"
                                                            d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z">
                                                        </path>
                                                    </svg>
                                                </a>
                                                <form action="/pks-cso/<%= item.id %>?_method=DELETE" method="POST"
                                                    class="inline"
                                                    onsubmit="return confirmSubmit(this, 'Hapus item ini?')">
                                                    <button type="submit"
                                                        class="p-2 text-gray-400 hover:text-red-600 hover:bg-red-50 dark:hover:bg-red-900/30 rounded-lg transition-colors"
                                                        title="Hapus">
                                                        <svg class="w-5 h-5" fill="none" stroke="currentColor"
                                                            viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                                stroke-width="2"
                                                                d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                                                            </path>
                                                        </svg>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                        <% } %>
                                </tr>
                                <% }); %>
                                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>