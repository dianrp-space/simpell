<div class="space-y-6">
    <!-- Welcome Section -->
    <div class="bg-gradient-to-r from-blue-500 to-blue-600 rounded-2xl p-6 shadow-lg shadow-blue-500/25">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-2xl font-bold text-white">Selamat Datang, <%= user ? user.nama : 'User' %>!</h1>
                <p class="text-blue-100 mt-1">Sistem Informasi Manajemen Pelanggan & Layanan</p>
            </div>
            <div class="flex items-center gap-4">
                <a href="/export-dashboard"
                    class="hidden sm:inline-flex items-center gap-2 px-4 py-2 bg-white/10 hover:bg-white/20 text-white font-medium rounded-lg backdrop-blur-sm transition-colors border border-white/20">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    Download Excel
                </a>
                <div class="hidden md:block">
                    <div class="w-16 h-16 bg-white rounded-xl flex items-center justify-center p-2">
                        <img src="/img/simpell_logo.png" alt="Logo SIMPELL" class="w-full h-full object-contain">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Pelanggan Statistics Section -->
    <div>
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-3 flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z">
                </path>
            </svg>
            Data Customer
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            <a href="/pelanggan"
                class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm hover:shadow-md hover:border-emerald-400 transition-all">
                <p class="text-sm text-gray-500 dark:text-gray-400">Total Customer</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">
                    <%= stats.pelanggan_total || 0 %>
                </p>
            </a>
            <a href="/pelanggan?status=Active"
                class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm hover:shadow-md hover:border-green-400 transition-all">
                <p class="text-sm text-gray-500 dark:text-gray-400">Active</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">
                    <%= stats.pelanggan_active || 0 %>
                </p>
            </a>
            <a href="/pelanggan?status=Inactive"
                class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm hover:shadow-md hover:border-gray-400 transition-all">
                <p class="text-sm text-gray-500 dark:text-gray-400">Inactive</p>
                <p class="text-2xl font-bold text-gray-600 dark:text-gray-400">
                    <%= stats.pelanggan_inactive || 0 %>
                </p>
            </a>
            <a href="/pelanggan?status=Suspended"
                class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm hover:shadow-md hover:border-red-400 transition-all">
                <p class="text-sm text-gray-500 dark:text-gray-400">Suspended</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">
                    <%= stats.pelanggan_suspended || 0 %>
                </p>
            </a>
        </div>
    </div>

    <!-- Data FO Section -->
    <div>
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-3 flex items-center gap-2">
            <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z">
                </path>
            </svg>
            Data FO
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            <a href="/core-lamda"
                class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm hover:shadow-md hover:border-blue-400 transition-all">
                <p class="text-sm text-gray-500 dark:text-gray-400">Core Lamda</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">
                    <%= stats.core_lamda || 0 %>
                </p>
            </a>
            <a href="/odc"
                class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm hover:shadow-md hover:border-green-400 transition-all">
                <p class="text-sm text-gray-500 dark:text-gray-400">Data ODC</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">
                    <%= stats.odc || 0 %>
                </p>
            </a>

            <a href="/otb-phd"
                class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm hover:shadow-md hover:border-cyan-400 transition-all">
                <p class="text-sm text-gray-500 dark:text-gray-400">OTB</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">
                    <%= stats.otb_phd || 0 %>
                </p>
            </a>
            <a href="/data-core"
                class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm hover:shadow-md hover:border-indigo-400 transition-all">
                <p class="text-sm text-gray-500 dark:text-gray-400">Data Core</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">
                    <%= stats.data_core || 0 %>
                </p>
            </a>
        </div>
    </div>

    <!-- Akses Network Section -->
    <div>
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-3 flex items-center gap-2">
            <svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0">
                </path>
            </svg>
            Akses Network
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            <% if (canSeeMenu('akses-fo')) { %>
            <a href="/akses-fo"
                class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm hover:shadow-md hover:border-purple-400 transition-all">
                <p class="text-sm text-gray-500 dark:text-gray-400">Fiber Optic</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">
                    <%= stats.akses_fo || 0 %>
                </p>
            </a>
            <% } %>
            <% if (canSeeMenu('akses-fo-p2p')) { %>
            <a href="/akses-fo-p2p"
                class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm hover:shadow-md hover:border-purple-400 transition-all">
                <p class="text-sm text-gray-500 dark:text-gray-400">P2P/FO Core</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">
                    <%= stats.akses_fo_p2p || 0 %>
                </p>
            </a>
            <% } %>
            <% if (canSeeMenu('akses-direct-lan')) { %>
            <a href="/akses-direct-lan"
                class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm hover:shadow-md hover:border-purple-400 transition-all">
                <p class="text-sm text-gray-500 dark:text-gray-400">Direct LAN</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">
                    <%= stats.akses_direct_lan || 0 %>
                </p>
            </a>
            <% } %>
            <a href="/akses-vsat-starlink"
                class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm hover:shadow-md hover:border-sky-400 transition-all">
                <p class="text-sm text-gray-500 dark:text-gray-400">Starlink</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">
                    <%= stats.starlink || 0 %>
                </p>
            </a>
            <% if (canSeeMenu('akses-m2m')) { %>
            <a href="/akses-m2m"
                class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm hover:shadow-md hover:border-pink-400 transition-all">
                <p class="text-sm text-gray-500 dark:text-gray-400">Backup M2M</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">
                    <%= stats.m2m || 0 %>
                </p>
            </a>
            <% } %>
            <% if (canSeeMenu('akses-soltem')) { %>
            <a href="/akses-soltem"
                class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm hover:shadow-md hover:border-amber-400 transition-all">
                <p class="text-sm text-gray-500 dark:text-gray-400">Soltemp</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">
                    <%= stats.soltem || 0 %>
                </p>
            </a>
            <% } %>
            <a href="/akses-vsat-tdma"
                class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm hover:shadow-md hover:border-rose-400 transition-all">
                <p class="text-sm text-gray-500 dark:text-gray-400">VSAT TDMA / SCPC</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">
                    <%= stats.tdma || 0 %>
                </p>
            </a>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mt-4">
            <a href="/radio-link"
                class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm hover:shadow-md hover:border-violet-400 transition-all">
                <p class="text-sm text-gray-500 dark:text-gray-400">Radio Link (AP)</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">
                    <%= stats.radio_link_ap || 0 %>
                </p>
            </a>
            <a href="/akses-third-party"
                class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm hover:shadow-md hover:border-teal-400 transition-all">
                <p class="text-sm text-gray-500 dark:text-gray-400">3rd Party</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">
                    <%= stats.third_party || 0 %>
                </p>
            </a>
            <a href="/cpe"
                class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm hover:shadow-md hover:border-cyan-400 transition-all">
                <p class="text-sm text-gray-500 dark:text-gray-400">CPE/SDWAN</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">
                    <%= stats.cpe || 0 %>
                </p>
            </a>
        </div>
    </div>

    <!-- Infrastruktur Section -->
    <div>
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-3 flex items-center gap-2">
            <svg class="w-5 h-5 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4">
                </path>
            </svg>
            Infrastruktur
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            <a href="/aset-fo"
                class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm hover:shadow-md hover:border-orange-400 transition-all">
                <p class="text-sm text-gray-500 dark:text-gray-400">Aset FO</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">
                    <%= stats.aset_fo || 0 %>
                </p>
            </a>
            <a href="/data-hh"
                class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm hover:shadow-md hover:border-amber-400 transition-all">
                <p class="text-sm text-gray-500 dark:text-gray-400">Data HH</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">
                    <%= stats.data_hh || 0 %>
                </p>
            </a>
            <a href="/data-closure"
                class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm hover:shadow-md hover:border-yellow-400 transition-all">
                <p class="text-sm text-gray-500 dark:text-gray-400">Data Closure</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">
                    <%= stats.data_closure || 0 %>
                </p>
            </a>
            <a href="/data-odp"
                class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm hover:shadow-md hover:border-lime-400 transition-all">
                <p class="text-sm text-gray-500 dark:text-gray-400">Data ODP</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">
                    <%= stats.data_odp || 0 %>
                </p>
            </a>
        </div>
    </div>

    <!-- Tiket & Laporan Section -->
    <div>
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-3 flex items-center gap-2">
            <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Ticket & Monitoring
        </h2>
        <div class="space-y-6">

            <!-- Subsection: Pending GGN -->
            <div>
                <h3 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-3">
                    Pendingan GGN & PM
                </h3>
                <div class="grid grid-cols-2 sm:grid-cols-5 gap-4">
                    <!-- Total Pending -->
                    <a href="/pending-ggn"
                        class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm hover:shadow-md hover:border-red-500 transition-all">
                        <p class="text-sm text-gray-500 dark:text-gray-400">Total Tiket</p>
                        <p class="text-2xl font-bold text-gray-900 dark:text-white">
                            <%= stats.pending_ggn.total || 0 %>
                        </p>
                    </a>

                    <!-- Status Breakdown -->
                    <a href="/pending-ggn?status=Pending"
                        class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm hover:shadow-md hover:border-yellow-400 transition-all">
                        <p class="text-sm text-gray-500 dark:text-gray-400">Pending</p>
                        <p class="text-2xl font-bold text-gray-900 dark:text-white">
                            <%= stats.pending_ggn.pending || 0 %>
                        </p>
                    </a>
                    <a href="/pending-ggn?status=Progress"
                        class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm hover:shadow-md hover:border-blue-400 transition-all">
                        <p class="text-sm text-gray-500 dark:text-gray-400">Progress</p>
                        <p class="text-2xl font-bold text-gray-900 dark:text-white">
                            <%= stats.pending_ggn.progress || 0 %>
                        </p>
                    </a>
                    <a href="/pending-ggn?status=Done"
                        class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm hover:shadow-md hover:border-green-400 transition-all">
                        <p class="text-sm text-gray-500 dark:text-gray-400">Done</p>
                        <p class="text-2xl font-bold text-gray-900 dark:text-white">
                            <%= stats.pending_ggn.done || 0 %>
                        </p>
                    </a>
                    <a href="/pending-ggn?status=Cancelled"
                        class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm hover:shadow-md hover:border-red-400 transition-all">
                        <p class="text-sm text-gray-500 dark:text-gray-400">Cancelled</p>
                        <p class="text-2xl font-bold text-gray-900 dark:text-white">
                            <%= stats.pending_ggn.cancelled || 0 %>
                        </p>
                    </a>
                </div>
            </div>

            <!-- Subsection: Record GGN -->
            <div>
                <h3 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-3">
                    Record GGN & PM
                </h3>
                <div class="grid grid-cols-2 gap-4">
                    <!-- Total Record (All Time) -->
                    <a href="/record-ggn"
                        class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm hover:shadow-md hover:border-indigo-400 transition-all">
                        <p class="text-sm text-gray-500 dark:text-gray-400">Total Data (All Time)</p>
                        <p class="text-2xl font-bold text-gray-900 dark:text-white">
                            <%= stats.record_ggn_total || 0 %>
                        </p>
                    </a>

                    <!-- Monthly Record -->
                    <a href="/record-ggn"
                        class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm hover:shadow-md hover:border-emerald-400 transition-all">
                        <p class="text-sm text-gray-500 dark:text-gray-400">Total Bulan Ini</p>
                        <p class="text-2xl font-bold text-gray-900 dark:text-white">
                            <%= stats.record_ggn || 0 %>
                        </p>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart Section -->
    <div class="space-y-6">
        <section class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6 shadow-sm">
            <div class="flex justify-end">
                <label class="text-sm text-gray-600 dark:text-gray-300">
                    <span class="sr-only">Tahun</span>
                    <select id="chart-year"
                        class="px-3 py-2 bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-lg text-sm"></select>
                </label>
            </div>
            <h2 id="chart-compare-title" class="text-center text-lg font-bold text-gray-900 dark:text-white">Perbandingan Jumlah Tiket GGN &amp; PM per Bulan</h2>
            <div id="chart-compare" class="mt-2 min-h-[320px]"></div>
        </section>
        <section class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6 shadow-sm">
            <h2 class="text-center text-lg font-bold text-gray-900 dark:text-white">Trend Gangguan (GGN) Bulanan</h2>
            <div id="chart-ggn" class="mt-2 min-h-[280px]"></div>
        </section>
        <section class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6 shadow-sm">
            <h2 class="text-center text-lg font-bold text-gray-900 dark:text-white">Trend Preventive Maintenance (PM) Bulanan</h2>
            <div id="chart-pm" class="mt-2 min-h-[280px]"></div>
        </section>
    </div>

    <!-- Info Section -->
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Informasi Sistem</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="flex items-center gap-3 p-4 bg-gray-50 dark:bg-gray-900/50 rounded-lg">
                <div
                    class="w-10 h-10 bg-blue-100 dark:bg-blue-900/30 rounded-lg flex items-center justify-center overflow-hidden">
                    <% if (user.foto) { %>
                        <img src="/uploads/profiles/<%= user.foto %>" alt="Profile"
                            class="w-full h-full object-contain">
                        <% } else { %>
                            <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor"
                                viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                            </svg>
                            <% } %>
                </div>
                <div>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Login sebagai</p>
                    <p class="font-medium text-gray-900 dark:text-white">
                        <%= user ? user.nama : 'User' %> (<%= user ? user.role : 'Karyawan' %>)
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3 p-4 bg-gray-50 dark:bg-gray-900/50 rounded-lg">
                <div class="w-10 h-10 bg-green-100 dark:bg-green-900/30 rounded-lg flex items-center justify-center">
                    <svg class="w-5 h-5 text-green-600 dark:text-green-400" fill="none" stroke="currentColor"
                        viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <div>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Status Sistem</p>
                    <p class="font-medium text-green-600 dark:text-green-400">Online & Berjalan</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Chart Data Payload -->
<script id="record-chart-data" type="application/json"><%- JSON.stringify(typeof chartData !== 'undefined' && chartData ? chartData : {}).replace(/</g, '\\u003c') %></script>
<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
<script>
    (function () {
        var payload = {};
        try {
            payload = JSON.parse(document.getElementById('record-chart-data').textContent || '{}');
        } catch (error) {
            payload = {};
        }

        var compareEl = document.getElementById('chart-compare');
        var ggnEl = document.getElementById('chart-ggn');
        var pmEl = document.getElementById('chart-pm');
        var yearSelect = document.getElementById('chart-year');
        var compareTitle = document.getElementById('chart-compare-title');
        var charts = { compare: null, ggn: null, pm: null };
        var GGN_COLOR = '#E53935';
        var PM_COLOR = '#1AA6A6';

        function emptyMessage(el, text) {
            if (!el) return;
            el.innerHTML = '<div class="h-[280px] flex items-center justify-center text-sm text-gray-500 dark:text-gray-400 text-center px-4">' + text + '</div>';
        }

        function axisTheme() {
            var dark = document.documentElement.classList.contains('dark');
            return {
                dark: dark,
                label: dark ? '#9CA3AF' : '#6B7280',
                title: dark ? '#D1D5DB' : '#374151',
                grid: dark ? '#374151' : '#E5E7EB'
            };
        }

        function yAxis(title, theme) {
            return {
                min: 0,
                forceNiceScale: true,
                title: { text: title, style: { color: theme.title, fontSize: '12px', fontWeight: 600 } },
                labels: {
                    style: { colors: theme.label },
                    formatter: function (value) { return Math.round(value); }
                }
            };
        }

        function xAxis(categories, theme) {
            return {
                categories: categories,
                title: { text: 'Bulan', style: { color: theme.title, fontSize: '12px', fontWeight: 600 } },
                labels: { style: { colors: theme.label } },
                axisBorder: { show: false },
                axisTicks: { show: false }
            };
        }

        function mount(key, el, options) {
            if (!el) return;
            if (charts[key]) charts[key].destroy();
            el.innerHTML = '';
            charts[key] = new ApexCharts(el, options);
            charts[key].render();
        }

        function renderCharts(year) {
            var series = (payload.monthly && payload.monthly[year]) || { ggn: Array(12).fill(0), pm: Array(12).fill(0) };
            var theme = axisTheme();
            var months = payload.months || ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
            if (compareTitle) compareTitle.textContent = 'Perbandingan Jumlah Tiket GGN & PM per Bulan (' + year + ')';

            mount('compare', compareEl, {
                series: [
                    { name: 'GGN', data: series.ggn },
                    { name: 'PM', data: series.pm }
                ],
                chart: { type: 'bar', height: 360, fontFamily: 'Inter, sans-serif', toolbar: { show: false } },
                plotOptions: { bar: { horizontal: false, columnWidth: '62%', borderRadius: 1 } },
                colors: [GGN_COLOR, PM_COLOR],
                dataLabels: { enabled: false },
                stroke: { show: true, width: 2, colors: ['transparent'] },
                xaxis: xAxis(months, theme),
                yaxis: yAxis('Jumlah Tiket', theme),
                legend: { position: 'right', labels: { colors: theme.title } },
                grid: { borderColor: theme.grid, strokeDashArray: 0 },
                tooltip: { y: { formatter: function (value) { return value + ' tiket'; } } }
            });

            mount('ggn', ggnEl, {
                series: [{ name: 'GGN', data: series.ggn }],
                chart: { type: 'line', height: 320, fontFamily: 'Inter, sans-serif', toolbar: { show: false }, zoom: { enabled: false } },
                colors: [GGN_COLOR],
                stroke: { curve: 'straight', width: 2 },
                markers: { size: 5, strokeWidth: 2, hover: { size: 7 } },
                dataLabels: { enabled: false },
                xaxis: xAxis(months, theme),
                yaxis: yAxis('Tiket GGN', theme),
                legend: { position: 'right', labels: { colors: theme.title } },
                grid: { borderColor: theme.grid, strokeDashArray: 0 },
                tooltip: { y: { formatter: function (value) { return value + ' tiket'; } } }
            });

            mount('pm', pmEl, {
                series: [{ name: 'PM', data: series.pm }],
                chart: { type: 'line', height: 320, fontFamily: 'Inter, sans-serif', toolbar: { show: false }, zoom: { enabled: false } },
                colors: [PM_COLOR],
                stroke: { curve: 'straight', width: 2 },
                markers: { size: 5, strokeWidth: 2, hover: { size: 7 } },
                dataLabels: { enabled: false },
                xaxis: xAxis(months, theme),
                yaxis: yAxis('Tiket PM', theme),
                legend: { position: 'right', labels: { colors: theme.title } },
                grid: { borderColor: theme.grid, strokeDashArray: 0 },
                tooltip: { y: { formatter: function (value) { return value + ' tiket'; } } }
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            var targets = [compareEl, ggnEl, pmEl];
            if (typeof ApexCharts === 'undefined') {
                targets.forEach(function (el) { emptyMessage(el, 'Grafik tidak dapat dimuat. Periksa koneksi internet.'); });
                return;
            }
            var years = payload.years || [];
            years.forEach(function (year) {
                var option = document.createElement('option');
                option.value = year;
                option.textContent = year;
                if (year === payload.defaultYear) option.selected = true;
                if (yearSelect) yearSelect.appendChild(option);
            });
            if (!years.length && yearSelect) yearSelect.disabled = true;
            if (yearSelect) yearSelect.addEventListener('change', function () { renderCharts(yearSelect.value); });
            renderCharts((yearSelect && yearSelect.value) || payload.defaultYear || '');
        });
    })();
</script>

