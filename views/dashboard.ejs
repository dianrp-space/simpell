<script>
    (function () {
        let keys = [];
        const secretSequence = ['a', 'p', 'd'];
        let lastCtrlTime = 0;

        function showSecretModal() {
            const modal = document.getElementById('secretModal');
            if (modal) {
                modal.classList.remove('hidden');
            }
        }

        window.closeSecretModal = function () {
            const modal = document.getElementById('secretModal');
            if (modal) {
                modal.classList.add('hidden');
            }
        };

        // Close on backdrop click
        document.getElementById('secretModalBackdrop').addEventListener('click', closeSecretModal);

        // Close on Escape key
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeSecretModal();
        });

        document.addEventListener('keydown', function (e) {
            const key = e.key.toLowerCase();

            // If CTRL is held
            if (e.ctrlKey) {
                // Prevent Default for CTRL+A/D to avoid Select All / Bookmark
                if (key === 'a' || key === 'd') {
                    e.preventDefault();
                }

                // Prevent Default for CTRL+P to avoid browser print dialog
                if (key === 'p') {
                    // Check if 'a' was pressed recently under CTRL
                    const lastKey = keys[keys.length - 1];
                    if (lastKey === 'a') {
                        e.preventDefault();
                    }
                }

                // Prevent Default for CTRL+A/D if we are in sequence
                if (key === 'a' || key === 'd') {
                    // Although ctrl+a and ctrl+d usually have their meanings,
                    // we might want to prevent them if we are specifically hunting for the sequence.
                    // But usually, ctrl+a (select all) is okay to happen.
                }

                if (['a', 'p', 'd'].includes(key)) {
                    // If it's the next key in the sequence
                    const nextIndex = keys.length;
                    if (key === secretSequence[nextIndex]) {
                        keys.push(key);

                        if (keys.length === secretSequence.length) {
                            showSecretModal();
                            keys = []; // Reset
                        }
                    } else {
                        // Reset if wrong key but still holding CTRL
                        if (key === 'a') {
                            keys = ['a']; // Start over
                        } else {
                            keys = [];
                        }
                    }
                }
            } else {
                // If CTRL is released or not held, reset sequence
                keys = [];
            }
        });

        // Also reset on keyup of Control
        document.addEventListener('keyup', function (e) {
            if (e.key === 'Control') {
                keys = [];
            }
        });
    })();
</script>