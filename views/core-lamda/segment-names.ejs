<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('../partials/favicon') %>
    <title>
        <%= title %>
    </title>
    <link href="/css/output.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/data-tables.css">
    <script src="/js/table-scroll.js" defer></script>
</head>

<body class="bg-gray-50 dark:bg-gray-900 min-h-screen">
    <div class="p-4 md:p-6 max-w-4xl mx-auto">
        <div class="flex items-center gap-3 mb-6">
            <a href="/core-lamda/<%= data.id %>"
                class="p-2 text-gray-500 hover:text-gray-700 bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
            </a>
            <div>
                <h1 class="text-lg md:text-xl font-bold text-gray-900 dark:text-white">
                    <%= pageTitle %>
                </h1>
                <p class="text-xs md:text-sm text-gray-500">
                    <%= data.lokasi %>
                </p>
            </div>
        </div>

        <!-- Add New Segment Name Form -->
        <div
            class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 p-4 md:p-6 mb-6">
            <h2 class="text-base md:text-lg font-semibold text-gray-900 dark:text-white mb-4">Tambah Segment Name Baru
            </h2>
            <form action="/core-lamda/<%= data.id %>/segment-names" method="POST"
                class="flex flex-col sm:flex-row gap-3">
                <input type="text" name="name" placeholder="Nama Segment (contoh: ODC Bandara - ODC BT Besar)" required
                    class="flex-1 px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm md:text-base">
                <button type="submit"
                    class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors">
                    Tambah
                </button>
            </form>
        </div>

        <!-- List of Segment Names -->
        <div
            class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
            <div class="p-4 border-b border-gray-200 dark:border-gray-700">
                <h2 class="text-base md:text-lg font-semibold text-gray-900 dark:text-white">Daftar Segment Names</h2>
                <p class="text-xs md:text-sm text-gray-500">Segment names ini akan menjadi kolom header di tabel core
                </p>
            </div>

            <% if (segmentNames.length===0) { %>
                <div class="p-8 text-center text-gray-500">
                    <p>Belum ada segment name. Tambahkan segment name di atas.</p>
                </div>
                <% } else { %>

                    <!-- Desktop Table -->
                    <div class="hidden md:block overflow-x-auto">
                        <table class="w-full">
                            <thead class="bg-gray-50 dark:bg-gray-900">
                                <tr>
                                    <th
                                        class="px-4 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase">
                                        Order</th>
                                    <th
                                        class="px-4 py-3 text-left text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase">
                                        Nama Segment</th>
                                    <th
                                        class="px-4 py-3 text-center text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase">
                                        Aksi</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                                <% segmentNames.forEach(function(sn, index) { %>
                                    <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50">
                                        <td class="px-4 py-3 text-sm text-gray-900 dark:text-white font-medium">
                                            Segment <%= sn.segment_order %>
                                        </td>
                                        <td class="px-4 py-3">
                                            <form
                                                action="/core-lamda/<%= data.id %>/segment-names/<%= sn.id %>?_method=PUT"
                                                method="POST" class="flex gap-2">
                                                <input type="text" name="name" value="<%= sn.name %>"
                                                    class="flex-1 px-3 py-2 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-900 dark:text-white text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                                <button type="submit"
                                                    class="px-3 py-2 bg-blue-500 hover:bg-blue-600 text-white text-sm rounded-lg transition-colors">
                                                    Update
                                                </button>
                                            </form>
                                        </td>
                                        <td class="px-4 py-3 text-center">
                                            <form
                                                action="/core-lamda/<%= data.id %>/segment-names/<%= sn.id %>?_method=DELETE"
                                                method="POST" method="POST"
                                                onsubmit="return confirmSubmit(this, 'Hapus segment name ini?')">
                                                <button type="submit"
                                                    class="px-3 py-2 bg-red-500 hover:bg-red-600 text-white text-sm rounded-lg transition-colors">
                                                    Hapus
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                    <% }); %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Mobile Card View -->
                    <div class="md:hidden divide-y divide-gray-200 dark:divide-gray-700">
                        <% segmentNames.forEach(function(sn, index) { %>
                            <div class="p-4">
                                <div class="flex items-center justify-between mb-3">
                                    <span class="text-sm font-medium text-gray-900 dark:text-white">Segment <%=
                                            sn.segment_order %></span>
                                    <form action="/core-lamda/<%= data.id %>/segment-names/<%= sn.id %>?_method=DELETE"
                                        method="POST" onsubmit="return confirmSubmit(this, 'Hapus segment name ini?')">
                                        <button type="submit"
                                            class="text-xs px-2 py-1 bg-red-500 hover:bg-red-600 text-white rounded transition-colors">
                                            Hapus
                                        </button>
                                    </form>
                                </div>
                                <form action="/core-lamda/<%= data.id %>/segment-names/<%= sn.id %>?_method=PUT"
                                    method="POST" class="flex gap-2">
                                    <input type="text" name="name" value="<%= sn.name %>"
                                        class="flex-1 px-3 py-2 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-900 dark:text-white text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                    <button type="submit"
                                        class="px-3 py-2 bg-blue-500 hover:bg-blue-600 text-white text-sm rounded-lg transition-colors">
                                        Update
                                    </button>
                                </form>
                            </div>
                            <% }); %>
                    </div>
                    <% } %>
        </div>
    </div>
</body>

</html>