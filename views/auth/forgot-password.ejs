<div class="max-w-md w-full animate-fade-in-up">
    <!-- Branding -->
    <div class="text-center mb-10">
        <img src="/img/pola_logo.png" class="h-12 w-auto mx-auto mb-6 drop-shadow-sm" alt="POLA Logo">
        <% if (typeof success_msg==='undefined' || !success_msg || success_msg.length===0) { %>
            <h1 class="text-3xl font-extrabold text-gray-900 dark:text-white tracking-tight mb-2">Lupa Password?</h1>
            <p class="text-gray-500 dark:text-gray-400">Tenang, masukkan email Anda untuk meminta reset password ke
                Admin.</p>
            <% } %>
    </div>

    <!-- Main Card -->
    <div
        class="bg-white dark:bg-gray-800 rounded-[2.5rem] shadow-2xl shadow-gray-200/50 dark:shadow-none p-10 border border-gray-100 dark:border-gray-700/50 relative overflow-hidden">
        <!-- Accent Gradient -->
        <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-blue-600 to-indigo-600"></div>

        <% if (typeof success_msg !=='undefined' && success_msg && success_msg.length> 0) { %>
            <!-- Success State -->
            <%- include('forgot-password-success') %>
                <% } else { %>
                    <!-- Error Alert -->
                    <% if (typeof error_msg !=='undefined' && error_msg && error_msg.length> 0) { %>
                        <div
                            class="mb-8 p-4 bg-red-50 dark:bg-red-900/20 border border-red-100 dark:border-red-800/10 rounded-2xl flex items-center gap-3 animate-shake">
                            <div
                                class="w-8 h-8 bg-red-100 dark:bg-red-800/30 rounded-full flex items-center justify-center flex-shrink-0">
                                <svg class="w-5 h-5 text-red-600 dark:text-red-400" fill="none" stroke="currentColor"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                </svg>
                            </div>
                            <p class="text-sm text-red-700 dark:text-red-400 font-medium">
                                <%= error_msg %>
                            </p>
                        </div>
                        <% } %>

                            <!-- Form -->
                            <form action="/auth/forgot-password" method="POST" class="space-y-8">
                                <div class="space-y-2">
                                    <label for="email"
                                        class="block text-sm font-bold text-gray-700 dark:text-gray-300 ml-1">
                                        Alamat Email Terdaftar
                                    </label>
                                    <div class="relative group">
                                        <input type="email" name="email" id="email" required
                                            placeholder="nama@email.com"
                                            class="w-full px-6 py-4 bg-gray-50 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-600 rounded-3xl focus:ring-4 focus:ring-blue-500/10 focus:border-blue-600 transition-all outline-none text-gray-900 dark:text-white font-medium">
                                    </div>
                                </div>

                                <div class="space-y-4">
                                    <button type="submit"
                                        class="w-full py-4 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-3xl shadow-xl shadow-blue-600/20 transition-all active:scale-[0.98] flex items-center justify-center gap-3 group relative overflow-hidden">
                                        <span class="relative z-10">Kirim Permintaan</span>
                                        <svg class="w-5 h-5 transform transition-transform group-hover:translate-x-1 relative z-10"
                                            fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M13 7l5 5m0 0l-5 5m5-5H6" />
                                        </svg>
                                    </button>

                                    <a href="/auth/login"
                                        class="w-full py-2 bg-transparent text-gray-500 dark:text-gray-400 text-sm font-semibold hover:text-blue-600 transition-all flex items-center justify-center gap-2 group">
                                        <svg class="w-4 h-4 transform transition-transform group-hover:-translate-x-1"
                                            fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                                        </svg>
                                        Kembali ke Login
                                    </a>
                                </div>
                            </form>
                            <% } %>
    </div>

    <!-- Footer Help -->
    <p class="text-center mt-10 text-sm text-gray-500 dark:text-gray-400">
        Butuh bantuan lebih lanjut? <a href="/auth/contact-admin"
            class="text-blue-600 font-bold hover:underline">Hubungi Admin</a>
    </p>
</div>

<style>
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fade-in-up {
        animation: fadeInUp 0.5s ease-out forwards;
    }

    @keyframes shake {

        0%,
        100% {
            transform: translateX(0);
        }

        25% {
            transform: translateX(-5px);
        }

        75% {
            transform: translateX(5px);
        }
    }

    .animate-shake {
        animation: shake 0.4s ease-in-out;
    }
</style>