<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('../partials/favicon') %>
    <title>
        <%= (typeof title !=='undefined' ? title : 'POLA' ) %>
    </title>
    <script>
        (function () {
            const serverTheme = '<%= locals.user && locals.user.theme ? locals.user.theme : "" %>';
            const localTheme = localStorage.getItem('theme');
            const theme = serverTheme || localTheme || 'system';

            if (theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = { darkMode: 'class', theme: { extend: { fontFamily: { sans: ['Inter', 'sans-serif'] } } } }
    </script>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        #particleCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }

        .animate-gradient-text {
            display: inline-block;
            background: linear-gradient(to right, #001F99, #0171D3, #01B0FF, #001F99);
            background-size: 200% auto;
            color: transparent;
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: shine 3s linear infinite;
            font-weight: 800;
        }

        @keyframes shine {
            to {
                background-position: 200% center;
            }
        }

        nav,
        main {
            position: relative;
            z-index: 10;
        }
    </style>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>

<body
    class="bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-white font-sans antialiased transition-colors duration-200">
    <% const u=(typeof user !=='undefined' ) ? user : null; const d_name=(u && u.nama) ? u.nama : 'Guest' ; const
        d_foto=(u && u.foto) ? u.foto : null; let initials='' ; if (u && u.nama && !u.foto) {
        initials=u.nama.split(' ').filter(x => x).map(n => n[0]).slice(0, 2).join('').toUpperCase();
        }
    %>
    <canvas id="particleCanvas"></canvas>
    
    <nav class="bg-white/95 dark:bg-gray-800/95 border-b border-gray-200 dark:border-gray-700 sticky top-0 z-50">
        <div class="px-4 sm:px-6 lg:px-12">
            <div class="flex justify-between h-16">
                <!-- Logo -->
                <div class="flex items-center">
                    <img class="h-[38px] w-auto" src="/img/pola_logo.png" alt="POLA Logo">
                    <span class="ml-3 text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-[#001F99] via-[#0171D3] to-[#01B0FF] leading-none">POLA</span>
                </div>

                <!-- Right Side Buttons: NO HOVER EFFECTS to prevent lag -->
                <div class="flex items-center gap-2">
                    <!-- Profile Link (Clickable Photo & Name) -->
                    <a href="/profile" class="flex items-center gap-3 p-1.5 px-3 rounded-xl group">
                        <div class="relative">
                            <% if (d_foto) { %>
                                <img class="h-9 w-9 rounded-full object-cover border-2 border-white dark:border-gray-700 shadow-sm" src="/uploads/profiles/<%= d_foto %>" alt="User">
                            <% } else if (u && u.nama) { %>
                                <div class="h-9 w-9 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold text-sm border-2 border-white dark:border-gray-700 shadow-sm"><%= initials %></div>
                            <% } else { %>
                                <div class="h-9 w-9 rounded-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center text-gray-400 border-2 border-white dark:border-gray-700 shadow-sm">
                                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                                </div>
                            <% } %>
                        </div>
                        <div class="hidden sm:flex flex-col items-start leading-tight">
                            <span class="text-[10px] text-gray-400 dark:text-gray-500 font-bold tracking-widest uppercase">Hi,</span>
                            <span class="text-sm font-bold text-gray-900 dark:text-white"><%= d_name %></span>
                        </div>
                    </a>

                    <% if (locals.isAdmin) { %>
                        <%- include('../partials/notif-bell') %>
                    <% } %>

                    <div class="h-8 w-[1px] bg-gray-200 dark:bg-gray-700 mx-1"></div>

                    <!-- Settings Button (Gear) -->
                    <a href="/profile/settings" title="Settings" class="p-2.5 text-gray-400 dark:text-gray-500 rounded-xl">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                    </a>

                    <!-- Logout Button -->
                    <a href="javascript:void(0)" onclick="handleLogout()" title="Logout" class="flex items-center gap-2 p-2 px-3 text-red-600 dark:text-red-400 font-bold text-sm rounded-xl">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                        <span class="hidden md:inline">Logout</span>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <main><%- body %></main>

    <script src="/js/main.js"></script>
    <script src="/js/portal-effects.js"></script>
    
    <!-- Admin Notifications -->
    <% if (locals.isAdmin) { %>
        <script src="/socket.io/socket.io.js"></script>
        <script src="/js/notifications.js"></script>
    <% } %>

    <script>
        function setTheme(t) {
            const isDark = (t === ' dark' || (t === 'system' &&
                window.matchMedia('(prefers-color-scheme:dark)').matches)); document.documentElement.classList.toggle('dark',
                    isDark); localStorage.setItem('theme', t); document.cookie = `theme=${t}; path=/; max-age=31536000; SameSite=Lax`;
        } </script>

        <!-- Logout Confirmation Modal -->
        <div id="logout-modal" tabindex="-1"
            class="fixed top-0 left-0 right-0 z-[60] hidden p-4 overflow-x-hidden overflow-y-auto md:inset-0 h-full max-h-full flex items-center justify-center bg-gray-900/50 dark:bg-gray-900/80 transition-opacity duration-300">
            <div class="relative w-full max-w-md max-h-full transform transition-all duration-300 scale-95 opacity-0"
                id="logout-modal-content">
                <div
                    class="relative bg-white rounded-2xl shadow-2xl dark:bg-gray-800 border border-gray-100 dark:border-gray-700 overflow-hidden">
                    <div class="p-6 text-center">
                        <div
                            class="w-16 h-16 bg-red-50 dark:bg-red-900/20 rounded-full flex items-center justify-center mx-auto mb-4 border border-red-100 dark:border-red-800">
                            <svg class="w-8 h-8 text-red-600 dark:text-red-500 animated-pulse" fill="none"
                                stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1">
                                </path>
                            </svg>
                        </div>
                        <h3 class="mb-2 text-xl font-bold text-gray-900 dark:text-white">Konfirmasi Logout</h3>
                        <p class="mb-6 text-sm text-gray-500 dark:text-gray-400 leading-relaxed">Apakah Anda yakin ingin
                            keluar dari sistem? Anda harus login kembali untuk mengakses data Anda.</p>
                        <div class="flex justify-center gap-3">
                            <button type="button"
                                class="flex-1 px-5 py-2.5 text-sm font-semibold text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 rounded-xl transition-all duration-200"
                                onclick="closeLogoutModal()">
                                Batal
                            </button>
                            <a href="/auth/logout"
                                class="flex-1 px-5 py-2.5 text-sm font-semibold text-center text-white bg-red-600 hover:bg-red-700 rounded-xl shadow-lg shadow-red-500/30 transition-all duration-200">
                                Ya, Logout
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <style>
            @keyframes modalPulse {

                0%,
                100% {
                    transform: scale(1);
                    opacity: 1;
                }

                50% {
                    transform: scale(1.05);
                    opacity: 0.8;
                }
            }

            .animated-pulse {
                animation: modalPulse 2s infinite ease-in-out;
            }
        </style>

        <script>
            function handleLogout() {
                const modal = document.getElementById('logout-modal');
                const content = document.getElementById('logout-modal-content');
                modal.classList.remove('hidden');
                setTimeout(() => {
                    content.classList.remove('scale-95', 'opacity-0');
                    content.classList.add('scale-100', 'opacity-100');
                }, 10);
                document.body.classList.add('overflow-hidden');
            }

            function closeLogoutModal() {
                const modal = document.getElementById('logout-modal');
                const content = document.getElementById('logout-modal-content');
                content.classList.remove('scale-100', 'opacity-100');
                content.classList.add('scale-95', 'opacity-0');
                setTimeout(() => {
                    modal.classList.add('hidden');
                }, 300);
                document.body.classList.remove('overflow-hidden');
            }

            // Close modal on escape key
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') closeLogoutModal();
            });
        </script>
    <% if (typeof user !== 'undefined' && user) { %>
        <script>
            setInterval(function () {
                fetch('/auth/ping', { credentials: 'same-origin' }).catch(function () {});
            }, 4 * 60 * 1000);
        </script>
    <% } %>
</body>

</html>