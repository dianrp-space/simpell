<!-- Record GGN Detail -->
<div class="max-w-3xl mx-auto space-y-6">
        <!-- Page Header -->
        <div class="flex items-center gap-4">
                <a href="javascript:history.back()"
                        class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:text-white dark:hover:bg-gray-700 rounded-lg transition-colors">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M10 19l-7-7m0 0l7-7m-7 7h18">
                                </path>
                        </svg>
                </a>
                <div>
                        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
                                Detail Record GGN & PM
                        </h1>
                        <p class="text-gray-500 dark:text-gray-400">Detail data Record Gangguan & PM</p>
                </div>
        </div>

        <!-- Form Card -->
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6 shadow-sm">
                <div class="space-y-6">

                        <!-- Tanggal & Case -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                        <label
                                                class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Tanggal</label>
                                        <input type="date" disabled
                                                value="<%= data && data.tanggal ? moment(data.tanggal).format('YYYY-MM-DD') : '' %>"
                                                class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white opacity-70 cursor-not-allowed">
                                </div>
                                <div>
                                        <label
                                                class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Case</label>
                                        <input type="text" disabled value="<%= data ? data.case_type || '' : '' %>"
                                                class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white opacity-70 cursor-not-allowed">
                                </div>
                        </div>

                        <!-- Tiket, Akses, Pelanggan -->
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                                <div>
                                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">No
                                                Ticket</label>
                                        <input type="text" disabled value="<%= data ? data.no_ticket || '' : '' %>"
                                                class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white opacity-70 cursor-not-allowed">
                                </div>
                                <div>
                                        <label
                                                class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Akses</label>
                                        <input type="text" disabled value="<%= data ? data.akses || '' : '' %>"
                                                class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white opacity-70 cursor-not-allowed">
                                </div>
                                <div>
                                        <label
                                                class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Customer</label>
                                        <input type="text" disabled
                                                value="<%= data && data.pelanggan ? (data.pelanggan.no_jaringan + ' - ' + data.pelanggan.nama_pelanggan) : '-' %>"
                                                class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white opacity-70 cursor-not-allowed">
                                </div>
                        </div>

                        <!-- Kontak & RFO -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">History
                                                Kontak
                                                PIC</label>
                                        <textarea disabled rows="4"
                                                class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white opacity-70 cursor-not-allowed"><%= data ? data.history_kontak_pic || '' : '' %></textarea>
                                </div>
                                <div>
                                        <label
                                                class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">RFO</label>
                                        <textarea disabled rows="4"
                                                class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white opacity-70 cursor-not-allowed"><%= data ? data.rfo || '' : '' %></textarea>
                                </div>
                        </div>

                        <!-- Durasi, PJ, Status -->
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                                <div>
                                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Durasi
                                                Progress</label>
                                        <% if (isEditor) { %>
                                                <input type="text" name="durasi_progress"
                                                        value="<%= data ? data.durasi_progress || '' : '' %>"
                                                        class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                                                        placeholder="Contoh: 2 jam 30 menit">
                                                <% } else { %>
                                                        <input type="text" disabled
                                                                value="<%= data ? data.durasi_progress || '' : '' %>"
                                                                class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white opacity-70 cursor-not-allowed">
                                                        <% } %>
                                </div>
                                <div>
                                        <label
                                                class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">PJ</label>
                                        <% if (isEditor) { %>
                                                <input type="text" name="pj" value="<%= data ? data.pj || '' : '' %>"
                                                        class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                                                        placeholder="Penanggung jawab">
                                                <% } else { %>
                                                        <input type="text" disabled
                                                                value="<%= data ? data.pj || '' : '' %>"
                                                                class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white opacity-70 cursor-not-allowed">
                                                        <% } %>
                                </div>
                                <div>
                                        <label
                                                class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Status</label>
                                        <% if (isEditor) { %>
                                                <select name="status" required
                                                        class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all">
                                                        <% const statuses=['Pending', 'Progress' , 'Done' , 'Cancelled'
                                                                ]; %>
                                                                <% statuses.forEach(s=> { %>
                                                                        <option value="<%= s %>" <%=(data &&
                                                                                data.status===s) ? 'selected' :
                                                                                (s==='Done' ? 'selected' : '' ) %>><%= s
                                                                                        %>
                                                                        </option>
                                                                        <% }); %>
                                                </select>
                                                <% } else { %>
                                                        <input type="text" disabled
                                                                value="<%= data ? data.status || '' : '' %>"
                                                                class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl text-gray-900 dark:text-white opacity-70 cursor-not-allowed">
                                                        <% } %>
                                </div>
                        </div>

                        <div class="flex gap-3 pt-4 border-t border-gray-200 dark:border-gray-700">
                                <a href="javascript:history.back()"
                                        class="inline-flex items-center px-5 py-2.5 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                                        Kembali
                                </a>
                                <% if (isEditor) { %>
                                        <button type="submit"
                                                class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white font-medium rounded-lg shadow-lg shadow-blue-500/25 transition-all transform hover:scale-[1.02]">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor"
                                                        viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                                stroke-width="2" d="M5 13l4 4L19 7"></path>
                                                </svg>
                                                <%= data ? 'Simpan Perubahan' : 'Simpan' %>
                                        </button>
                                        <% } %>
                        </div>
                        </form>
                </div>
        </div>
</div>

<script>
        document.addEventListener('DOMContentLoaded', function () {
                const searchInput = document.getElementById('pelanggan_search');
                const dropdown = document.getElementById('pelanggan_dropdown');
                const pelangganIdInput = document.getElementById('pelanggan_id');
                const selectedContainer = document.getElementById('selected_pelanggan');
                const selectedText = document.getElementById('selected_text');
                const clearButton = document.getElementById('clear_pelanggan');

                if (dropdown) {
                        dropdown.addEventListener('click', function (e) {
                                const item = e.target.closest('.pelanggan-item');
                                if (item) {
                                        const id = item.dataset.id;
                                        const no = item.dataset.no;
                                        const nama = item.dataset.nama;
                                        if (pelangganIdInput) pelangganIdInput.value = id;
                                        if (selectedText) selectedText.textContent = `${no} - ${nama}`;
                                        if (selectedContainer) selectedContainer.classList.remove('hidden');
                                        if (searchInput) searchInput.value = '';
                                        if (dropdown) dropdown.classList.add('hidden');
                                }
                        });
                }

                if (clearButton) {
                        clearButton.addEventListener('click', function () {
                                if (pelangganIdInput) pelangganIdInput.value = '';
                                if (selectedContainer) selectedContainer.classList.add('hidden');
                                if (searchInput) {
                                        searchInput.value = '';
                                        searchInput.focus();
                                }
                        });
                }

                document.addEventListener('click', function (e) {
                        if (searchInput && dropdown && !searchInput.contains(e.target) && !dropdown.contains(e.target)) {
                                dropdown.classList.add('hidden');
                        }
                });
        });
</script>
<script src="/js/coordinate-converter.js"></script>